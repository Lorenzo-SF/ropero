#!/usr/bin/env bash
# =============================================================================
# ropero 1.0 — dispatcher fino (spec §2.1 y §5.1)
# =============================================================================
# USO:
#   ropero <modelo> [--port N] [--cpu] [--background] [--force]   (§8.2)
#   ropero <comando> [opciones]      (ropero <comando> --help los detalla)
#
# Este fichero SOLO enruta:
#   1. resuelve ROPERO_ROOT (symlinks de $0, sin readlink -f)
#   2. sourcea lib/00-utils.sh y lib/01-env.sh (siempre, si existen)
#   3. despacha CADA comando a bin/lib/cmd-*.sh (carga lazy)
#
# La tabla de ruteo es COMPLETA desde F1: las fases posteriores sólo añaden
# los cmd-*.sh y sus rp_cmd_<comando>; NADIE vuelve a tocar este dispatcher.
# Mientras llegue su fase, un comando no portado responde "aún no portado"
# y exit 2 (spec §2.1).
#
# bash 3.2 (ADR-1: objetivo = /bin/bash de macOS, sin re-exec). Comentarios y
# mensajes en español (spec §3).
# =============================================================================

# Guarda de versión (spec §3): bash >= 3.
if (( BASH_VERSINFO[0] < 3 )); then
    printf 'ERROR: ropero necesita bash >= 3 (encontrado: %s)\n' "${BASH_VERSION:-?}" >&2
    exit 1
fi

set -u

ROPERO_VERSION='1.0.0'

# -----------------------------------------------------------------------------
# ROPERO_ROOT: raíz de la instalación. $0 puede ser un symlink (install.sh
# crea $BIN_DIR/ropero → <dir>/bin/ropero), así que se sigue la cadena con un
# bucle de readlink + cd/pwd. SIN readlink -f: no existe en el bash 3.2 de
# macOS (spec §2.1).
# -----------------------------------------------------------------------------
_rp_self="$0"
_rp_hops=0
while [ -L "$_rp_self" ]; do
    # Tope de saltos: un ciclo de symlinks (a→b→a) no puede colgar el arranque.
    _rp_hops=$((_rp_hops + 1))
    if (( _rp_hops > 40 )); then
        printf 'ERROR: demasiados niveles de symlink resolviendo %s\n' "$0" >&2
        exit 1
    fi
    _rp_link="$(readlink "$_rp_self" 2>/dev/null)" || break
    case "$_rp_link" in
        /*) _rp_self="$_rp_link" ;;                          # absoluto
        *)  _rp_self="$(dirname "$_rp_self")/$_rp_link" ;;   # relativo al symlink
    esac
done
ROPERO_ROOT="$(cd "$(dirname "$_rp_self")/.." && pwd -P)" || {
    printf 'ERROR: no se pudo resolver la raíz de ropero desde: %s\n' "$0" >&2
    exit 1
}
export ROPERO_ROOT
unset _rp_self _rp_link _rp_hops

# -----------------------------------------------------------------------------
# Presentación (00-utils.sh) y entorno (01-env.sh): SIEMPRE, si existen.
# -----------------------------------------------------------------------------
for _rp_lib in 00-utils.sh 01-env.sh; do
    if [[ -f "$ROPERO_ROOT/bin/lib/$_rp_lib" ]]; then
        # shellcheck source=/dev/null
        . "$ROPERO_ROOT/bin/lib/$_rp_lib"
    fi
done
unset _rp_lib

# Cachea la detección de presentación (alaja/ANSI) si el módulo está.
declare -F rp_ui_init >/dev/null 2>&1 && rp_ui_init

# Error del dispatcher: no depende de 00-utils.sh. Una instalación parcial
# (o una fase intermedia sin el módulo) tiene que poder explicar qué pasa.
_rp_error() {
    if declare -F rp_msg >/dev/null 2>&1; then
        rp_msg error "$1"
    else
        printf 'ERROR: %s\n' "$1" >&2
    fi
}

# -----------------------------------------------------------------------------
# Tabla de ruteo COMPLETA (spec §2.1): comando | cmd-*.sh | rp_cmd_<comando> | fase
#
#   install → cmd-install.sh   ·  engines/link = alias de install (§8.13)
#   models  → cmd-models.sh    ·  alias de install models (§8.13)
#   use/stop/status → cmd-runtime.sh
#   list/template/args/levels/path → cmd-catalog.sh
#   doctor/check/config → cmd-doctor.sh
#   gguffer → cmd-gguffer.sh   ·  test → cmd-test.sh
#
# El arranque DIRECTO de modelo (§8.2) no está en la tabla: primer argumento
# que no es comando conocido ni empieza por '-' → cmd-runtime.sh, función
# rp_cmd_start <modelo> [opciones...].
#
# Se parsea a arrays paralelas al arrancar (una sola fuente de verdad: las
# columnas no se pueden desalinear). bash 3.2: heredoc, no mapfile.
# -----------------------------------------------------------------------------
RP_CMD_NAMES=()
RP_CMD_FILES=()
RP_CMD_FUNCS=()
RP_CMD_PHASES=()
while IFS='|' read -r _rp_name _rp_file _rp_func _rp_fase; do
    case "$_rp_name" in ''|'#'*) continue ;; esac   # líneas vacías/comentario
    RP_CMD_NAMES+=("$_rp_name")
    RP_CMD_FILES+=("$_rp_file")
    RP_CMD_FUNCS+=("$_rp_func")
    RP_CMD_PHASES+=("$_rp_fase")
done <<'ROPERO_RUTAS'
install|cmd-install.sh|rp_cmd_install|5
setup|cmd-install.sh|rp_cmd_setup|5
engines|cmd-install.sh|rp_cmd_engines|5
link|cmd-install.sh|rp_cmd_link|5
models|cmd-models.sh|rp_cmd_models|5
use|cmd-runtime.sh|rp_cmd_use|4
stop|cmd-runtime.sh|rp_cmd_stop|4
status|cmd-runtime.sh|rp_cmd_status|4
list|cmd-catalog.sh|rp_cmd_list|2
template|cmd-catalog.sh|rp_cmd_template|2
args|cmd-catalog.sh|rp_cmd_args|2
levels|cmd-catalog.sh|rp_cmd_levels|2
path|cmd-catalog.sh|rp_cmd_path|2
doctor|cmd-doctor.sh|rp_cmd_doctor|3
check|cmd-doctor.sh|rp_cmd_check|3
config|cmd-doctor.sh|rp_cmd_config|3
gguffer|cmd-gguffer.sh|rp_cmd_gguffer|6
test|cmd-test.sh|rp_cmd_test|7
ROPERO_RUTAS
unset _rp_name _rp_file _rp_func _rp_fase

# _rp_route <comando> → 0 si es comando conocido; deja la fila en
# _rp_cmd_file / _rp_cmd_func / _rp_cmd_fase. Escaneo lineal: 18 entradas.
_rp_route() {
    local i
    for i in "${!RP_CMD_NAMES[@]}"; do
        if [[ "${RP_CMD_NAMES[$i]}" == "$1" ]]; then
            _rp_cmd_file="${RP_CMD_FILES[$i]}"
            _rp_cmd_func="${RP_CMD_FUNCS[$i]}"
            _rp_cmd_fase="${RP_CMD_PHASES[$i]}"
            return 0
        fi
    done
    return 1
}

# -----------------------------------------------------------------------------
# Ayuda general. INLINE a propósito (spec §2.1): tiene que funcionar aunque
# sólo existan 00-utils.sh/01-env.sh, e incluso sin alaja y sin ANSI.
# -----------------------------------------------------------------------------
_rp_help() {
    cat <<'EOF'
USO: ropero <modelo> [--port N] [--cpu] [--background] [--force]
     ropero <comando> [opciones]

Arranque directo: `ropero <modelo>` sirve ese modelo en primer plano
(--background lo devuelve al fondo). Niveles, flags y opciones: sólo los
declarados en el TOML del modelo.

Comandos:
  use <modelo>            sirve el modelo y espera a que esté listo (idempotente)
  stop [modelo|all]       detiene el modelo pedido o todo lo gestionado
  status [modelo]         estado de los puertos gestionados
  list [--all]            modelos del catálogo
  template                vuelca models/_template.toml
  args <modelo>           argv final del modelo, un argumento por línea
  levels <modelo>         niveles de razonamiento declarados en el TOML
  path <modelo>           rutas resueltas del modelo
  models                  instala modelos (alias de install models)
  install [setup|engines|models|link|opencode-plugin]
  engines                 instala engines (alias de install engines)
  doctor | check          verifica la instalación
  config [engine]         estado de los engines
  gguffer                 fabrica un GGUF desde un repo de HuggingFace
  test <modelo>           corre el corpus de pruebas contra un modelo
  help                    esta ayuda
  --version               versión de ropero

Instalación en una línea:
  curl -fsSL https://raw.githubusercontent.com/Lorenzo-SF/ropero/main/install.sh | bash

`ropero <comando> --help` detalla cada comando.
EOF
}

# -----------------------------------------------------------------------------
# Despacho.
# -----------------------------------------------------------------------------
main() {
    local cmd="${1:-}"

    # Sin argumentos, help, -h o --help → ayuda general, exit 0 (§8.1).
    if [[ -z "$cmd" || "$cmd" == "help" || "$cmd" == "-h" || "$cmd" == "--help" ]]; then
        _rp_help
        return 0
    fi

    if [[ "$cmd" == "--version" ]]; then
        printf 'ropero %s\n' "$ROPERO_VERSION"
        return 0
    fi

    # Opción a secas, sin comando ni modelo: error de uso CORTO, sin volcado
    # de ayuda (§5.1). Un typo de teclado no merece veinte líneas de ruido.
    if [[ "$cmd" == -* ]]; then
        _rp_error "opción desconocida: '$cmd'"
        printf '  (ropero help → uso completo)\n' >&2
        return 2
    fi

    shift

    # Comando conocido → carga lazy de su cmd-*.sh y despacho (§2.1).
    if _rp_route "$cmd"; then
        if [[ ! -f "$ROPERO_ROOT/bin/lib/$_rp_cmd_file" ]]; then
            _rp_error "comando $cmd aún no portado (fase $_rp_cmd_fase)"
            return 2
        fi
        # shellcheck source=/dev/null
        . "$ROPERO_ROOT/bin/lib/$_rp_cmd_file"
        if ! declare -F "$_rp_cmd_func" >/dev/null 2>&1; then
            _rp_error "bin/lib/$_rp_cmd_file no define $_rp_cmd_func (fase $_rp_cmd_fase)"
            return 1
        fi
        "$_rp_cmd_func" "$@"
        return $?
    fi

    # Primer argumento que no es comando conocido ni empieza por '-':
    # arranque directo de modelo (§8.2) → cmd-runtime.sh / rp_cmd_start.
    if [[ ! -f "$ROPERO_ROOT/bin/lib/cmd-runtime.sh" ]]; then
        _rp_error "comando $cmd aún no portado (fase 4)"
        return 2
    fi
    # shellcheck source=/dev/null
    . "$ROPERO_ROOT/bin/lib/cmd-runtime.sh"
    if ! declare -F rp_cmd_start >/dev/null 2>&1; then
        _rp_error "bin/lib/cmd-runtime.sh no define rp_cmd_start (fase 4)"
        return 1
    fi
    rp_cmd_start "$cmd" "$@"
    return $?
}

main "$@"
exit $?
