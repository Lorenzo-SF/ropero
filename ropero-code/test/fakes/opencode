#!/usr/bin/env bash
# =============================================================================
# test/fakes/opencode — fake del CLI de opencode para la suite de test
# =============================================================================
# NO habla con ningún modelo. Devuelve un JSON con sessionID (para ejercitar
# el parseo del session id) y una sesión exportada, y REGISTRA cada
# invocación (cwd + argv) para poder verificar que el runner llama a
#
#     opencode run <prompt> --agent build --model ropero-local/<modelo> \
#             --format json --standalone
#
# Los fakes se usan SÓLO poniendo test/fakes al principio del PATH:
#
#     HOME=$(mktemp -d) PATH="$PWD/test/fakes:$PATH" bash test/test-groot.sh
#
# En el uso normal (sin ese PATH) el opencode de verdad es el que se usa.
# =============================================================================
set -u

FAKE_LOG="${FAKE_LOG:-$HOME/.fake-opencode.log}"
mkdir -p "$(dirname "$FAKE_LOG")" 2>/dev/null || true
printf '%s | cwd=%s | %s\n' "$(date '+%H:%M:%S')" "$PWD" "$*" >>"$FAKE_LOG" 2>/dev/null || true

cmd="${1:-}"
case "$cmd" in
    run)
        sid="ses_fake_$$"
        if [[ -f "$PWD/opencode.json" ]]; then
            cfg="$PWD/opencode.json"
        else
            cfg="SIN opencode.json"
        fi
        printf '%s | sesion=%s | config=%s\n' "$(date '+%H:%M:%S')" "$sid" "$cfg" >>"$FAKE_LOG" 2>/dev/null || true
        printf '{"type":"step_start","timestamp":1,"sessionID":"%s"}\n' "$sid"
        printf '{"type":"text","timestamp":2,"sessionID":"%s","text":"respuesta de la bateria (fake)"}\n' "$sid"
        printf '{"type":"step_finish","timestamp":3,"sessionID":"%s"}\n' "$sid"
        exit 0
        ;;
    session)
        sub="${2:-}"
        if [[ "$sub" == "export" ]]; then
            sid="${3:-}"
            printf '{\n'
            printf '  "info": { "id": "%s", "title": "bateria de prueba (fake)" },\n' "$sid"
            printf '  "messages": [\n'
            printf '    { "role": "user", "text": "bateria de prueba" },\n'
            printf '    { "role": "assistant", "text": "respuesta de la bateria (fake)" }\n'
            printf '  ]\n'
            printf '}\n'
            exit 0
        fi
        printf 'fake opencode: subcomando de session no soportado: %s\n' "$sub" >&2
        exit 1
        ;;
    models)
        if [[ -f "$PWD/opencode.json" ]] && command -v jq >/dev/null 2>&1; then
            jq -r '.providers["ropero-local"].models | keys[] | "ropero-local/" + .' \
                "$PWD/opencode.json" 2>/dev/null
        fi
        exit 0
        ;;
    *)
        printf 'fake opencode: comando no soportado: %s\n' "${cmd:-(vacío)}" >&2
        exit 1
        ;;
esac
