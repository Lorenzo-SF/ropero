#!/usr/bin/env bash
# =============================================================================
# test/fakes/pkill — fake de pkill para la suite de test
# =============================================================================
# NO mata NADA: registra lo que se le pide y sale 0. El pkill de verdad
# (`pkill -9 -x llama-server|opencode|mcode|claude`) mataría la sesión de
# opencode del usuario y el resto de procesos del sistema, así que en las
# pruebas con fakes este es un simple testigo.
#
# El runner nunca usa `pkill -9 python`: mataría procesos python ajenos.
# =============================================================================
set -u

FAKE_LOG="${FAKE_LOG:-$HOME/.fake-pkill.log}"
mkdir -p "$(dirname "$FAKE_LOG")" 2>/dev/null || true
printf '%s | %s\n' "$(date '+%H:%M:%S')" "$*" >>"$FAKE_LOG" 2>/dev/null || true
exit 0
