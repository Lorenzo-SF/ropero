#!/usr/bin/env bash
# =============================================================================
# test/fakes/gguffer/curl — curl falso que sirve la metadata de HuggingFace
# =============================================================================
# El gguffer habla con HuggingFace por curl en tres sitios:
#   · la metadata del repo (config.json, hf_quant_config.json): para saber
#     si los pesos ya vienen cuantizados y con que quant;
#   · la API de modelos (/api/models/<repo>): para listar los ficheros;
#   · la existence check de los repos hermanos (curl -f: 404 = no existe).
#
# Este curl falso sirve todo eso desde un directorio de fixtures:
#
#   $FAKE_HF_DIR/<owner>/<repo>/config.json
#   $FAKE_HF_DIR/<owner>/<repo>/hf_quant_config.json
#   $FAKE_HF_DIR/<owner>/<repo>/fake_file_type     (opcional: el file_type
#                                                    que escribe el conversor
#                                                    falso; por defecto 1=F16)
#
# Lo que no existe responde como un 404 de curl (-f): codigo 22 y nada
# escrito. Es lo que hace el curl de verdad, y el gguffer depende de ello
# (un 404 no puede dejar un cuerpo que parezca un JSON valido).
# =============================================================================
set -u

FAKE_HF_DIR="${FAKE_HF_DIR:-}"

out=""
url=""
fail=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o)   out="$2"; shift 2 ;;
        -o*)  out="${1#-o}"; shift ;;
        -f|--fail) fail=1; shift ;;
        --max-time|--connect-timeout) shift 2 ;;
        -*)   shift ;;
        *)    url="$1"; shift ;;
    esac
done

[[ -n "$url" ]] || exit 7

destino() {
    if [[ -n "$out" && "$out" != "/dev/null" ]]; then
        printf '%s' "$out"
    else
        printf '/dev/stdout'
    fi
}

# ── la API de modelos ───────────────────────────────────────────────────────
case "$url" in
    *"/api/models?"*)
        printf '[]\n' > "$(destino)"
        exit 0 ;;
    *"/api/models/"*)
        repo="${url#*/api/models/}"
        repo="${repo%%\?*}"
        repo="${repo%/}"
        dir="$FAKE_HF_DIR/$repo"
        if [[ -d "$dir" ]]; then
            printf '{"id": "%s", "siblings": [' "$repo"
            primero=1
            for f in "$dir"/*.gguf; do
                [[ -e "$f" ]] || continue
                [[ $primero -eq 1 ]] || printf ','
                primero=0
                printf '{"rfilename": "%s"}' "$(basename "$f")"
            done
            printf ']}\n' > "$(destino)"
            exit 0
        fi
        printf '[]\n' > "$(destino)"
        exit 0 ;;
esac

# ── la metadata del repo: /<owner>/<repo>/raw/main/<fichero> ───────────────
case "$url" in
    *"/raw/main/"*)
        # La URL es https://huggingface.co/<owner>/<repo>/raw/main/<fichero>.
        # El owner/repo es lo que va ANTES del "/raw/main/".
        base="${url%%/raw/main/*}"
        base="${base#*//}"      # quita el esquema
        base="${base#*/}"       # quita el host
        fichero="${url#*/raw/main/}"
        fichero="${fichero%%\?*}"
        src="$FAKE_HF_DIR/$base/$fichero"
        if [[ -f "$src" ]]; then
            cat "$src" > "$(destino)"
            exit 0
        fi
        # 404: curl -f no escribe el cuerpo y sale con 22.
        exit 22 ;;
esac

exit 7
