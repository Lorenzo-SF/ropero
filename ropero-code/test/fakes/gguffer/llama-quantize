#!/usr/bin/env bash
# =============================================================================
# test/fakes/gguffer/llama-quantize — el cuantizador del motor, falso
# =============================================================================
# El gguffer habla con el motor en dos sitios:
#   · `llama-quantize --help` : la lista de quants que soporta. De ahi sale
#     el NUMERO de cada quant, que es un llama_ftype (el enum de
#     include/llama.h), NO un ggml_type. Esta lista se reproduce aqui tal
#     cual la imprime el motor de verdad (tools/quantize/quantize.cpp), con
#     sus alias ("Q3_K" es alias de "Q3_K_M" y comparte numero).
#   · `llama-quantize <opciones> <in> <out> <QUANT>` : la cuantizacion.
#
# El falso hace tres cosas:
#   1. con --help, imprime la lista de quants (la de verdad);
#   2. con una cuantizacion real, COPIA el fichero de entrada al de salida
#      (para que el gguffer tenga algo que colocar y verificar) y deja
#      constancia en $FAKE_QUANT_LOG de lo que se pidio;
#   3. si se le pide re-cuantizar algo que ya esta cuantizado, FALLA con el
#      mismo mensaje que el motor ("requantizing from type X is disabled").
#      Es lo que hace el motor de verdad, y es lo que el gguffer tiene que
#      evitar.
#
# El GGUF que copia lleva el general.file_type del quant pedido, para que
# el gguffer pueda comprobar (con ggufcheck) que el resultado es el que
# dice ser.
# =============================================================================
set -u

FAKE_QUANT_LOG="${FAKE_QUANT_LOG:-}"
FAKE_GGUF_PY="${FAKE_GGUF_PY:-}"

# ── la lista de quants del motor (tal cual la imprime) ──────────────────────
# El numero es el llama_ftype: el MISMO que va en general.file_type del GGUF.
# Por eso el gguffer puede comparar lo que pide con lo que sale.
listar_quants() {
    cat <<'LIST'
 40  or  Q1_0    : 1.125 bpw quantization
 41  or  Q2_0    : 2.25 bpw quantization (group 64)
  2  or  Q4_0    : 4.34G, +0.4685 ppl @ Llama-3-8B
  3  or  Q4_1    : 4.78G, +0.4511 ppl @ Llama-3-8B
 38  or  MXFP4_MOE: MXFP4 MoE
 39  or  NVFP4   : 4.50 bpw NVIDIA FP4
  8  or  Q5_0    : 5.21G, +0.1316 ppl @ Llama-3-8B
  9  or  Q5_1    : 5.65G, +0.1062 ppl @ Llama-3-8B
 19  or  IQ2_XXS : 2.06 bpw quantization
 20  or  IQ2_XS  : 2.31 bpw quantization
 28  or  IQ2_S   : 2.5  bpw quantization
 29  or  IQ2_M   : 2.7  bpw quantization
 24  or  IQ1_S   : 1.56 bpw quantization
 31  or  IQ1_M   : 1.75 bpw quantization
 36  or  TQ1_0   : 1.69 bpw ternarization
 37  or  TQ2_0   : 2.06 bpw ternarization
 43  or  TQ3_1S  : 4.00 bpw WHT-rotated
 44  or  TQ4_1S  : 5.00 bpw WHT-rotated
 10  or  Q2_K    : 2.96G, +3.5199 ppl @ Llama-3-8B
 21  or  Q2_K_S  : 2.96G, +3.1836 ppl @ Llama-3-8B
 23  or  IQ3_XXS : 3.06 bpw quantization
 26  or  IQ3_S   : 3.44 bpw quantization
 27  or  IQ3_M   : 3.66 bpw quantization mix
 12  or  Q3_K    : alias for Q3_K_M
 22  or  IQ3_XS  : 3.3 bpw quantization
 11  or  Q3_K_S  : 3.41G, +1.6321 ppl @ Llama-3-8B
 12  or  Q3_K_M  : 3.74G, +0.6569 ppl @ Llama-3-8B
 13  or  Q3_K_L  : 4.03G, +0.5562 ppl @ Llama-3-8B
 25  or  IQ4_NL  : 4.50 bpw non-linear quantization
 30  or  IQ4_XS  : 4.25 bpw non-linear quantization
 15  or  Q4_K    : alias for Q4_K_M
 14  or  Q4_K_S  : 4.37G, +0.2689 ppl @ Llama-3-8B
 15  or  Q4_K_M  : 4.58G, +0.1754 ppl @ Llama-3-8B
 17  or  Q5_K    : alias for Q5_K_M
 16  or  Q5_K_S  : 5.21G, +0.1049 ppl @ Llama-3-8B
 17  or  Q5_K_M  : 5.33G, +0.0569 ppl @ Llama-3-8B
 18  or  Q6_K    : 6.14G, +0.0217 ppl @ Llama-3-8B
  7  or  Q8_0    : 7.96G, +0.0026 ppl @ Llama-3-8B
 42  or  Q8_CR   : 7.96G, ConvRot-rotated Q8_0
 45  or  Q5_CR   : 5.21G, ConvRot-rotated Q5_0
 46  or  Q6_CR   : 6.56G, ConvRot-rotated Q6_K
  1  or  F16     : 14.00G, +0.0020 ppl @ Mistral-7B
 32  or  BF16    : 14.00G, -0.0050 ppl @ Mistral-7B
  0  or  F32     : 26.00G              @ 7B
          COPY    : only copy tensors, no quantizing
LIST
}

case "${1:-}" in
    --help|-h)
        listar_quants
        exit 0 ;;
esac

# ── una cuantizacion real ──────────────────────────────────────────────────
entrada=""
salida=""
quant=""
imatrix=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --imatrix)     imatrix="$2"; shift 2 ;;
        --tensor-type|--output-tensor-type|--token-embedding-type)
                        shift 2 ;;
        --*)           shift ;;
        *)
            if [[ -z "$entrada" ]]; then
                entrada="$1"
            elif [[ -z "$salida" ]]; then
                salida="$1"
            else
                quant="$1"
            fi
            shift ;;
    esac
done

[[ -n "$entrada" && -n "$salida" && -n "$quant" ]] || {
    echo "llama-quantize falso: uso incorrecto" >&2; exit 2; }

[[ -n "$FAKE_QUANT_LOG" ]] && printf '%s|%s|%s|%s\n' "$quant" "$entrada" "$salida" "$imatrix" >>"$FAKE_QUANT_LOG"

# El motor REAL no re-cuantiza: si el fichero de entrada ya esta cuantizado
# (y no se pasa --allow-requantize), dice esto y sale con error.
if [[ -n "$FAKE_GGUF_PY" && -f "$FAKE_GGUF_PY" ]]; then
    ft_in="$(python3 "$FAKE_GGUF_PY" file_type "$entrada" 2>/dev/null || true)"
    case "$ft_in" in
        1|32|0|"") ;;   # F16, BF16, F32: no estan cuantizados
        *)
            echo "llama_model_quantize: failed to quantize: requantizing from type ${ft_in} is disabled" >&2
            exit 1 ;;
    esac
fi

# "Cuantizar" = copiar el GGUF de entrada al de salida con el file_type del
# quant pedido (lo que el motor de verdad hace, en lo que importa aqui).
if [[ -n "$FAKE_GGUF_PY" && -f "$FAKE_GGUF_PY" ]]; then
    python3 "$FAKE_GGUF_PY" requant "$entrada" "$salida" "$quant" || exit 1
else
    cp -f "$entrada" "$salida" || exit 1
fi
exit 0
