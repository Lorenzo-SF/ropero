#!/usr/bin/env bash
# =============================================================================
# test/fakes/strata/curl — el curl falso del instalador de Strata
# =============================================================================
# El engine baja el instalador oficial con `curl -fsSL <url> -o <fichero>` y
# lo ejecuta con `sh`. Este curl falso escribe ESE fichero (un instalador
# falso que deja una marca) y no sale a la red.
set -u
out=""
prev=""
for a in "$@"; do
    case "$prev" in
        -o|--output) out="$a" ;;
    esac
    prev="$a"
done
[[ -n "$out" ]] || { echo "curl falso: falta -o" >&2; exit 1; }
cat >"$out" <<'INSTALL'
#!/usr/bin/env sh
printf 'instalador falso: %s\n' "$*" >"${FAKE_STRATA_INSTALLED:-/dev/null}"
exit 0
INSTALL
chmod +x "$out"
exit 0
