#!/usr/bin/env bash
# fake opencode: run → JSON con sessionID; session export → JSON
case "${1:-}" in
  run)
    printf '{"sessionID":"ses_fake_1","type":"text","part":{"text":"ok"}}\n'
    exit 0 ;;
  session)
    [[ "${2:-}" == "export" ]] || exit 2
    printf '{"id":"%s","messages":[{"role":"user","content":"hola"}]}\n' "${3:-ses_fake_1}"
    exit 0 ;;
  --version) echo "opencode fake 1.0"; exit 0 ;;
  *) exit 0 ;;
esac
