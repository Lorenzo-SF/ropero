#!/usr/bin/env bash

# =============================================================================
# ropero — lanzador simplificado de llama-server con modelos modulares
# =============================================================================
# USO:
#   ropero <modelo> [--background] [--cpu] [--force] [--port N]
#   ropero list | status [--craft] [--watch [ms]] | stop <modelo>|all | help
#   ropero models      (descarga solo los modelos por defecto, sin engines)
#   ropero --install [all|models|engines|link] [--force]
#   ropero --check     (verifica la instalación, no modifica nada)
# =============================================================================

# Directorios y binarios
GGUF_DIR="${GGUF_DIR:-$HOME/models/gguf}"
SAFETENSORS_DIR="${SAFETENSORS_DIR:-$HOME/models/safetensors}"
LOG_DIR="${LOG_DIR:-$HOME/.logs/ropero}"
LLAMA_BIN="${LLAMA_BIN:-llama-server}"
LLAMA_API_KEY="${LLAMA_API_KEY:-sk-local-dev-key}"
HOST="${HOST:-0.0.0.0}"

# -----------------------------------------------------------------------------
# Puertos "slot" por defecto (los dos únicos que existían antes de MODEL_PORT).
#   $PORT     → GPU  :9999
#   $CPU_PORT → CPU  :9998  (offload forzado a CPU)
#
# Cualquier modelo puede además pinear un puerto propio declarando MODEL_PORT
# en su .sh de ropero.d/. Si lo hace, ESE puerto gana siempre: da igual si se
# invoca con --cpu o sin él. Sin MODEL_PORT, se aplica la lógica de dos slots
# de aquí (--cpu → $CPU_PORT, si no → $PORT).
# Ambos son sobrescribibles por entorno para tests: ROPERO_GPU_PORT / ROPERO_CPU_PORT.
# -----------------------------------------------------------------------------
PORT="${ROPERO_GPU_PORT:-9999}"
CPU_PORT="${ROPERO_CPU_PORT:-9998}"

mkdir -p "$GGUF_DIR" "$LOG_DIR" 2>/dev/null

# Colores (ANSI-C quoting $'...' para que \033 se interprete como ESC,
# NO como literal — verificado con hexdump: "..." daba los 4 chars "\033".
# Bug histórico: el help mostraba escapes literales en pantalla.)
# Paleta completa: la usan cmd_help y _render_status_compact (versión
# artesanal del status con etiquetas CPU/GPU coloreadas y tabla padded).
BOLD=$'\033[1m'
DIM=$'\033[2m'
NC=$'\033[0m'
GREEN=$'\033[0;32m'
GRN_B=$'\033[1;32m'
RED=$'\033[0;31m'
YELLOW=$'\033[1;33m'
YEL_B=$'\033[1;33m'
BLUE=$'\033[0;34m'
BLUE_B=$'\033[1;34m'
CYAN=$'\033[0;36m'
CYAN_B=$'\033[1;36m'
GREY=$'\033[0;90m'

# -----------------------------------------------------------------------------
# Limpieza de los marcadores de "aviso una sola vez" (ver _ropero_warn_once).
# Se engancha AQUÍ, en el entrypoint, porque es el único punto que se ejecuta
# siempre en el proceso principal: si se registrara dentro de la función que
# los crea, quedaría atrapado en el subshell que la llamó primero y no se
# ejecutaría nunca, dejando ficheros en /tmp.
# -----------------------------------------------------------------------------
_ropero_warn_cleanup() {
    local f="${TMPDIR:-/tmp}/.ropero_warn_$$"
    rm -f "$f" "$f.born" 2>/dev/null || true
}
trap '_ropero_warn_cleanup' EXIT INT TERM

# -----------------------------------------------------------------------------
# Modo desatendido: override de ropero_ask / ropero_ask_keep
# -----------------------------------------------------------------------------
# 1) Detección FUERTE al inicio del entrypoint (no en funciones sourceadas).
#    Si setup nos invoca con AUTO_YES=1 / SETUP_MODE=full / CI=1, lo
#    reflejamos en una variable interna _ropero_unattended y en env.
# 2) Sobrescribimos las funciones ANTES de sourcear módulos.
# 3) Re-aplicamos el override DESPUÉS de sourcear (defensa en profundidad:
#    si un módulo redefine ropero_ask, lo devolvemos a no-interactive).
if [[ "${AUTO_YES:-0}" == "1" || "${SETUP_MODE:-}" == "full" || "${CI:-0}" == "1" ]]; then
    _ropero_unattended=1
    # Exportar para que sub-procesos (cmake, git clone, etc.) hereden
    export AUTO_YES=1
    export SETUP_MODE=full
fi
# Si el usuario llamó ropero --install interactivamente y quiere que le
# preguntemos, no tocamos nada. _ropero_unattended queda en 0.

# -----------------------------------------------------------------------------
# Cargar módulos
# -----------------------------------------------------------------------------
# Canonicalizar SCRIPT_DIR: si el script se ejecuta desde un symlink (caso
# típico: ~/bin/ropero -> setup/bin/ropero), BASH_SOURCE[0] apunta
# al symlink y SCRIPT_DIR terminaría en ~/bin/, donde NO están los .d/.
# Resolvemos con readlink -f (GNU) o perl (BSD/macOS) para apuntar al path real.
# Cross-platform: readlink -f || perl abs_path || $_SELF sin resolver.
# Cross-shell (bash + zsh): BASH_SOURCE[0] no existe en zsh; $0 = path
# del script sourceado en zsh.
_SELF="${BASH_SOURCE[0]:-$0}"
_REAL="$(readlink -f "$_SELF" 2>/dev/null \
    || perl -MCwd -e 'print Cwd::abs_path shift' "$_SELF" 2>/dev/null \
    || echo "$_SELF")"
SCRIPT_DIR="$(cd "$(dirname "$_REAL")" && pwd)"
MODULES_DIR="$SCRIPT_DIR/ropero.d"

if [[ -f "$MODULES_DIR/_common.sh" ]]; then
    source "$MODULES_DIR/_common.sh"
else
    echo "ERROR: no se encuentra $MODULES_DIR/_common.sh" >&2
    exit 1
fi

# Utilidades mínimas propias + entorno (spec migración: réplica 00-utils + 01-env).
# Se sourcean explícitos; el loop de modelos los salta (no definen MODEL_*).
[[ -f "$MODULES_DIR/00-utils.sh" ]] && source "$MODULES_DIR/00-utils.sh"
[[ -f "$MODULES_DIR/01-env.sh" ]] && source "$MODULES_DIR/01-env.sh"

# Sourcear explícitamente los módulos de soporte/infra del install.
# El loop de modelos los salta (no definen MODEL_*).
[[ -f "$MODULES_DIR/20-compile-llama.sh" ]]  && source "$MODULES_DIR/20-compile-llama.sh"
[[ -f "$MODULES_DIR/21-download-models.sh" ]] && source "$MODULES_DIR/21-download-models.sh"
# Registro de engines que NO son llama-server (airllm, mlx_lm, tensorrt-llm,
# fastflowlm). Define cómo se resuelve cada binario, qué flags acepta de verdad
# y si valida la API key por sí mismo o necesita el proxy de _authproxy.py.
# Sin esto, cada sitio que nombraba un engine repetía su comando a mano.
[[ -f "$MODULES_DIR/_engines.sh" ]] && source "$MODULES_DIR/_engines.sh"

# Re-aplicar override de desatendido DESPUÉS de sourcear módulos. Si los
# módulos redefinen ropero_ask / ropero_ask_keep (no deberían, pero por si),
# dejamos nuestras versiones blindadas.
if [[ "${_ropero_unattended:-0}" == "1" ]]; then
    ropero_ask() { return 0; }
    ropero_ask_keep() { return 1; }
fi

declare -A MODEL_GGUF MODEL_CTX MODEL_ENGINE MODEL_PATH MODEL_ALIAS MODEL_ALIAS_TARGET MODEL_GPU MODEL_PORT MODEL_FORMAT MODEL_DL
declare -a MODEL_NAMES=()
# puerto → script que lo reclamó. Solo para detectar colisiones al cargar.
declare -A _MODEL_PORT_OWNER=()

for f in "$MODULES_DIR"/*.sh; do
    [[ -f "$f" ]] || continue
    bn="$(basename "$f" .sh)"
    # Excluir helpers que empiezan con _ y entorno/utils propios (00-utils, 01-env)
    [[ "$bn" == _* ]] && continue
    [[ "$bn" == "00-utils" || "$bn" == "01-env" ]] && continue
    # Excluir módulos de soporte/infra que NO son modelos:
    #   NN-compile-*.sh  — compilación de llama.cpp
    #   NN-download-*.sh — descarga de modelos por defecto
    # (convención "NN-<nombre>.sh" extraída del spec para modularizar
    # el install, sin que el loop los confunda con modelos)
    [[ "$bn" == *-compile-* || "$bn" == *-download-* ]] && continue
    # Excluir las PLANTILLAS de modelo (30-template-<engine>.sh). Viven en
    # ropero.d/ a propósito, para poder leerlas y copiarlas, pero no son
    # modelos: si el loop las cargara, `ropero list` ofrecería entradas
    # rotas con MODEL_PATH="PON_AQUI..." y `ropero 30-template-mlx` fallaría
    # al buscar un directorio que no existe. Copia la que quieras a
    # ropero.d/<nombre>.sh (sin el prefijo 30-) y esa sí se carga.
    [[ "$bn" == *-template-* ]] && continue

    # Normalizar nombre: reemplazar guiones por guiones bajos para variables/funciones
    alias_name="${bn//-/_}"

    # Limpiar variables
    MODEL_GGUF=
    MODEL_CTX=
    MODEL_ENGINE=
    MODEL_PATH=
    MODEL_ALIAS=
    MODEL_PORT=
    MODEL_FORMAT=
    MODEL_DOWNLOAD=
    source "$f"

    engine="${MODEL_ENGINE:-llama-server}"
    MODEL_ENGINE["$alias_name"]="$engine"

    case "$engine" in
        "llama-server")
            if [[ -z "${MODEL_GGUF:-}" || -z "${MODEL_CTX:-}" ]]; then
                echo "WARN: $f (engine=llama-server) no define MODEL_GGUF o MODEL_CTX, se omite" >&2
                continue
            fi
            if ! declare -f "get_model_args_${alias_name}" >/dev/null; then
                echo "WARN: $f (engine=llama-server) no define get_model_args_${alias_name}, se omite" >&2
                continue
            fi
            ;;
        # Engines con servidor propio. Ya no se escriben a mano en start_model:
        # todo (binario, flags, auth) sale de ropero.d/_engines.sh, que es
        # donde se verificaron contra el --help real de cada uno.
        "airllm"|"mlx_lm"|"tensorrt-llm"|"fastflowlm")
            if [[ -z "${MODEL_PATH:-}" || -z "${MODEL_CTX:-}" ]]; then
                echo "WARN: $f (engine=$engine) no define MODEL_PATH o MODEL_CTX, se omite" >&2
                continue
            fi
            if [[ "$MODEL_PATH" != /* ]]; then
                MODEL_PATH["$alias_name"]="$SAFETENSORS_DIR/$MODEL_PATH"
            else
                MODEL_PATH["$alias_name"]="$MODEL_PATH"
            fi
            ;;
        *)
            echo "WARN: $f (engine=$engine) motor desconocido, se omite" >&2
            continue
            ;;
    esac

    # ── MODEL_PORT opcional ────────────────────────────────────────────────
    # Si el script lo declara, el modelo queda pineado a ese puerto SIEMPRE,
    # con o sin --cpu (ver _model_port). Es la única forma de tener más de
    # dos modelos vivos a la vez sin pelear por :9999/:9998.
    #
    # Validamos aquí y no en start_model: un puerto mal escrito debe delatar
    # al culpable al CARGAR (con el nombre del .sh), no 3 comandos después
    # cuando el modelo ya haOccupado media GPU.
    if [[ -n "${MODEL_PORT:-}" ]]; then
        if ! [[ "$MODEL_PORT" =~ ^[0-9]+$ ]] || (( MODEL_PORT < 1 || MODEL_PORT > 65535 )); then
            echo "WARN: $f define MODEL_PORT='$MODEL_PORT' inválido (entero 1-65535); se ignora y se usará el slot por defecto" >&2
            MODEL_PORT=
        elif [[ "$MODEL_PORT" == "$PORT" || "$MODEL_PORT" == "$CPU_PORT" ]]; then
            echo "WARN: $f define MODEL_PORT=$MODEL_PORT, que ya es uno de los slots por defecto (:$PORT GPU / :$CPU_PORT CPU); se ignora" >&2
            MODEL_PORT=
        elif [[ -n "${_MODEL_PORT_OWNER[$MODEL_PORT]:-}" ]]; then
            echo "WARN: $f define MODEL_PORT=$MODEL_PORT, ya reclamado por '${_MODEL_PORT_OWNER[$MODEL_PORT]}'; se ignora (solo uno puede vivir en ese puerto)" >&2
            MODEL_PORT=
        else
            _MODEL_PORT_OWNER["$MODEL_PORT"]="$bn"
        fi
    fi

    MODEL_NAMES+=("$alias_name")
    MODEL_GGUF["$alias_name"]="${MODEL_GGUF:-}"
    MODEL_CTX["$alias_name"]="${MODEL_CTX:-}"
    MODEL_PORT["$alias_name"]="${MODEL_PORT:-}"
    MODEL_FORMAT["$alias_name"]="${MODEL_FORMAT:-}"
    # MODEL_DOWNLOAD va en array y no como variable suelta por la misma razón que
    # MODEL_GGUF: el loader sourcea TODOS los scripts seguidos, así que una
    # variable normal se queda con el valor del ÚLTIMO script sourceado. Al
    # arrancar el modelo 'metaloss' le estamparías el hint de descarga del
    # último .sh alfabético.
    MODEL_DL["$alias_name"]="${MODEL_DOWNLOAD:-}"
    MODEL_ALIAS["$alias_name"]="$bn"  # guardar nombre original para mostrarlo

    # Si el script define un alias público (MODEL_ALIAS), registrarlo como
    # segunda key que apunta al mismo modelo. Permite `ropero coder` aunque
    # el script físico sea devstral.sh. La key del alias se normaliza igual
    # (guiones a guiones bajos) para mantener consistencia con MODEL_NAMES.
    public_alias="${MODEL_ALIAS:-}"
    if [[ -n "$public_alias" ]]; then
        public_alias="${public_alias//-/_}"
        # Evitar colisión con un nombre de script ya cargado: si por error
        # un alias coincide con un modelo físico previo, gana el modelo y se
        # imprime WARN para no ocultar el conflicto.
        if [[ " ${MODEL_NAMES[*]} " =~ " $public_alias " ]]; then
            echo "WARN: $f define MODEL_ALIAS='$public_alias' pero ese nombre ya está registrado por otro script; se omite" >&2
        else
            MODEL_NAMES+=("$public_alias")
            MODEL_GGUF["$public_alias"]="${MODEL_GGUF:-}"
            MODEL_CTX["$public_alias"]="${MODEL_CTX:-}"
            MODEL_ENGINE["$public_alias"]="$engine"
            MODEL_PORT["$public_alias"]="${MODEL_PORT:-}"
            MODEL_FORMAT["$public_alias"]="${MODEL_FORMAT:-}"
            MODEL_DL["$public_alias"]="${MODEL_DL[$alias_name]:-}"
            # Key de redirección: si $model coincide con el alias público,
            # start_model lo manda al script físico (alias_name).
            MODEL_ALIAS_TARGET["$public_alias"]="$alias_name"
            # Para que cmd_list muestre el alias público como nombre "humano"
            MODEL_ALIAS["$public_alias"]="$public_alias"
        fi
    fi
done

# -----------------------------------------------------------------------------
# Funciones auxiliares
# -----------------------------------------------------------------------------
port_listening() { lsof -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }
get_pid_for_port() { lsof -t -iTCP:"$1" -sTCP:LISTEN 2>/dev/null | head -1; }
get_model_on_port() {
    # El patrón tolera el espacio opcional alrededor de los dos puntos.
    #
    # No es parsería por el gusto de parsear: llama-server serializa JSON
    # compacto ("id":"nombre") y el patrón viejo, que exigía exactamente eso,
    # funcionaba solo por casualidad. Cualquier server que serialice con
    # espacios —Python lo hace por defecto, y eso incluye al que escribe ropero
    # para airllm y al proxy— devolvía vacío. Y un vacío aquí no es un detalle
    # cosmético: el bucle de arranque de --background nunca daba el modelo por
    # bueno y se comía los 180s de espera para luego decir que no había
    # respondido; y `ropero stop <modelo>` no encontraba lo que estaba corriendo.
    curl -sf --max-time 2 \
        -H "Authorization: Bearer $LLAMA_API_KEY" \
        "http://127.0.0.1:$1/v1/models" 2>/dev/null \
        | grep -oE '"id"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 \
        | sed -E 's/.*"([^"]*)"[[:space:]]*$/\1/'
}

# -----------------------------------------------------------------------------
# engine_on_port <port> → qué engine responde en ese puerto, o "" si no se sabe.
#
# Por qué hace falta si ya se mira el nombre del proceso: cuando un engine NO
# valida la API key (mlx_lm, trtllm-serve, flm), ropero pone delante
# _authproxy.py, y el proceso que escucha en el puerto de ropero es un
# `python3` anónimo. `ps -o comm=` devolvería "Python" para los tres, y la
# columna ENGINE del status mentiría. El proxy publica /ropero/engine, que es
# la única fuente de verdad.
#
# Para llama-server y para airllm (que validan la key ellos mismos) la ruta
# devuelve 404 y caemos al nombre del proceso, que ahí sí es informativo.
# Sin auth, curl no manda nada: es una ruta local de diagnóstico.
# -----------------------------------------------------------------------------
engine_on_port() {
    local p="$1" j
    j=$(curl -sf --max-time 2 "http://127.0.0.1:$p/ropero/engine" 2>/dev/null) || return 1
    [[ -n "$j" ]] || return 1
    printf '%s' "$j" | grep -oE '"engine"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 \
        | sed -E 's/.*"([^"]*)"[[:space:]]*$/\1/'
}

# child_pid_on_port <port> → PID del engine hijo que el proxy de auth tiene
# launching, o "" si no hay proxy (llama-server, airllm) o no responde.
# Lo usa el apagado para no dejar engines huérfanos.
child_pid_on_port() {
    local p="$1" j
    j=$(curl -sf --max-time 2 "http://127.0.0.1:$p/ropero/engine" 2>/dev/null) || return 1
    [[ -n "$j" ]] || return 1
    printf '%s' "$j" | grep -oE '"child_pid"[[:space:]]*:[[:space:]]*[0-9]+' | head -1 \
        | grep -oE '[0-9]+' || true
}

# _engine_from_comm <bin_name> → engine a partir del nombre del proceso.
# Fallback para cuando /ropero/engine no contesta.
_engine_from_comm() {
    case "$1" in
        *airllm*)       printf 'airllm' ;;
        *mlx_lm*|*mlx*) printf 'mlx_lm' ;;
        *trtllm*)       printf 'tensorrt-llm' ;;
        *flm*|*fastflow*) printf 'fastflowlm' ;;
        *llama-server*) printf 'llama-server' ;;
        *)              printf 'llama-server' ;;
    esac
}

# _engine_human <port> → engine del puerto, para poder nombrarlo al pararlo.
_engine_human() {
    local eng
    eng=$(engine_on_port "$1" 2>/dev/null || true)
    if [[ -n "$eng" ]]; then
        ropero_engine_label "$eng"
    else
        local p comm
        p=$(get_pid_for_port "$1" 2>/dev/null || true)
        comm=$(ps -p "$p" -o comm= 2>/dev/null || true)
        _engine_from_comm "$comm"
    fi
}

# -----------------------------------------------------------------------------
# _kill_port <port> — apaga lo que vive en <port>, incluido su engine hijo.
# Por puerto, nunca por nombre de proceso: un `pkill -f trtllm` mataría los slots
# paralelos. Devuelve 0 si había algo, 1 si el puerto estaba libre.
#
# ⚠️ SIGTERM primero, SIGKILL de recurso. No es puritanismo: es lo que sostiene
# el árbol de procesos de los engines con proxy. El proxy (ropero.d/_authproxy.py)
# es el PADRE del engine, y es él quien, al recibir SIGTERM, apaga a su hijo y
# suelta el puerto interno. Con `kill -9` —que era lo que había— el proxy moría
# sin ejecutar su handler, el engine real se quedaba sirviendo en :10xxx para
# siempre, y lo peor es que `ropero status` no lo enseña: no está en ningún puerto
# gestionado. Se quedaba ahí comiéndose la GPU/RAM/NPU sin que nada lo dijera.
#
# El SIGKILL sigue como red de seguridad: si algo ignora SIGTERM, el puerto tiene
# que quedar libre igual.
#
# Lo usan cmd_stop y el --force de start_model. Por eso es de nivel de archivo y
# no una función anidada en cmd_stop: una función definida dentro de otra no
# existe hasta que esa se ha ejecutado, y estos dos caminos nunca corren juntos.
# -----------------------------------------------------------------------------
_kill_port() {
    local port="$1"
    if ! port_listening "$port"; then
        return 1
    fi
    local pid
    pid=$(get_pid_for_port "$port")
    if [[ -z "$pid" ]]; then
        return 1
    fi

    # Red de seguridad explícita, antes de tocar el padre: si el proceso raíz no
    # va a propagar (ignora SIGTERM, está zombi, o el proxy ya murió), el
    # child_pid que publica /ropero/engine dice a quién hay que matar igualmente.
    local cpid
    cpid=$(child_pid_on_port "$port")
    if [[ -n "$cpid" ]]; then
        kill -TERM "$cpid" 2>/dev/null || true
    fi

    kill -TERM "$pid" 2>/dev/null || true
    local waited=0
    while (( waited < 10 )) && port_listening "$port"; do
        sleep 1
        (( waited++ ))
    done
    if port_listening "$port"; then
        kill -9 "$pid" 2>/dev/null || true
        sleep 1
    fi
    if [[ -n "$cpid" ]] && kill -0 "$cpid" 2>/dev/null; then
        kill -9 "$cpid" 2>/dev/null || true
    fi
    return 0
}

# _stop_port <port> — _kill_port + limpiar el registro de puertos ad-hoc.
_stop_port() {
    local port="$1"
    _kill_port "$port" || return 1
    # Si el puerto era ad-hoc (pedido con --port), ya no sirve para nada: sale
    # del registro para que no siga saliendo en el status.
    _ropero_adhoc_del "$port"
    return 0
}

# -----------------------------------------------------------------------------
# Puertos: registro, resolución y etiquetado.
#
# Hay TRES fuentes de puertos, en este orden de precedencia:
#
#   1. MODEL_PORT declarado en el .sh del modelo  → gana SIEMPRE
#      (da igual --cpu o no: el puerto está pineado, el offload no se mueve).
#      Es lo que permite tener N modelos vivos a la vez en lugar de 2.
#   2. --cpu                                        → $CPU_PORT (:9998)
#   3. resto                                       → $PORT (:9999)
#
# `ropero status` lista TODOS los puertos conocidos, no solo los dos slots:
# los dos por defecto + los pineados por los scripts. Así se ve de un vistazo
# qué está configurado y qué está encendido.
# -----------------------------------------------------------------------------

# _model_port <model_key> → puerto pineado por el modelo, o 1 si no lo tiene.
# Acepta también el env por modelo (ROPERO_<MODELO>_PORT), igual que
# ROPERO_<MODELO>_CTX. Silencioso si no hay puerto fijo: devuelve 1.
_model_port() {
    local mk="$1"
    local env_name="ROPERO_$(printf '%s' "$mk" | tr '[:lower:]' '[:upper:]')_PORT"
    local env_val="${!env_name:-}"
    local p="${MODEL_PORT[$mk]:-}"

    # El env manda sobre el script, pero SOLO si es válido. Un typo en el env
    # (ROPERO_EMBED_PORT=abc, o el 9990 que se te pasó sin querer) no puede
    # dejar al modelo sin puerto: si el override es inservible se avisa y se
    # cae al valor del .sh, que es lo que el autor del script pidió.
    if [[ -n "$env_val" ]]; then
        if _ropero_valid_port "$env_val"; then
            p="$env_val"
        elif _ropero_warn_once "port_$env_name"; then
            # 0 = primera vez en este comando: avisamos.
            echo "AVISO: $env_name='$env_val' no es un puerto válido (entero 1-65535); se usa el del script" >&2
        fi
    fi

    if _ropero_valid_port "$p"; then
        printf '%s' "$p"
        return 0
    fi
    return 1
}

# _ropero_valid_port <valor> → 0 si es un puerto TCP usable.
_ropero_valid_port() {
    [[ "$1" =~ ^[0-9]+$ ]] && (( $1 >= 1 && $1 <= 65535 ))
}

# _ropero_warn_once <clave> → 0 la primera vez que se llama en el comando, 1 las
# siguientes.
#
# Por qué un fichero y no una variable: _model_port se llama desde
# ropero_managed_ports y ropero_port_label, que se usan en process substitution
# (`while read; do ... done < <(ropero_managed_ports)`). Cada uno corre en un
# SUBSHELL, así que un flag en variable se perdería y el aviso se repetiría
# tantas veces como modelos y puertos se recorren. El fichero se borra con el
# trap del entrypoint (ver _ropero_warn_cleanup, enganchado arriba del todo).
_ropero_warn_once() {
    # Un ÚNICO fichero por proceso, con una línea por clave ya avisada. Uno por
    # clave no vale: alCleanup correría en el subshell que lo creó, no en el
    # proceso principal, y se quedarían ficheros en /tmp para siempre.
    local f="${TMPDIR:-/tmp}/.ropero_warn_$$"
    local key="$1"
    if [[ -f "$f" ]] && grep -qxF -- "$key" "$f" 2>/dev/null; then
        return 1
    fi
    printf '%s\n' "$key" >>"$f" 2>/dev/null || return 1
    return 0
}

# -----------------------------------------------------------------------------
# Registro de puertos "ad-hoc" (los de `--port`).
#
# `ropero status` y `ropero stop` son OTROS procesos: no pueden saber que hace
# un rato lanzaste `ropero embed --port 9995`. Sin este registro el modelo
# arrancaba en 9995 pero su fila no salía en el status y `ropero stop embed` no
# lo encontraba — vivo, invisible e imparable salvo a mano.
#
# Se añade al arrancar y se quita al parar (cmd_stop), no por antigüedad: así no
# hay carrera con un arranque en curso, que tarda segundos en escuchar.
# ---------------------------------------------------------------------------
_ropero_adhoc_file() { printf '%s/ad-hoc-ports' "${LOG_DIR:-$HOME/.logs/ropero}"; }

_ropero_adhoc_add() {
    local port="$1" f
    _ropero_valid_port "$port" || return 0
    f=$(_ropero_adhoc_file)
    mkdir -p "$(dirname "$f")" 2>/dev/null || return 0
    if grep -qxF -- "$port" "$f" 2>/dev/null; then return 0; fi
    printf '%s\n' "$port" >>"$f" 2>/dev/null || true
}

_ropero_adhoc_del() {
    local port="$1" f
    f=$(_ropero_adhoc_file)
    [[ -f "$f" ]] || return 0
    grep -vxF -- "$port" "$f" >"$f.tmp" 2>/dev/null || true
    mv -f "$f.tmp" "$f" 2>/dev/null || rm -f "$f.tmp" 2>/dev/null || true
}

# ropero_managed_ports → todos los puertos que ropero conoce, ordenados y sin
# duplicados: los dos slots por defecto + los pineados por cada modelo + los
# ad-hoc de --port.
# Es la lista canónica: la usan status (tabla), stop all y stop <modelo>.
ropero_managed_ports() {
    local -a ports=("$PORT" "$CPU_PORT")
    local mk p extra f
    if declare -p MODEL_PORT >/dev/null 2>&1; then
        for mk in "${!MODEL_PORT[@]}"; do
            if p=$(_model_port "$mk"); then
                ports+=("$p")
            fi
        done
    fi
    f=$(_ropero_adhoc_file)
    if [[ -f "$f" ]]; then
        while read -r extra; do
            [[ -n "$extra" ]] || continue
            if _ropero_valid_port "$extra"; then
                ports+=("$extra")
            fi
        done <"$f"
    fi
    printf '%s\n' "${ports[@]}" | sort -n -u
}

# ropero_port_label <port> → nombre "humano" de quien vive en ese puerto.
# Se usa como columna SLOT del status. Para puertos pineados, el nombre del
# modelo (alias si lo tiene); para los slots, "dGPU"/"CPU"; para puertos
# configurados en env que no corresponden a ningún script, "env".
ropero_port_label() {
    local port="$1"
    if [[ "$port" == "$PORT" ]]; then
        printf 'dGPU'
        return 0
    fi
    if [[ "$port" == "$CPU_PORT" ]]; then
        printf 'CPU'
        return 0
    fi
    local -a names=()
    local mk p human
    for mk in "${!MODEL_PORT[@]}"; do
        if p=$(_model_port "$mk") && [[ "$p" == "$port" ]]; then
            # Descartar la key de alias duplicada: mismo puerto, mismo
            # modelo físico. Nos quedamos con el nombre físico del script.
            [[ -n "${MODEL_ALIAS_TARGET[$mk]:-}" ]] && continue
            human="${MODEL_ALIAS[$mk]:-$mk}"
            names+=("$human")
        fi
    done
    # Puerto que alguien pidió con --port y que no corresponde a ningún .sh:
    # lo que está escuchando ahí lo dirá el status, no el nombre del modelo.
    if [[ ${#names[@]} -eq 0 ]]; then
        local f extra
        f=$(_ropero_adhoc_file)
        if [[ -f "$f" ]] && grep -qxF -- "$port" "$f" 2>/dev/null; then
            printf 'ad-hoc'
            return 0
        fi
    fi
    if [[ ${#names[@]} -gt 0 ]]; then
        printf '%s' "${names[*]}"
        return 0
    fi
    printf 'env'
}

# _collect_slots → rellena ROPERO_SLOT_ROWS con tuplas planas de 7 campos
# (slot, port, state, model, pid, uptime, engine) para TODOS los puertos
# gestionados, y ROPERO_SLOT_BUSY con cuántos están encendidos.
#
# Extracción única de propósito: antes cmd_status y _render_status_compact
# tenían cada una su propio bucle sobre "$PORT" + "${ROPERO_CPU_PORT:-9998}",
# así que cualquier puerto pineado se caía de los dos a la vez (y el render de
# alaja y el artesanal podían discrepar).
ROPERO_SLOT_ROWS=()
ROPERO_SLOT_BUSY=0
_collect_slots() {
    ROPERO_SLOT_ROWS=()
    ROPERO_SLOT_BUSY=0
    local _p _slot model pid uptime bin_name engine
    while read -r _p; do
        [[ -n "$_p" ]] || continue
        _slot=$(ropero_port_label "$_p")
        if port_listening "$_p"; then
            model=$(get_model_on_port "$_p" 2>/dev/null || echo "?")
            pid=$(get_pid_for_port "$_p")
            uptime=$(ps -p "$pid" -o etime= 2>/dev/null | tr -d ' ' || echo "?")
            bin_name=$(ps -p "$pid" -o comm= 2>/dev/null || echo "?")
            # El engine se pregunta al endpoint, no al nombre del proceso: con
            # proxy delante, el proceso es un `python3` que no dice nada (ver
            # engine_on_port). El nombre del proceso queda de respaldo.
            engine=$(engine_on_port "$_p" 2>/dev/null || true)
            if [[ -z "$engine" ]]; then
                engine=$(_engine_from_comm "$bin_name")
            fi
            engine=$(ropero_engine_label "$engine")
            ROPERO_SLOT_ROWS+=("$_slot" "$_p" "ON" "$model" "$pid" "$uptime" "$engine")
            ROPERO_SLOT_BUSY=$((ROPERO_SLOT_BUSY + 1))
        else
            ROPERO_SLOT_ROWS+=("$_slot" "$_p" "OFF" "-" "-" "-" "-")
        fi
    done < <(ropero_managed_ports)
}

# -----------------------------------------------------------------------------
# Métricas de sistema — usadas SOLO por cmd_status (cabecera de alaja).
# Devuelven "?" si la herramienta necesaria no está disponible (ej. macOS sin
# nvidia-smi, o un sistema sin lm_sensors). Pensado para que el status siga
# mostrándose aunque falte algo, sin abortar el script.
# -----------------------------------------------------------------------------
_get_cpu_ghz() {
    # Promedio de MHz activos de los cores, en GHz (2 decimales).
    # /proc/cpuinfo es lo más portable en Linux; macOS no lo tiene y caemos a "?"
    # (lscpu en Mac tampoco suele dar freq actual). Si lscpu tampoco existe,
    # "?". `|| mhz=""` necesario por set -e + pipefail (entrypoint ropero):
    # la 2ª asignación NO usa `local`, así que un pipeline que falle aborta.
    local mhz
    mhz=$(awk '/^cpu MHz/ {sum+=$4; n++} END {if (n>0) print sum/n}' /proc/cpuinfo 2>/dev/null)
    if [[ -z "$mhz" ]]; then
        mhz=$(lscpu 2>/dev/null | awk '/^CPU MHz:/ {print $3}') || mhz=""
    fi
    awk -v m="${mhz:-0}" 'BEGIN {if (m+0>0) printf "%.2f", m/1000; else print "?"}'
}

_get_ram_used_mb() {
    # RAM usada en MB. Portable Linux (free -m) + macOS (vm_stat).
    # CRÍTICO bajo `set -e + pipefail` (entrypoint ropero): cualquier
    # pipeline cuyo primer comando falle aborta el script aunque su salida
    # se capture en $(). Por eso `|| used_mb=""` y comprobamos al final.
    local used_mb=""
    if [[ "$(uname -s)" == "Darwin" ]]; then
        # macOS: vm_stat da páginas; multiplicamos por hw.pagesize. awk usa
        # $3+0 para descartar el "." que vm_stat añade a cada cifra (ej.
        # "Pages free: 12345." → gsub o sumar a 0 lo limpia).
        local page_size
        page_size=$(sysctl -n hw.pagesize 2>/dev/null) || page_size=4096
        used_mb=$(vm_stat 2>/dev/null | awk -v ps="$page_size" '
            /^Pages (free|active|inactive|speculative|wired down):/ {
                if      (/^Pages free:/)        free    += $3+0
                else if (/^Pages active:/)      active  += $3+0
                else if (/^Pages inactive:/)    inactive += $3+0
                else if (/^Pages speculative:/) spec    += $3+0
                else if (/^Pages wired down:/)  wired   += $3+0
            }
            END {
                used = (active + inactive + wired + spec) * ps
                printf "%d\n", used / 1024 / 1024
            }') || used_mb=""
    else
        used_mb=$(free -m 2>/dev/null | awk '/^Mem:/ {print $3}') || used_mb=""
    fi
    echo "${used_mb:-?}"
}

_get_cpu_temp() {
    # Temperatura CPU. Linux: lm_sensors (Package id 0 / Tdie / Tctl) o
    # sysfs thermal_zone* (miliºC → ºC). macOS no tiene ninguno → "?".
    # `set -e + pipefail` (entrypoint ropero) requiere `|| t=""` en cada
    # pipeline susceptible de fallar: el glob /sys/class/thermal/* no
    # matchea en macOS → awk abre un literal con * → rc=1 con pipefail
    # → abort. Lo mismo con sensors si está pero falla al leer.
    local t=""
    if command -v sensors >/dev/null 2>&1; then
        t=$(sensors 2>/dev/null \
            | grep -E '^(Package id 0|Tdie|Tctl):' \
            | head -1 \
            | grep -oE '[+-]?[0-9]+\.[0-9]+°C' \
            | head -1 \
            | tr -d '°C+') || t=""
    fi
    if [[ -z "$t" ]]; then
        t=$(awk '{print int($1/1000)}' /sys/class/thermal/thermal_zone*/temp 2>/dev/null \
            | sort -nr | head -1) || t=""
    fi
    echo "${t:-?}"
}

_get_gpu_ghz() {
    # Clock actual del SM de la primera GPU NVIDIA, en GHz (2 decimales).
    if ! command -v nvidia-smi >/dev/null 2>&1; then
        echo "?"
        return
    fi
    local mhz
    mhz=$(nvidia-smi --query-gpu=clocks.current.graphics \
        --format=csv,noheader,nounits 2>/dev/null | head -1)
    awk -v m="${mhz:-0}" 'BEGIN {if (m+0>0) printf "%.2f", m/1000; else print "?"}'
}

_get_vram_used_mb() {
    # VRAM usada por la primera GPU NVIDIA, en MB (nvidia-smi ya da MB).
    if ! command -v nvidia-smi >/dev/null 2>&1; then
        echo "?"
        return
    fi
    nvidia-smi --query-gpu=memory.used \
        --format=csv,noheader,nounits 2>/dev/null | head -1 || echo "?"
}

_get_gpu_temp() {
    if ! command -v nvidia-smi >/dev/null 2>&1; then
        echo "?"
        return
    fi
    nvidia-smi --query-gpu=temperature.gpu \
        --format=csv,noheader,nounits 2>/dev/null | head -1 || echo "?"
}

# -----------------------------------------------------------------------------
# Fans: lectura directa desde sysfs (hwmon del driver msi_wmi_platform).
# -----------------------------------------------------------------------------
# Por qué sysfs y no `sensors` ni `nvidia-smi`:
#   - `nvidia-smi --query-gpu=fan.speed` devuelve "[N/A]" en LAPTOPS porque
#     el control del fan lo gestiona el OEM (MSI en este caso) vía WMI/EC,
#     no el driver NVIDIA. Esto afecta a la mayoría de laptops gaming con
#     GPU NVIDIA: la query de nvidia-smi siempre falla.
#   - `sensors` (lm_sensors) parsea OK pero requiere instalar el paquete,
#     y el formato de su output cambia entre versiones.
#   - sysfs `/sys/class/hwmon/hwmonN/fanM_input` es la API universal: todos
#     los drivers de fan (nvidia, amdgpu, msi_wmi, dell_smm, thinkpad, etc.)
#     exponen los RPMs ahí si los conocen. Lectura: `cat` directo, <1ms.
#
# Convención msi_wmi_platform (verificado en este MSI):
#   fan1_input → CPU fan
#   fan2_input → GPU fan  (laptops MSI dual-fan; uno por subsistema)
#   fan3/fan4 → pueden existir pero estar a 0 (sensores auxiliares/parados).
#
# Si el hwmon no existe (ej. desktop sin msi_wmi), fallback a "?". Si el
# fan específico está a 0 (parado), también "?" — un fan parado no es
# informativo y puede confundir.
# -----------------------------------------------------------------------------

_get_msi_fan_hwmon() {
    # Devuelve el path del hwmon msi_wmi_platform (ej. /sys/.../hwmon6)
    # o vacío si no existe. Cacheamos con variable global para no escanear
    # sysfs en cada llamada (es muy lento sin cache: ~50ms en algunos sistemas).
    if [[ -n "${_ROPERO_FAN_HWMON:-}" ]]; then
        [[ -d "$_ROPERO_FAN_HWMON" ]] && echo "$_ROPERO_FAN_HWMON"
        return
    fi
    local p
    for p in /sys/class/hwmon/hwmon*/name; do
        if [[ -f "$p" ]] && grep -qx 'msi_wmi_platform' "$p" 2>/dev/null; then
            _ROPERO_FAN_HWMON="$(dirname "$p")"
            echo "$_ROPERO_FAN_HWMON"
            return
        fi
    done
    _ROPERO_FAN_HWMON=""
    echo ""
}

_get_cpu_fan_rpm() {
    # CPU fan RPM. Prioriza sysfs (milisegundo); fallback a `sensors`
    # si el hwmon msi_wmi no está disponible.
    local hwmon
    hwmon=$(_get_msi_fan_hwmon)
    if [[ -n "$hwmon" && -r "$hwmon/fan1_input" ]]; then
        local rpm
        rpm=$(cat "$hwmon/fan1_input" 2>/dev/null)
        if [[ -n "$rpm" && "$rpm" -gt 0 ]]; then
            echo "$rpm"
            return
        fi
        echo "?"
        return
    fi
    # Fallback: lm_sensors (puede leer CPU fan desde otra fuente hwmon).
    if ! command -v sensors >/dev/null 2>&1; then
        echo "?"
        return
    fi
    local rpm
    rpm=$(sensors 2>/dev/null \
        | awk '/^fan[0-9]+:/ {
            for (i=1;i<=NF;i++) if ($i=="RPM") {
                v=$(i-1); gsub(/[^0-9]/,"",v);
                if (v+0>0) { print v; exit }
            }
        }')
    echo "${rpm:-?}"
}

_get_gpu_fan_rpm() {
    # GPU fan RPM. Lee fan2_input del mismo hwmon msi_wmi (convención de
    # fan2 = GPU en laptops MSI dual-fan). Si no existe o está a 0, "?".
    #
    # NOTA: NO usamos nvidia-smi aquí. En laptops, el driver NVIDIA no
    # controla el fan (lo hace el EC del OEM) y siempre devuelve "[N/A]".
    # Verificado en esta RTX 5080 laptop: nvidia-smi fan.speed → [N/A],
    # mientras sysfs → 4324 RPM real.
    local hwmon
    hwmon=$(_get_msi_fan_hwmon)
    if [[ -n "$hwmon" && -r "$hwmon/fan2_input" ]]; then
        local rpm
        rpm=$(cat "$hwmon/fan2_input" 2>/dev/null)
        if [[ -n "$rpm" && "$rpm" -gt 0 ]]; then
            echo "$rpm"
            return
        fi
    fi
    echo "?"
}

# -----------------------------------------------------------------------------
# Render artesanal del status (versión COMPACTA).
# -----------------------------------------------------------------------------
# Pensado para iterar el diseño ANTES de replicarlo con `alaja action`
# (cuando el comando alaja action esté listo). NO usa alaja: solo echo /
# printf / ANSI para que:
#   - se pueda probar al instante sin recompilar nada,
#   - las decisiones de diseño (anchos de columna, colores, jerarquía) sean
#     explícitas y revisables a simple vista,
#   - el output sea 100% portable a cualquier terminal / ssh.
#
# CUANDO `alaja action` madure, esta función será la REFERENCIA del layout
# a replicar: mismas columnas, mismos colores (mapeados a themes), misma
# jerarquía cabecera → sistema → slots.
#
# Convenciones de padding:
#   - Los códigos ANSI van SIEMPRE fuera del campo %-Ns para no romper
#     el cálculo de ancho (printf no strippea escapes).
#   - Las columnas se dimensionan para el caso típico; nombres de modelo
#     largos (>20 chars) se truncan con elipsis para no romper la tabla.
# -----------------------------------------------------------------------------
_render_status_compact() {
    local cpu_ghz ram_mb cpu_temp cpu_fan gpu_ghz vram_mb gpu_temp gpu_fan
    cpu_ghz=$(_get_cpu_ghz);    ram_mb=$(_get_ram_used_mb)
    cpu_temp=$(_get_cpu_temp);  cpu_fan=$(_get_cpu_fan_rpm)
    gpu_ghz=$(_get_gpu_ghz);    vram_mb=$(_get_vram_used_mb)
    gpu_temp=$(_get_gpu_temp);  gpu_fan=$(_get_gpu_fan_rpm)

    # Estado de TODOS los puertos gestionados (los dos slots por defecto +
    # los pineados por los scripts vía MODEL_PORT). Extracción compartida con
    # cmd_status: una sola fuente para los dos renders.
    _collect_slots

    # ── Cabecera ──────────────────────────────────────────────────────────
    printf "${BOLD}${CYAN_B}─── ROPERO STATUS ───${NC}  ${DIM}%s${NC}\n" "$(date +%H:%M:%S)"
    echo

    # ── Sistema (resumen en 2 líneas) ─────────────────────────────────────
    # Temperatura en amarillo para que llame la atención (es lo que más
    # miramos). GHz en bold para jerarquía.
    printf "  ${CYAN_B}CPU${NC}  ${BOLD}%s GHz${NC} · %s MB · ${YELLOW}%s°C${NC} · fan %s RPM\n" \
        "$cpu_ghz" "$ram_mb" "$cpu_temp" "$cpu_fan"
    printf "  ${GRN_B}GPU${NC}  ${BOLD}%s GHz${NC} · %s MB · ${YELLOW}%s°C${NC} · fan %s RPM\n" \
        "$gpu_ghz" "$vram_mb" "$gpu_temp" "$gpu_fan"
    echo

    # ── Puertos (tabla padded) ────────────────────────────────────────────
    # Cabecera + separador dim. Anchos: SLOT=9, PUERTO=6, ESTADO=6,
    # MODELO=22 (con elipsis si >22), PID=7, UPTIME=8, ENGINE=15.
    # SLOT lleva el dueño del puerto: "dGPU"/"CPU" para los slots por defecto,
    # el nombre del modelo para los puertos pineados (MODEL_PORT).
    printf "  ${YEL_B}%-9s %-6s %-6s %-22s %-7s %-8s %-15s${NC}\n" \
        "SLOT" "PORT" "ESTADO" "MODELO" "PID" "UPTIME" "ENGINE"
    printf "  ${DIM}%-9s %-6s %-6s %-22s %-7s %-8s %-15s${NC}\n" \
        "─────────" "──────" "──────" "──────────────────────" "───────" "────────" "───────────────"

    # Filas
    local i=0
    while (( i < ${#ROPERO_SLOT_ROWS[@]} )); do
        local slot="${ROPERO_SLOT_ROWS[$((i+0))]}"
        local port="${ROPERO_SLOT_ROWS[$((i+1))]}"
        local state="${ROPERO_SLOT_ROWS[$((i+2))]}"
        local model="${ROPERO_SLOT_ROWS[$((i+3))]}"
        local pid="${ROPERO_SLOT_ROWS[$((i+4))]}"
        local uptime="${ROPERO_SLOT_ROWS[$((i+5))]}"
        local engine="${ROPERO_SLOT_ROWS[$((i+6))]}"

        # Truncar slot/modelo largos (preservan ancho de columna)
        if (( ${#slot} > 9 )); then
            slot="${slot:0:6}..."
        fi
        if (( ${#model} > 22 )); then
            model="${model:0:19}..."
        fi

        # Estado coloreado. Color FUERA del campo %-Ns para que el pad no
        # cuente bytes ANSI.
        if [[ "$state" == "ON" ]]; then
            printf "  %-9s %-6s ${GRN_B}%-6s${NC} %-22s %-7s %-8s %-15s\n" \
                "$slot" "$port" "$state" "$model" "$pid" "$uptime" "$engine"
        else
            printf "  ${DIM}%-9s %-6s %-6s %-22s %-7s %-8s %-15s${NC}\n" \
                "$slot" "$port" "$state" "$model" "$pid" "$uptime" "$engine"
        fi
        i=$((i+7))
    done
}

# -----------------------------------------------------------------------------
# Comandos
# -----------------------------------------------------------------------------

# _port_legend → listado "puerto → dueño" para `ropero help`. Se genera desde
# la misma lista que usa status/stop, para que nunca se desincronicen.
_port_legend() {
    local _p
    while read -r _p; do
        if [[ -n "$_p" ]]; then
            printf '  %-7s %s\n' ":$_p" "$(ropero_port_label "$_p")"
        fi
    done < <(ropero_managed_ports)
}

# -----------------------------------------------------------------------------
# Uso y error de uso.
#
# A nivel de archivo, no anidados en el comando que los usa, por el mismo
# motivo que _kill_port: una función definida dentro de otra no existe hasta
# que esa se ha ejecutado.
#
# Por qué hace falta: hasta ahora los subcomandos aceptaban CUALQUIER cosa
# detrás y la tiraban a la basura sin decir nada. `ropero --install models`
# ejecutaba el install entero —compilando llama.cpp si hacía falta— porque
# cmd_install nunca miraba "$@". Un typo, o un argumento de alguien que se
#antasyaba otra cosa, se-convirtió en media hora de compilación sin aviso. Un
# CLI que descarta lo que le pasan no es un CLI: es unalotería. Ahora todo lo
# que no se reconoce falla, y falla ANTES de tocar nada.
# -----------------------------------------------------------------------------
_ropero_usage() {
    case "${1:-}" in
        install)   printf 'USO: ropero --install [all|models|engines|link] [--force]\n' ;;
        check)     printf 'USO: ropero --check\n' ;;
        list)      printf 'USO: ropero list\n' ;;
        templates) printf 'USO: ropero templates\n' ;;
        stop)      printf 'USO: ropero stop <modelo>|all\n' ;;
        models)    printf 'USO: ropero models\n' ;;
        status)    printf 'USO: ropero status [--craft] [--watch [ms]]\n' ;;
        # Sin subcomando: la línea del modelo. Es lo que devuelven los typos de
        # flag, y ropero help para el resto.
        *)         printf 'USO: ropero <modelo> [--background] [--cpu] [--force] [--port N]\n' ;;
    esac
}

# _ropero_usage_error <subcomando> <mensaje> → error a stderr y exit 2.
#
# exit 2 y no 1 a propósito: 2 es "error de uso" en la convención estándar de
# Unix, 1 es "el comando se ejecutó y falló". Un wrapper necesita poder
# distinguir `ropero noexiste` de `ropero --install` roto a medio.
#
# Se imprime la línea de uso de ESE comando y no el help entero: el help son
# 200 líneas, y cuando ya sabes qué has tipeado mal, lo que quieres es la
# línea que te dice qué escribir.
_ropero_usage_error() {
    echo "ERROR: $2" >&2
    _ropero_usage "${1:-}" >&2
    echo "  (ropero help → uso completo)" >&2
    exit 2
}

cmd_list() {
    if [[ $# -gt 0 ]]; then
        _ropero_usage_error list "list no acepta argumentos (recibido: '$1')"
    fi
    echo "Modelos disponibles:"
    for m in "${MODEL_NAMES[@]}"; do
        local engine="${MODEL_ENGINE[$m]:-llama-server}"
        local alias="${MODEL_ALIAS[$m]:-$m}"
        # Puerto: el pineado (MODEL_PORT) si el modelo lo declara; si no,
        # "slot :$PORT / :$CPU_PORT" según se invoque con o sin --cpu.
        local port_desc _p
        if _p=$(_model_port "$m"); then
            port_desc="port :$_p (fijado)"
        else
            port_desc="slot :$PORT / :$CPU_PORT"
        fi
        if [[ "$engine" == "llama-server" ]]; then
            printf "  %-12s %-21s ctx=%-10s engine=%-14s gguf=%s\n" \
                "$alias" "$port_desc" "${MODEL_CTX[$m]}" "$engine" "${MODEL_GGUF[$m]}"
        else
            # Para los engines con servidor propio, lo útil ver de un vistazo
            # es el formato del checkpoint: un .safetensors no se puede meter
            # en un trtllm-serve y un GGUF tampoco, y el error que sale de ahí
            # ("no se encontró ningún archivo de pesos") no lo dice.
            local fmt="${MODEL_FORMAT[$m]:-dir}"
            local auth="proxy"
            if ropero_engine_auth_native "$engine"; then auth="api-key"; fi
            printf "  %-12s %-21s ctx=%-10s engine=%-14s [%s/%s] path=%s\n" \
                "$alias" "$port_desc" "${MODEL_CTX[$m]}" "$engine" \
                "$fmt" "$auth" "${MODEL_PATH[$m]:-N/A}"
        fi
    done
}

# -----------------------------------------------------------------------------
# ropero_templates → lista las plantillas de modelo disponibles en ropero.d/.
# -----------------------------------------------------------------------------
cmd_templates() {
    if [[ $# -gt 0 ]]; then
        _ropero_usage_error templates "templates no acepta argumentos (recibido: '$1')"
    fi
    local f bn count=0
    printf 'Plantillas en %s/ — copia una a ropero.d/<nombre>.sh (SIN el prefijo 30-) y edítala:\n\n' "$MODULES_DIR"
    for f in "$MODULES_DIR"/30-template-*.sh; do
        [[ -f "$f" ]] || continue
        bn="$(basename "$f" .sh)"
        count=$((count + 1))
        # MODEL_ENGINE va en el .sh (una sola vez), el título en la cabecera.
        local eng title
        eng="$(sed -n 's/^MODEL_ENGINE="\([^"]*\)".*/\1/p' "$f" | head -1)"
        eng="${eng:-?}"
        title="$(grep -m1 '^# PLANTILLA' "$f" | sed 's/^# PLANTILLA[[:space:]]*:[[:space:]]*//')"
        printf '  %-30s engine=%-14s %s\n' "$bn" "$eng" "$title"
    done
    if (( count == 0 )); then
        printf '  (ninguna)\n'
    fi
    printf '\nLas plantillas NO se cargan como modelos (el loader salta *-template-*),\n'
    printf 'así que no aparecen en `ropero list` ni se pueden arrancar por su nombre.\n'
    printf 'Al copiar: renombra la función get_engine_args_* al nombre del nuevo\n'
    printf 'fichero (guiones bajos), y chmod +x.\n'
}

cmd_status() {
    # Flags locales:
    #   --craft        fuerza el render artesanal (_render_status_compact) en
    #                  vez de delegar en alaja. Útil para iterar el layout
    #                  antes de replicarlo con `alaja action`.
    #   --watch [ms]   refresco continuo cada N ms (default 1000). Delega en
    #                  cmd_status_watch (que fuerza el render artesanal: alaja
    #                  no soporta bien bordes selectivos/colores de fila, y es
    #                  más lento — incompatible con un loop de refresh).
    #                  Acepta `--watch` solo o `--watch 500`.
    local force_craft=0
    local watch_ms=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --craft)
                force_craft=1
                shift
                ;;
            --watch)
                shift
                # El argumento de --watch es OPCIONAL y numérico. Si el
                # siguiente token es otro flag (ej. --craft) o no existe,
                # default 1000. Si existe pero NO es número → error claro.
                if [[ $# -gt 0 && "$1" =~ ^[0-9]+$ ]]; then
                    watch_ms="$1"
                    shift
                elif [[ $# -gt 0 && "$1" == --* ]]; then
                    # siguiente es flag, no valor de --watch → default
                    watch_ms=1000
                elif [[ $# -gt 0 ]]; then
                    _ropero_usage_error status "--watch requiere milisegundos (entero positivo), recibido: $1"
                else
                    watch_ms=1000
                fi
                cmd_status_watch "$watch_ms"
                return $?
                ;;
            *)
                # El mismo helper que el resto de la CLI, y por el mismo
                # motivo: `status --badopt` decía "Opción desconocida" sin la
                # palabra ERROR y con otro código de salida que el resto de
                # comandos, así que un wrapper no podía contarlo como error de
                # uso. Ahora todos los comandos fallan igual.
                _ropero_usage_error status "opción desconocida: '$1'"
                ;;
        esac
    done

    # Estado de TODOS los puertos gestionados (los dos slots por defecto +
    # los pineados por MODEL_PORT). Extracción compartida con el render
    # artesanal, así alaja y --craft no pueden discrepar.
    _collect_slots

    # El CSV de filas y las métricas de sistema solo hacen falta para el
    # render de alaja: si vamos al artesanal, las calcula él mismo (y así no
    # pagamos dos veces los ~10 forks de nvidia-smi/free/sensors).
    #
    # ── Decisión de render ─────────────────────────────────────────────────
    # Prioridad: --craft > alaja disponible y funcional > fallback artesanal.
    # El fallback artesanal (_render_status_compact) es ahora el MISMO layout
    # que se va a replicar con alaja, así que el diseño queda coherente
    # aunque alaja no esté instalado (SSH sin TUI, etc.).
    #
    # ¿Por qué el chequeo de salida vacía? Porque `alaja` puede estar PRESENTE
    # y ser inútil: un release a medio compilar deja un binario de 0 bytes, que
    # sale con 0 y no imprime nada. Con el `|| true` de antes, `ropero status`
    # se quedaba mudo sin decir nada — mientras `ropero status --watch` (que
    # fuerza el render artesanal) sí enseñaba la tabla. Bug real, no teórico.
    # Ahora: si alaja no dice absolutamente nada, caemos al artesanal.
    local _rendered=0
    if (( force_craft == 0 )) && command -v alaja >/dev/null 2>&1; then
        # Métricas de sistema para los separators. Si una herramienta falta
        # (nvidia-smi en Mac, sensors sin instalar...) el helper devuelve "?"
        # y el status sigue mostrándose.
        local cpu_ghz ram_mb cpu_temp cpu_fan gpu_ghz vram_mb gpu_temp gpu_fan
        cpu_ghz=$(_get_cpu_ghz)
        ram_mb=$(_get_ram_used_mb)
        cpu_temp=$(_get_cpu_temp)
        cpu_fan=$(_get_cpu_fan_rpm)
        gpu_ghz=$(_get_gpu_ghz)
        vram_mb=$(_get_vram_used_mb)
        gpu_temp=$(_get_gpu_temp)
        gpu_fan=$(_get_gpu_fan_rpm)

        # Empaquetar las filas como CSV para inyectar como args del comando
        # table de alaja. En bash (sin jq) porque los valores son simples:
        # números, palabras y "?". bin_name puede traer guiones pero no comillas.
        local _rows_csv="" i=0
        while (( i < ${#ROPERO_SLOT_ROWS[@]} )); do
            local _slot="${ROPERO_SLOT_ROWS[$((i+0))]}"
            local _p="${ROPERO_SLOT_ROWS[$((i+1))]}"
            local _state="${ROPERO_SLOT_ROWS[$((i+2))]}"
            local _model="${ROPERO_SLOT_ROWS[$((i+3))]}"
            local _pid="${ROPERO_SLOT_ROWS[$((i+4))]}"
            local _uptime="${ROPERO_SLOT_ROWS[$((i+5))]}"
            local _engine="${ROPERO_SLOT_ROWS[$((i+6))]}"
            local _bin="$_engine"
            if [[ "$_state" == "ON" ]]; then
                _bin=$(ps -p "$_pid" -o comm= 2>/dev/null | tr -d ' ' || echo "?")
            fi
            [[ -n "$_rows_csv" ]] && _rows_csv+=","
            _rows_csv+="\"--rows\",\"$_state;:$_p ($_slot);$_model;$_pid;$_uptime;$_bin;$_engine\""
            i=$((i+7))
        done

        local _data _out
        _data=$(printf '{"actions":[
            {"order": "3", "command":"separator","args":["--text","CPU: %s GHz · %s MB · %s°C · fan %s RPM","--color","theme:gradient_1"]},
            {"order": "2", "command":"separator","args":["--text","GPU: %s GHz · %s MB · %s°C · fan %s RPM","--color","theme:gradient_3"]},
            {"order": "1", "command":"table","args":["--border","rounded","---border-color","hex:#ffca00","--headers","Slot;Puerto;Estado;Modelo;PID;Uptime;bin;engine"%s]}
        ]}' \
            "$cpu_ghz" "$ram_mb" "$cpu_temp" "$cpu_fan" \
            "$gpu_ghz" "$vram_mb" "$gpu_temp" "$gpu_fan" \
            "${_rows_csv:+,$_rows_csv}")
        _out=$(alaja action --data "$_data" 2>&1 || true)
        if [[ -n "${_out//[[:space:]]/}" ]]; then
            printf '%s\n' "$_out"
            _rendered=1
        fi
    fi
    if (( _rendered == 0 )); then
        # Render artesanal (mismo layout que se replicará con alaja). Lo
        # usa también --craft para iterar el diseño sin alaja de por medio.
        _render_status_compact
    fi
    return $(( ROPERO_SLOT_BUSY == 0 ? 1 : 0 ))
}

cmd_status_watch() {
    # Refresco continuo del status. --craft IMPLÍCITO: usa siempre el render
    # artesanal (alaja no soporta bien bordes selectivos/colores de fila, y
    # en un loop es más lento y menos predecible).
    #
    # Implementación: delegamos en `watch(1)` (procps-ng). Es código C,
    # robusto, estándar en Linux, y maneja correctamente:
    #   - clear entre ejecuciones (sin parpadeo)
    #   - Ctrl+C (sale limpio, restaura terminal)
    #   - decimales en el intervalo (`-n` acepta floats)
    # Reescribir esto en bash sería reinventar la rueda con bugs.
    #
    # Overhead: 1 fork+exec por intervalo. Con `--watch 1000` (1s) es
    # despreciable; con `--watch 200` es ~5 forks/s, aún aceptable (cada
    # ropero --craft tarda ~50-150ms por los forks internos de sensors,
    # nvidia-smi, free, lsof — el fork externo es marginal).
    #
    # Validación:
    #   - Entero positivo obligatorio. 0 o negativo → busy-loop mortal.
    #   - < 100 ms avisamos: el render mide ~50-200 ms según el sistema,
    #     con ms<100 el intervalo nunca llega y `watch` avisa "sh: sleep
    #     interrupted".
    local ms="${1:-1000}"

    if ! [[ "$ms" =~ ^[0-9]+$ ]] || (( ms <= 0 )); then
        echo "ERROR: --watch requiere milisegundos (entero positivo), recibido: $ms" >&2
        return 2
    fi
    if (( ms < 100 )); then
        echo "AVISO: --watch con ms<100 puede no dejar respirar al render (~50-200ms)." >&2
        echo "       Si ves refresco errático, sube a ms>=200." >&2
    fi
    if ! command -v watch >/dev/null 2>&1; then
        echo "ERROR: 'watch' (procps-ng) no está instalado. Paquetes:" >&2
        echo "  - Cachy/Arch: pacman -S procps-ng" >&2
        echo "  - Debian/Ubuntu: apt install procps" >&2
        echo "  - macOS: brew install watch" >&2
        return 3
    fi

    # watch -n toma segundos (con decimales). 1000 ms → 1.000 s.
    local sec
    sec=$(awk -v ms="$ms" 'BEGIN { printf "%.3f", ms/1000 }')

    # Opciones:
    #   -n SEC  intervalo (acepta decimales: 0.2, 0.5, 1, 2.5…)
    #   -c      interpretar secuencias ANSI (preserva los colores del render)
    #   -t      no mostrar la cabecera "Every Xs: …" (no la queremos encima)
    #   -x      pasar el comando a exec en vez de sh -c (necesario si el
    #           comando tiene redirecciones/comillas raras; aquí no hace
    #           falta, pero es más seguro y rápido — un fork menos)
    exec watch -n "$sec" -c -t -x -- "${ROPERO_BIN:-$0}" status --craft
}

cmd_stop() {
    # Parseo ANTES de tocar ningún puerto. `ropero stop` acepta como mucho un
    # argumento, y ese es el nombre del modelo (o "all"). Antes main le pasaba
    # solo "${1:-all}", así que `ropero stop embed --force` recorría los puertos
    # buscando un modelo llamado "embed" y descartaba el --force sin pestañear:
    # el usuario veía "Modelo 'embed' no encontrado" cuando lo que había pasado
    # es que el nombre estaba mal escrito. Ahora el --force es un error de uso
    # claro, que es lo que es.
    if [[ $# -gt 1 ]]; then
        _ropero_usage_error stop "stop acepta como mucho un argumento (modelo o 'all'); recibidos $#: $*"
    fi
    local target="${1:-all}"
    if [[ "$target" == -* ]]; then
        _ropero_usage_error stop "stop no tiene opciones; '$target' no es un modelo (usa 'stop all')"
    fi

    # Nombre desconocido → typo casi seguro. Se comprueba contra MODEL_NAMES
    # (que ya contiene tanto los scripts físicos como sus alias públicos, así
    # que cubre los dos casos) y no contra lo que hay escuchando: stop compara
    # el nombre que ropero publica en /v1/models, y ese nombre solo puede ser
    # el de un modelo cargado. Sin esto, `ropero stop quezqui` se comportaba
    # como un acierto hasta el final y luego decía "no encontrado en ningún
    # puerto gestionado", que es un diagnóstico de runtime para lo que es un
    # typo de teclado.
    if [[ "$target" != "all" ]]; then
        local _k="${target//-/_}"
        if [[ ! " ${MODEL_NAMES[*]} " =~ " $_k " ]]; then
            _ropero_usage_error stop "modelo desconocido: '$target' (mira 'ropero list')"
        fi
    fi

    # _kill_port y _engine_human están a nivel de archivo (ver más arriba), no
    # aquí dentro: --force, en start_model, también necesita apagarlos, y una
    # función definida dentro de otra no existe hasta que esa se ha ejecutado.

    if [[ "$target" == "all" ]]; then
        # Mata en TODOS los puertos gestionados: :9999 (dGPU), :9998 (CPU), los
        # pineados por MODEL_PORT y los ad-hoc de --port. Si están vacíos, no
        # falla — solo imprime que no había nada. IMPORTANTE: por puerto, no
        # por nombre de proceso (no usar pkill -f global: mataría los slots
        # paralelos).
        local _stopped=0 _p
        while read -r _p; do
            [[ -n "$_p" ]] || continue
            local _eng
            _eng=$(_engine_human "$_p" 2>/dev/null || echo "?")
            if _stop_port "$_p"; then
                _stopped=$((_stopped+1))
                echo "  ✓ :$_p detenido ($_eng)"
            fi
        done < <(ropero_managed_ports)
        if (( _stopped == 0 )); then
            echo "Nada que detener (ningún puerto gestionado activo)"
        else
            echo "Detenidos $_stopped slot(s)"
        fi
        return 0
    fi

    # Stop <modelo>: buscar en qué puerto está ese modelo y matar SOLO ese.
    # Itera todos los puertos gestionados, no solo los dos slots: un modelo
    # pineado con MODEL_PORT, o lanzado con --port, podría estar en :9990/:9995
    # y nos lo saltaríamos.
    local _p
    while read -r _p; do
        [[ -n "$_p" ]] || continue
        if port_listening "$_p"; then
            local current
            current=$(get_model_on_port "$_p" 2>/dev/null || echo "")
            if [[ "$current" == "$target" ]]; then
                local _eng
                _eng=$(_engine_human "$_p" 2>/dev/null || echo "?")
                _stop_port "$_p"
                echo "Modelo '$target' ($_eng) detenido en :$_p"
                return 0
            fi
        fi
    done < <(ropero_managed_ports)

    local _ports_human
    _ports_human=$(ropero_managed_ports | paste -sd ' ' -)
    echo "✗ Modelo '$target' no encontrado en ningún puerto gestionado ($_ports_human)" >&2
    local _activos
    _activos=$(ropero status 2>&1 | grep -E '\bON\b' | sed 's/^[[:space:]]*//' | paste -sd '|' - || true)
    if [[ -n "$_activos" ]]; then
        echo "  Activos ahora: ${_activos}" >&2
    else
        echo "  Activos ahora: ninguno" >&2
    fi
    return 1
}

cmd_help() {
    cat <<EOF
${BLUE}ropero${NC} — lanzador simplificado de LLM engines

USO:
  ropero <modelo> [--background] [--cpu] [--force] [--port N]
  ropero list | status [--craft] [--watch [ms]] | stop <modelo>|all | help
  ropero templates
  ropero models
  ropero --install [all|models|engines|link] [--force] | ropero --check

ENGINES:
  llama-server    llama.cpp sobre GGUF. Metal en macOS, CUDA en cachy. El único
                  con --cpu (mapea a --n-gpu-layers 0 + --threads N).
  airllm          Carga por capas desde disco: modelos que no caben en VRAM.
                  El server es ropero.d/_airllm_server.py, porque airllm es
                  librería pura y no trae ninguno. SÍ valida la API key.
  mlx_lm          Modelos MLX en Apple Silicon. macOS.
  tensorrt-llm    Engines de TensorRT-LLM en NVIDIA. cachy/arch, RTX.
  fastflowlm      AMD Ryzen AI NPU (XDNA). Solo cachy/arch CON NPU. El engine
                  que descarga CPU y GPU: útil para el modelo pequeño en
                  paralelo con el grande en la GPU.

  Todos hablan OpenAI-compatible y todos se publican en el MISMO puerto con la
  MISMA API_KEY, para que opencode.jsonc no tenga que saber qué hay detrás.
  Como mlx_lm, tensorrt-llm y fastflowlm NO validan la API key (está verificado
  en el CLI de cada uno), ropero les pone delante _authproxy.py, que sí la
  exige. El engine real escucha solo en 127.0.0.1, en un puerto interno FIJO por
  engine (10992 mlx_lm, 11999 airllm, 12999 tensorrt-llm, 13999 fastflowlm).
  Nada de eso se ve desde fuera.

PUERTOS:
$(_port_legend)
  Por defecto hay 2 slots: $PORT = dGPU y $CPU_PORT = CPU (--cpu).
  Un modelo puede pinear uno propio con MODEL_PORT en su .sh de ropero.d/;
  entonces usa ESE puerto siempre, con o sin --cpu. Eso es lo que permite
  tener más de 2 modelos vivos a la vez. Se ve en \`ropero list\` y en
  \`ropero status\`, que listan todos los puertos configurados (encendidos o no).

MODELOS:
$(for m in "${MODEL_NAMES[@]}"; do echo "  ${MODEL_ALIAS[$m]:-$m}"; done)

OPCIONES:
  --background  lanzar en segundo plano (log en $LOG_DIR)
  --cpu         arrancar sin GPU (offload CPU completo, todos los cores). Usa el
                slot CPU :$CPU_PORT, salvo que el modelo tenga MODEL_PORT fijado
                o se pase --port, en cuyo caso se respeta ese puerto.
                SOLO llama-server: es el único con esa palanca. En airllm,
                mlx_lm, tensorrt-llm y fastflowlm da error explicándolo, en vez
                de ignorarse y dejarte pensando que tienes la CPU.
  --port N      arrancar en el puerto N, saltándose MODEL_PORT y los slots.
                Puntual: no edita el .sh, así que el siguiente arranque del
                modelo vuelve a su puerto de siempre. Ej: \`ropero embed --port 9995\`
                Combina con --cpu (puerto libre, pero sin GPU).
  --force       si el puerto destino está ocupado por OTRO modelo, matarlo y
                arrancar el solicitado. Solo afecta a ese puerto (no toca los
                demás). Pensado para uso interactivo; en automatización
                prefiere \`ropero stop X && ropero Y\` para ser explícito.
  --craft       (status) forzar el render artesanal (echo/printf/ANSI) en
                lugar de delegar en alaja. Útil para iterar el layout del
                status antes de replicarlo con \`alaja action\`. Si alaja no
                está instalado —o está roto y no imprime nada— se usa el
                render artesanal igualmente.
  --watch [ms]  (status) refresco continuo del status cada N ms (default 1000).
                Acepta valor opcional: \`ropero status --watch\` o
                \`ropero status --watch 500\`. Usa SIEMPRE el render
                artesanal (alaja no soporta bien bordes selectivos/colores
                de fila, y es más lento — incompatible con un loop).
                Ctrl+C para salir.

SUBCOMANDOS:
  templates    lista las plantillas de modelo de ropero.d/30-template-*.sh
               (airllm, mlx, tensorrt-llm, fastflowlm). Cada una documenta
               qué debe tener el modelo (arquitectura y formato exactos) y qué
               flags usarla para exprimir el hardware. Copia la que quieras,
               renómbrala SIN el prefijo 30- y ya es un modelo de ropero.
               No se cargan como modelos: el loader salta *-template-*.
  models      descarga solo los modelos por defecto (los GGUF de llama.cpp, y
              en macOS también el checkpoint MLX de metaloss). Idempotente: lo
              que ya está, se salta. Es exactamente el paso 3 del install, y
              existe aparte porque es lo que se quiere cuando el stack ya está
              hecho y lo que falta es disco: pedir \`--install models\` (con sus
              paquetes y sus engines por delante) para bajar 50 GB es una forma
              de que nadie los baje.
  --install [all|models|engines|link] [<engine|modelo>] [--force]
              target (defecto: all):
                all      engines + modelos — el comportamiento de siempre
                engines  solo paquetes del sistema y engines; ni un byte de pesos
                models   solo los modelos (igual que \`ropero models\`)
                link     solo rehacer los symlinks de lo ya instalado y
                         verificar. No instala NADA. Es para cuando los
                         binarios están pero ~/.local/bin se ha quedado vacío.

              SIN nombre, preguntando uno a uno:
                --install engines   instala engines + paquetes del sistema.
                                    Cada uno pregunta antes de instalar; si ya
                                    está, pregunta si se reinstala o si se borra
                                    el proyecto y se recompila. Los ejecutables
                                    se enlazan en ~/.local/bin al terminar.
                                    airllm NO se enlaza: es una librería de
                                    Python, no un binario.
                --install models    descarga el catálogo, saltando lo que ya
                                    está (se detecta por CONTENIDO: pesos +
                                    config.json, no por un marcador).

              CON nombre, sin preguntar — para manifests y scripts:
                --install engines llama|mlx|airllm|tensorrt|flm|all
                                    instala solo ese engine, sin preguntar.
                --install models <modelo>
                                    instala solo ese modelo. Admite el alias o
                                    el script de \`ropero list\` (qwen, coder_lite,
                                    fable…) o el nombre del .gguf. Si el nombre
                                    no existe, se imprime el catálogo completo.

              Los engines que son plataforma-dependientes no se descargan en
              Linux, donde no sirven de nada.

              --force no pregunta NADA (equivale a AUTO_YES=1) Y borra lo que
              ya está para volver a bajarlo/compilarlo. Antes sólo callaba la
              pregunta: el "ya descargado" cortaba antes, así que pedir --force
              no hacía nada, en silencio.
              Ojo: --force NO autoriza borrados destructivos que no pediste
              (las preguntas de "borro ~/llama.cpp" siguen respondiendo "no").
  --check     verifica la instalación (enlaces, modelos, engines, sus
              dependencias reales) sin tocar nada. Exit 1 si algo falta.

NOTAS:
  - Overrides por modelo (sin editar .sh): ROPERO_<MODELO>_CTX, _NGL, _TEMP,
    _PORT, etc. (el nombre del modelo se normaliza: guiones → guiones bajos)
    ej: ROPERO_MULTIMODAL_ANALYZER_CTX=32768 ropero multimodal-analyzer
         ROPERO_EMBED_PORT=9991 ropero embed
  - Con engine propio, un script de modelo puede declarar
    get_engine_args_<nombre>() para añadir flags al comando del server.
    Ej: \`printf '%s\\n' --draft-model ... --num-draft-tokens 4\`.
  - ROPERO_NO_AUTH_PROXY=1 arranca un engine sin proxy, SIN API key y en
    \$HOST. Solo tiene sentido con HOST=127.0.0.1. Avisa.
  - ROPERO_START_TIMEOUT (def. 180s) y ROPERO_ENGINE_WAIT (def. 20s) ajustan
    las esperas de arranque. Los engines con NPU y los que cargan por capas son
    mucho más lentos que llama-server.
EOF
}

# -----------------------------------------------------------------------------
# Lanzamiento de modelo
# -----------------------------------------------------------------------------
start_model() {
    local model="$1"
    local background="$2"
    local cpu_only="${3:-0}"
    local force="${4:-0}"
    local port_override="${5:-}"

    # Normalizar nombre del modelo (guiones a guiones underscores) para buscar en arrays
    local model_key="${model//-/_}"

    if [[ ! " ${MODEL_NAMES[*]} " =~ " $model_key " ]]; then
        echo "Modelo desconocido: $model" >&2
        cmd_list >&2
        return 1
    fi

    # Resolución de alias público: si el usuario invocó el alias (e.g. `coder`)
    # y el loader registró una redirección a un script físico (e.g. devstral),
    # trabajar contra el físico. Mantener el nombre "humano" para mensajes.
    local public_alias_used=""
    if [[ -n "${MODEL_ALIAS_TARGET[$model_key]:-}" ]]; then
        public_alias_used="$model"
        model_key="${MODEL_ALIAS_TARGET[$model_key]}"
        model="$model_key"
    fi

    local engine="${MODEL_ENGINE[$model_key]:-llama-server}"
    local port="$PORT"

    # Selección de puerto, por orden de precedencia:
    #   1. --port N              → gana TODO (es lo que estás pidiendo AHORA).
    #   2. MODEL_PORT del script → si no hay --port.
    #   3. --cpu                 → $CPU_PORT (offload CPU).
    #   4. resto                 → $PORT (dGPU).
    #
    # Tiene que resolverse AQUÍ, antes del check de "puerto ocupado" de más
    # abajo: si se calculara después, el check miraría 9999 mientras el
    # servidor nace en 9990 (bug previo con --cpu, commit 2b00b5c).
    #
    # MODEL_PORT gana sobre --cpu a propósito: quien escribe el .sh ha dicho
    # "este modelo vive AQUÍ". --cpu sigue significando offload a CPU (los
    # flags --n-gpu-layers 0 / --threads N se añaden igualmente más abajo);
    # lo que --cpu ya no puede es mover el modelo de puerto.
    #
    # Y --port gana sobre MODEL_PORT porque es una orden explícita de quien
    # escribe, en ese momento, con el contexto que tiene. El .sh no se toca:
    # la siguiente vez que lances ese modelo sin --port, vuelve a su puerto
    # de siempre.
    local pinned_port=""
    local port_reason="slot por defecto"
    if [[ -n "$port_override" ]]; then
        if ! _ropero_valid_port "$port_override"; then
            echo "ERROR: --port $port_override no es un puerto válido (1-65535)" >&2
            return 1
        fi
        port="$port_override"
        port_reason="forzado con --port"
        # Registrar el puerto para que `status` y `stop` lo vean: son otros
        # procesos y no pueden saberlo solos.
        _ropero_adhoc_add "$port_override"
    elif pinned_port=$(_model_port "$model_key"); then
        port="$pinned_port"
        port_reason="puerto fijado por MODEL_PORT"
    elif (( cpu_only == 1 )) && [[ "$engine" == "llama-server" ]]; then
        port="$CPU_PORT"
        port_reason="slot CPU (--cpu)"
    fi

    # --cpu sólo tiene sentido en llama-server, y no por pereza sino porque es
    # el único con esa palanca: --cpu mapea a --n-gpu-layers 0 + --threads N,
    # flags que son de llama-server. En los demás engines "apagar la GPU" no
    # es un flag, es elegir el backend (device= en airllm, y en mlx_lm/trtllm/
    # flm ni existe la opción). Ignorarlo en silencio dejaría al usuario
    # pensando que tiene la CPU y con la GPU delante; así que se dice.
    if (( cpu_only == 1 )) && [[ "$engine" != "llama-server" ]]; then
        echo "ERROR: --cpu solo funciona con engine=llama-server." >&2
        echo "       Este modelo usa '$engine', que no tiene offload a CPU por flag." >&2
        echo "       Para airllm, el device se elige en el propio script del modelo" >&2
        echo "       (get_engine_args_<model>). Para los demás, no hay equivalente." >&2
        return 1
    fi

    # Preflight ANTES de tocar el puerto: validar que el arranque puede
    # tener éxito (GGUF + args del módulo). No matar lo que corre por un
    # lanzamiento condenado (p.ej. mmproj ausente → antes dejaba :9999
    # vacío y a ttstt sin servidor).
    local -a pre_model_args=()
    local pre_gguf_path=""
    case "$engine" in
        "llama-server")
            pre_gguf_path="$GGUF_DIR/${MODEL_GGUF[$model_key]}"
            if [[ ! -f "$pre_gguf_path" ]]; then
                echo "Archivo GGUF no encontrado: $pre_gguf_path" >&2
                return 1
            fi
            local pre_out pre_status=0
            pre_out=$(get_model_args_"${model_key}" 2>&1) || pre_status=$?
            if (( pre_status != 0 )); then
                echo "ERROR: get_model_args_${model_key} falló:" >&2
                echo "$pre_out" >&2
                return 1
            fi
            if [[ -n "$pre_out" ]]; then
                mapfile -t pre_model_args <<<"$pre_out"
            fi
            ;;
        "airllm"|"tensorrt-llm"|"mlx_lm")
            if [[ ! -d "${MODEL_PATH[$model_key]}" ]]; then
                echo "Directorio de modelo no encontrado: ${MODEL_PATH[$model_key]}" >&2
                # Si el script del modelo sabe cómo se descarga, que lo diga.
                # Fallar con "no encontrado" y nada más obliga a ir a leer el
                # .sh, y el comando de descarga está justo ahí arriba.
                local _dl="${MODEL_DL[$model_key]:-}"
                if [[ -n "$_dl" ]]; then
                    echo "       Para conseguirlo:" >&2
                    printf '         %s\n' "${_dl}" >&2
                fi
                return 1
            fi
            # Que el directorio exista NO basta: que el server esté instalado sí.
            # Sin esta comprobación, `ropero gptoss-120b` en una máquina donde
            # mlx_lm no está se lanza, falla al instante con un error de
            # "command not found" dentro de un pipe a colorize, y el usuario no
            # ve qué falta. El binario se comprueba AQUÍ, antes de tocar el
            # puerto de destino: matar el modelo que hubiera en :9999 y luego
            # descubrir que el engine no existe sería el peor orden posible.
            if ! ropero_engine_resolve "$engine" >/dev/null 2>&1; then
                ropero_err "engine '$engine' no instalado (falta su binario de servidor)"
                case "$engine" in
                    airllm)       ropero_info "  ropero --install   (o revisa ropero --check)" ;;
                    mlx_lm)       ropero_info "  pip install mlx-lm  ·  ropero --install" ;;
                    tensorrt-llm) ropero_info "  ropero --install   (crea ~/.venv-tensorrt)" ;;
                    fastflowlm)   ropero_info "  ropero --install   (necesita AMD NPU: driver amdxdna + xrt)" ;;
                esac
                return 1
            fi
            ;;
        "fastflowlm")
            # FLM no recibe una ruta: recibe un TAG ("llama3.2:1b") y lo busca
            # en su propio almacén. Por eso el chequeo de "-d" de los otros
            # engines no aplica: 9999 no es un directorio.
            local flm_root flm_dir
            flm_root="${FLM_MODEL_PATH:-$HOME/.config/flm}"
            flm_dir="$flm_root/models/${MODEL_PATH[$model_key]}"
            if [[ ! -d "$flm_dir" ]]; then
                # Puede estar en subdirectorios (el tag trae '/'), que es lo
                # que hace flm con los nombres de tipo "hf.co/org/model:tag".
                flm_dir="$flm_root/models/$(dirname "${MODEL_PATH[$model_key]}")/$(basename "${MODEL_PATH[$model_key]}")"
            fi
            if [[ ! -d "$flm_dir" ]]; then
                echo "ERROR: el modelo '${MODEL_PATH[$model_key]}' no está en el almacén de FLM." >&2
                echo "       Buscado en: $flm_dir" >&2
                echo "       Descárgalo con: flm pull ${MODEL_PATH[$model_key]}" >&2
                echo "       Modelos disponibles: flm list" >&2
                return 1
            fi
            if ! ropero_engine_resolve "$engine" >/dev/null 2>&1; then
                ropero_err "engine 'fastflowlm' no instalado (falta 'flm')"
                ropero_info "  ropero --install   (solo en cachy/arch con NPU AMD)"
                return 1
            fi
            ;;
    esac

    if port_listening "$port"; then
        local current
        current=$(get_model_on_port "$port" 2>/dev/null || echo "")
        if [[ "$current" == "$model" ]]; then
            echo "Modelo '$model' ya está corriendo en :$port"
            return 0
        fi
        # Puerto destino ocupado por OTRO modelo. Default: NO matar
        # automáticamente. El usuario decide con `ropero stop <modelo>` o
        # con `--force` (uso interactivo; pensado para que un humano en
        # terminal pueda rotar modelos sin encadenar 2 comandos). Solo
        # afecta al slot destino: el otro slot (si hay modelo) sigue
        # intacto. Si ya hay un --cpu cargado y quieres rearmar la GPU,
        # --force SOLO mata la GPU.
        if (( force == 1 )); then
            local pid
            pid=$(get_pid_for_port "$port")
            if [[ -n "$pid" ]]; then
                echo "⚠  --force: matando '$current' ($(_engine_human "$port" 2>/dev/null || echo '?')) en :$port (pid $pid)"
                # _kill_port y no `kill -9`: el occupant puede ser un proxy con
                # un engine detrás, y SIGKILL no deja que el proxy apague a su
                # hijo. Con `kill -9` directo, rotar de modelo con --force
                # dejaba el engine anterior sirviendo en su puerto interno
                # (:10xxx), invisible para `ropero status` y para `ropero stop`.
                _kill_port "$port"
                # Pequeña espera para que el puerto se libere (lsof ve TIME_WAIT)
                local _wait=0
                while (( _wait < 5 )) && port_listening "$port"; do
                    sleep 1
                    (( _wait++ ))
                done
                if port_listening "$port"; then
                    echo "✗ No se pudo liberar :$port tras matar '$current'" >&2
                    return 1
                fi
            fi
        else
            echo "✗ Puerto :$port ocupado por '$current'" >&2
            echo "  ropero NO mata automáticamente. Para liberar el puerto:" >&2
            echo "    ropero stop $current" >&2
            echo "  O usa --force para rotar interactivamente (mata solo este slot)." >&2
            return 1
        fi
    fi

    local ctx_size="${MODEL_CTX[$model_key]}"
    local ctx_env="ROPERO_$(echo "$model_key" | tr '[:lower:]' '[:upper:]')_CTX"
    ctx_size="${!ctx_env:-$ctx_size}"

    case "$engine" in
        "llama-server")
            local gguf_path="$pre_gguf_path"

            export ROPERO_CTX="$ctx_size"

            local -a model_args=("${pre_model_args[@]}")

            # ----------------------------------------------------------------
            # Selección de device: macOS = Metal; Cachy = CUDA0 (RTX) o CPU.
            # Si --cpu: el override de args (--n-gpu-layers 0 --threads N) se
            # aplica al FINAL del cmd array (ver más abajo) para GANAR sobre
            # los args del modelo (e.g. --threads 12 de qwenvision.sh). Si se
            # añadiera a model_args aquí, quedaría ANTES de los args del modelo
            # y llama-server usaría el último occurrence del modelo.
            # Si no --cpu en Cachy: CUDA0 (la RTX 5080) por defecto; no hace
            # falta flag extra (llama-server auto-detecta CUDA).
            #
            # NOTA: el puerto se resolvió ANTES del check de "puerto ocupado"
            # (justo después de detectar engine), no aquí. Bug previo.
            # ----------------------------------------------------------------
            if (( cpu_only != 1 )); then
                local _os
                _os=$(ropero_detect_os 2>/dev/null || echo unknown)
                case "$_os" in
                    macos)
                        # Metal: los flags óptimos los añade el módulo del
                        # modelo y/o la compilación (ver ropero.d/20-compile-llama.sh).
                        :
                        ;;
                    cachy|arch)
                        # CUDA0: device 0 (la RTX 5080) por defecto.
                        if [[ "${MODEL_GPU[$model_key]:-CUDA0}" == "CUDA0" ]]; then
                            :
                        fi
                        ;;
                esac
            fi

            local -a cmd=(
                "$LLAMA_BIN"
                --model "$gguf_path"
                --host "$HOST"
                --port "$port"
                --api-key "$LLAMA_API_KEY"
                --alias "$model"
                --ctx-size "$ctx_size"
                -fa on
                --log-verbosity 3
                "${model_args[@]}"
            )

            # Override --cpu al FINAL del cmd para ganar sobre args del modelo.
            # Ojo: --cpu mueve el DISPOSITIVO, no el puerto. Si el modelo tiene
            # MODEL_PORT, se queda en su puerto y solo se apaga la GPU.
            if (( cpu_only == 1 )); then
                local _nproc
                _nproc=$(command -v nproc >/dev/null && nproc || echo 8)
                cmd+=("--n-gpu-layers" 0)
                cmd+=("--threads" "$_nproc")
            fi

            alaja separator "Arrancando $model en :$port (bin: $LLAMA_BIN, ctx: $ctx_size, $port_reason)" --color
            if (( background == 0 )); then
                "${cmd[@]}" 2>&1 | colorize "$model"
                return $?
            else
                local logfile="$LOG_DIR/ropero-${model}-${port}.log"
                nohup "${cmd[@]}" >>"$logfile" 2>&1 &
                local pid=$!
                disown "$pid" 2>/dev/null || true
                echo "Modelo $model lanzado en background (pid $pid). Log: $logfile"
                # Un VL de ~11 GB en frío tarda >60s en cargar; el chequeo
                # antiguo (6s) lo daba por muerto y rompía a ttstt.
                local wait_secs="${ROPERO_START_TIMEOUT:-180}" elapsed=0
                while (( elapsed < wait_secs )); do
                    if port_listening "$port"; then
                        local got
                        got=$(get_model_on_port "$port" 2>/dev/null || true)
                        if [[ -n "$got" ]]; then
                            echo "✓ $model responde en :$port (alias: $got)"
                            return 0
                        fi
                    fi
                    sleep 2
                    (( elapsed += 2 ))
                done
                echo "⚠  '$model' no responde tras ${wait_secs}s; revisa el log." >&2
                return 1
            fi
            ;;

        "airllm"|"tensorrt-llm"|"mlx_lm"|"fastflowlm")
            ropero_launch_engine "$model" "$model_key" "$engine" "$ctx_size" \
                                 "$port" "$port_reason" "$background"
            return $?
            ;;
    esac
}

# -----------------------------------------------------------------------------
# ropero_launch_engine <model> <model_key> <engine> <ctx> <port> <why> <background>
#
# Lanza un engine con servidor propio (airllm / mlx_lm / tensorrt-llm /
# fastflowlm) respetando EXACTAMENTE el mismo contrato público que llama-server,
# para que todo lo de arriba — --background, --port, --force, MODEL_PORT,
# `ropero stop`, `ropero status` — no tenga que saber qué hay detrás.
#
# ── La pieza que hace posible ese "exactamente igual": el proxy de auth ───────
#
# ropero promete que todos los engines hablan con el mismo LLAMA_API_KEY, la
# misma IP y el mismo puerto. Eso solo es cierto si el engine valida la key:
#
#   llama-server  sí (--api-key)          → directo a $HOST:$port
#   airllm        sí (nuestro _airllm_server.py trae --api-key) → directo
#   mlx_lm        NO tiene ese flag
#   trtllm-serve  NO tiene ese flag
#   flm serve     la doc dice "the key is not checked"
#
# Para los tres últimos se pone _authproxy.py delante:
#
#     opencode ──► :9992 (proxy, exige la key) ──127.0.0.1:10992──► mlx_lm.server
#
# El proxy es el padre del engine, así que `ropero stop` — que mata lo que
# escucha en el puerto — mata el proxy, que a su vez mata a su hijo y libera el
# puerto interno. Y el proxy responde /v1/models con el nombre del modelo de
# ropero, que es lo que hace que `ropero stop <modelo>` y la columna MODELO del
# status funcionen sin ningún caso especial por engine.
#
# Y como anuncia ese nombre, tiene que poder cumplirlo: si el engine sólo acepta
# uno (mlx_lm sólo acepta "default_model" y trata el resto como repo_id de HF),
# el proxy reescribe el campo "model" del body. Sin eso, /v1/models prometería un
# id que el engine de detrás rechaza. Ver ropero_engine_pinned_model.
#
# Sin el proxy, con HOST=0.0.0.0, esos tres quedarían SIN AUTH en la LAN. Por
# eso es el default; ROPERO_NO_AUTH_PROXY=1 lo desactiva, y avisa.
# -----------------------------------------------------------------------------
ropero_launch_engine() {
    local model="$1" model_key="$2" engine="$3" ctx="$4"
    local port="$5" why="$6" background="${7:-0}"
    local model_path="${MODEL_PATH[$model_key]}"

    # Flags extra del modelo: get_engine_args_<model>, un argumento por línea.
    # Es el equivalente de get_model_args_<model> para los engines con server.
    local -a extra=()
    local fn="get_engine_args_${model_key}"
    if declare -f "$fn" >/dev/null 2>&1; then
        local out st=0 err err_f
        err_f="$(mktemp "${TMPDIR:-/tmp}/ropero_engargs.XXXXXX")"
        # stderr va a un fichero aparte, NO a `out`. Con `2>&1` cualquier
        # warning de la función acababa en el array de ARGUMENTOS del engine,
        # y el server moría con "no such option: [i]". Una línea de diagnóstico
        # pasaba a formar parte del comando entero. Los scripts de modelo avisan
        # por stderr (el guard de RAM de metaloss.sh, por ejemplo), así que esto
        # no es teórico: es la diferencia entre un aviso y un arranque roto.
        out=$("$fn" 2>"$err_f") || st=$?
        err=$(cat "$err_f" 2>/dev/null || true)
        rm -f "$err_f" 2>/dev/null || true
        if [[ -n "$err" ]]; then
            printf '%s\n' "$err" >&2
        fi
        if (( st != 0 )); then
            ropero_err "$fn devolvió error (rc=$st); no se arranca:"
            return 1
        fi
        if [[ -n "$out" ]]; then
            mapfile -t extra <<<"$out"
        fi
    fi

    local use_proxy=1
    if ropero_engine_auth_native "$engine"; then
        use_proxy=0
    elif [[ "${ROPERO_NO_AUTH_PROXY:-0}" == "1" ]]; then
        use_proxy=0
        ropero_warn "ROPERO_NO_AUTH_PROXY=1: $engine arranca SIN API key en $HOST:$port."
        ropero_warn "  Cualquiera de la red puede usarlo. Sin proxy solo es"
        ropero_warn "  razonable si HOST=127.0.0.1."
    fi

    local engine_host="$HOST" engine_port="$port"
    local -a proxy_cmd=()

    if (( use_proxy == 1 )); then
        # El engine NUNCA se expone. Escucha en loopback, en un puerto FIJO por
        # engine (10992 mlx_lm, 11999 airllm, 12999 tensorrt-llm, 13999
        # fastflowlm) que NO depende del puerto público. Ver
        # ropero_engine_internal_port en ropero.d/_engines.sh para el porqué de
        # que sea por engine y no "puerto + 1000".
        if ! engine_port=$(ropero_engine_internal_port "$engine" "$port"); then
            ropero_err "no hay puerto interno libre para '$engine' (base + 0..49)"
            return 1
        fi
        engine_host="127.0.0.1"
    fi

    # ── argv del engine ────────────────────────────────────────────────────
    local -a eng_out=()
    mapfile -t eng_out < <(ropero_engine_cmd "$engine" "$model_path" "$model" \
                              "$engine_host" "$engine_port" "$ctx")
    if (( ${#eng_out[@]} == 0 )); then
        ropero_err "no se pudo construir el comando de '$engine' (resuelve '$model_key')"
        return 1
    fi
    local -a cmd=("${eng_out[@]}" "${extra[@]}")

    # ── env del engine ─────────────────────────────────────────────────────
    local -a eng_env=()
    mapfile -t eng_env < <(ropero_engine_env "$engine")
    local kv
    for kv in "${eng_env[@]}"; do
        if [[ -n "$kv" ]]; then export "${kv?}"; fi
    done

    local bin_label
    bin_label="$(printf '%s' "${cmd[0]##*/}")"

    # ── caso CON proxy: el proxy es el proceso que oye en el puerto de ropero ─
    if (( use_proxy == 1 )); then
        local py argv_file pid_file
        if ! py=$(ropero_python_bin); then
            ropero_err "hace falta python3 para el proxy de auth de '$engine'"
            return 1
        fi
        # El argv del engine va en un fichero, un argumento por línea: pasar un
        # array por línea de comandos con --chat-template-args '{"a":1}' o rutas
        # con espacios es pedir que algo se desmonte en el quoting.
        argv_file="${TMPDIR:-/tmp}/.ropero_eng_$$_${port}"
        pid_file="${TMPDIR:-/tmp}/.ropero_eng_$$_${port}.pid"
        : >"$argv_file"
        local a
        for a in "${cmd[@]}"; do printf '%s\n' "$a" >>"$argv_file"; done

        # El proxy hereda el env del engine: se lo pasamos por variable para que
        # no haya que exportarlo en dos sitios distintos.
        if (( ${#eng_env[@]} > 0 )); then
            export ROPERO_ENGINE_ENV
            ROPERO_ENGINE_ENV="$(printf '%s\n' "${eng_env[@]}")"
        fi

        proxy_cmd=(
            "$py" "$MODULES_DIR/_authproxy.py"
            --host "$HOST"
            --port "$port"
            --target-host "$engine_host"
            --target-port "$engine_port"
            --api-key "$LLAMA_API_KEY"
            --model-id "$model"
            --engine "$engine"
            --engine-cmd-file "$argv_file"
            --pid-file "$pid_file"
            --wait "${ROPERO_ENGINE_WAIT:-20}"
        )
        # Nombre de modelo que el engine EXIGE. vacío = el engine enruta por el
        # que le pasa ropero y no hay que tocar el body. Ver
        # ropero_engine_pinned_model: hoy es sólo mlx_lm, que sólo acepta
        # "default_model" y trata cualquier otro nombre como un repo_id de HF.
        local pinned_model
        pinned_model=$(ropero_engine_pinned_model "$engine" || true)
        if [[ -n "$pinned_model" ]]; then
            proxy_cmd+=(--rewrite-model "$pinned_model")
        fi
        # Lo que se ejecuta es el proxy, no el engine.
        cmd=("${proxy_cmd[@]}")
        bin_label="_authproxy.py -> $bin_label"
        ropero_info "  $engine no valida la API key: proxy en :$port, engine en $engine_host:$engine_port"
        if [[ -n "$pinned_model" ]]; then
            ropero_info "  $engine sólo acepta '$pinned_model' como nombre de modelo: el proxy lo reescribe"
        fi
    fi

    alaja separator "Arrancando $model en :$port (engine: $engine, ctx: $ctx, $why)" --color

    if (( background == 0 )); then
        "${cmd[@]}" 2>&1 | colorize "$model"
        return $?
    fi

    local logfile="$LOG_DIR/ropero-${model}-${port}.log"
    mkdir -p "$LOG_DIR" 2>/dev/null || true
    nohup "${cmd[@]}" >>"$logfile" 2>&1 &
    local pid=$!
    disown "$pid" 2>/dev/null || true
    echo "Modelo $model lanzado en background (pid $pid). Log: $logfile"
    if (( use_proxy == 1 )); then
        echo "  proxy :$port → engine $engine en $engine_host:$engine_port (el proxy lo apaga)"
    fi

    # Espera activa. Se mira el puerto Y /v1/models, porque un puerto abierto no
    # significa modelo servido: sin el segundo check, `ropero status` mostraría
    # un modelo "?" durante los minutos que tarda en cargar.
    local wait_secs="${ROPERO_START_TIMEOUT:-180}" elapsed=0
    while (( elapsed < wait_secs )); do
        if port_listening "$port"; then
            local got
            got=$(get_model_on_port "$port" 2>/dev/null || true)
            if [[ -n "$got" ]]; then
                rm -f "${argv_file:-}" 2>/dev/null || true
                echo "✓ $model responde en :$port (alias: $got)"
                return 0
            fi
        fi
        # Si el proceso raíz ya no está, esperar hasta los 180s no va a
        # arreglar nada: ha fallado el arranque. Se sale ya y se enseña el log,
        # que es donde está el motivo.
        if ! kill -0 "$pid" 2>/dev/null; then
            echo "✗ '$model' ($bin_label) se ha salido durante el arranque." >&2
            echo "  Últimas líneas del log ($logfile):" >&2
            tail -n 15 "$logfile" 2>/dev/null | sed 's/^/    /' >&2 || true
            rm -f "${argv_file:-}" 2>/dev/null || true
            return 1
        fi
        sleep 2
        (( elapsed += 2 ))
    done
    echo "⚠  '$model' no responde tras ${wait_secs}s; revisa el log." >&2
    echo "  model:  tail -f $logfile" >&2
    echo "  engine: ss -ltnp | grep $engine_port   (puerto interno)" >&2
    return 1
}

# -----------------------------------------------------------------------------
# --install autónomo e idempotente (spec migración + Cambios por proyecto)
# 0. symlinks del propio ropero (entrypoint + ropero.d), siempre.
# 1. paquetes (cachy/paru, macos/brew; termux: nada)
# 2. engines, uno a uno y en este orden, cada uno con su propio linkeado al
#    terminar (ver ropero_install_*):
#      llama.cpp   → todos los OS salvo termux. Flags CMAKE EXACTOS del spec.
#      airllm      → todos los OS salvo termux.
#      tensorrt-llm → solo cachy/arch.   mlx-lm → solo macos.
# 3. modelos via download con check individual (omitir si existen).
#
# NO hay un paso final de "enlazar todos los backends": ver ropero_link_*.
# -----------------------------------------------------------------------------
_ropero_nproc() { nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4; }

# -----------------------------------------------------------------------------
# Symlinks: uno por engine, ejecutados al terminar la instalación de ESE engine.
# -----------------------------------------------------------------------------
# Nada de "al final del install, enlázalo todo". El fallo era ese: instalar (o
# saltarse) un engine no tenía relación con qué symlinks aparecían, porque al
# final se recorría una lista de TODOS los backends. Consecuencias: instalar
# solo llama.cpp tocaba también los ejecutables de tensorrt, y si esa carpeta
# resultaba ser un venv, se linkeaba entera — metiendo su `python3` en
# ~/.local/bin por delante del shim de asdf para todo el sistema.
#
# Ahora la regla es 1:1 — quien instala, linkea. Si quieres tocar solo los
# enlaces de un engine, se reejecuta solo la fase de ese engine.
#
# ── Por qué hace falta enlazar ────────────────────────────────────────────────
# ropero no es el único binario que acaba en ~/.local/bin. Si los ejecutables
# de un backend no están ahí, solo se alcanzan por la ruta larga completa, o
# —peor— a través de un shim de asdf que se rompe cuando se reinstala el
# Python que los instaló. Que es lo que pasaba con mlx_lm: su ejecutable real
# vive en ~/.asdf/installs/python/3.11.0/bin/ y el único enlace en el PATH
# era el shim.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# _ropero_link_dir <nombre> <dir> [prefijo]
# Núcleo compartido por los engines con binarios en un directorio fijo.
# Enlaza en $BIN_DIR todo lo ejecutable de <dir> que empiece por <prefijo>
# (prefijo vacío = todos). Idempotente.
# -----------------------------------------------------------------------------
_ropero_link_dir() {
    local name="$1" dir="$2" prefix="${3:-}"
    if [[ ! -d "$dir" ]]; then
        ropero_info "  · $name: nada que enlazar ($dir no existe)"
        return 0
    fi

    local b exe link other linked=0 shadowed="" failed="" pending=""
    for b in "$dir"/*; do
        [[ -e "$b" ]] || continue
        exe="$(basename "$b")"

        # ── Filtros, en este orden ────────────────────────────────────────
        # 1. El prefijo. Es lo que impide que un venv se linkee entero: solo
        #    pasan los `trtllm-*`. Vacío (llama.cpp) = todos, que es lo
        #    correcto: build/bin es un directorio de herramientas compiladas,
        #    no un entorno de Python.
        if [[ -n "$prefix" && "$exe" != "$prefix"* ]]; then
            continue
        fi
        # 2. Scripts de activación de venv, que no son programas. Red de
        #    seguridad para cuando alguien meta un venv con prefijo vacío:
        #    `activate` y compañía nunca deben salir a $BIN_DIR.
        case "$exe" in
            activate|activate.*|Activate.ps1|deactivate.*|activate_this.py) continue ;;
        esac

        # Sin +x: no terminó de linkearse, o es un directorio. Un build en
        # curso deja ficheros de 0 bytes sin permiso de ejecución; si nos
        # pillan a mitad, mejor avisar que fingir que no existen.
        if [[ ! -x "$b" || -d "$b" ]]; then
            if [[ -f "$b" && ! -x "$b" ]]; then
                pending="$pending $exe"
            fi
            continue
        fi
        link="$BIN_DIR/$exe"

        # Si el mismo nombre ya resuelve a OTRO binario en el PATH, al enlazar
        # el nuestro lo vamos a tapar. No siempre es un problema (casi siempre
        # es lo que se quiere: que gane el que gestiona ropero), pero puede ser
        # un downgrade sin que nadie se entere. Se comprueba ANTES y se avisa
        # después, con las dos versiones.
        #
        # El `|| true` NO es decorativo: `command -v` sale con 1 cuando el
        # binario NO está en el PATH, que es justo el caso normal la primera
        # vez que se linkea (es lo que estamos haciendo aquí). Sin él, el
        # `set -e` del entrypoint abortaba en el primer ejecutable, y como no
        # había tubería ni `||` que lo absorbiera, `ropero --install` moría en
        # silencio sin linkear NADA: compilaba bien y luego no aparecía ni
        # `llama-server` en $BIN_DIR.
        other=$(command -v "$exe" 2>/dev/null || true)
        if [[ -n "$other" && "$other" != "$link" ]]; then
            shadowed="$shadowed $exe"
        fi

        # `ln -sfn` falla si el destino es un symlink colgado, y aquí es el
        # caso normal: el destino apunta a un binario que se ha recompilado.
        # Se borra antes.
        if [[ -L "$link" ]]; then rm -f "$link"; fi
        # Nunca pisar un fichero real que no sea nuestro symlink.
        if [[ -e "$link" && ! -L "$link" ]]; then
            failed="$failed $exe (ya hay un fichero real)"
            continue
        fi
        if ln -sfn "$b" "$link" 2>/dev/null; then
            linked=$((linked + 1))
        else
            # Antes el error se comía con 2>/dev/null + &&: un enlace fallido se
            # contaba como si no hubiera pasado y nadie se enteraba.
            failed="$failed $exe"
        fi
    done

    if [[ -n "$pending" ]]; then
        ropero_warn "  ! $name: aún no ejecutables (build en curso?):$pending"
    fi
    if [[ -n "$failed" ]]; then
        ropero_err "  ✗ $name: no se pudieron enlazar:$failed"
    fi
    if [[ -n "$shadowed" ]]; then
        ropero_warn "  ! $name tapa estos binarios que ya estaban en el PATH:$shadowed"
        ropero_info "    Ahora gana el de ropero. Si el otro era más nuevo,"
        ropero_info "    quítalo del PATH o quítale el symlink a mano."
    fi

    if (( linked > 0 )); then
        ropero_ok "  → $name: $linked ejecutables en $BIN_DIR"
    else
        ropero_info "  · $name: nada que enlazar en $dir"
    fi
    return 0
}

# -----------------------------------------------------------------------------
# _ropero_python_script_dirs — directorios de console scripts de TODOS los
# Pythons que podrían haber instalado un paquete: el activo y los de asdf.
# Que se instale con uno y se ejecute con otro es la norma, no la excepción.
# -----------------------------------------------------------------------------
_ropero_python_script_dirs() {
    local -a dirs=()
    local py d base

    # OJO: sin `test && hacer` como última cosa de una iteración. ropero corre
    # con `set -e`: con esa forma, si el test falla la iteración devuelve 1 y
    # el script ABORTA en silencio. Por eso aquí todo es un `if` explícito.

    # 1. Python activo
    if command -v python3 >/dev/null 2>&1; then
        d=$(python3 -c 'import sysconfig;print(sysconfig.get_path("scripts"))' 2>/dev/null || true)
        if [[ -n "$d" && -d "$d" ]]; then dirs+=("$d"); fi
        d=$(python3 -c 'import sysconfig;print(sysconfig.get_path("scripts","posix_user"))' 2>/dev/null || true)
        if [[ -n "$d" && -d "$d" ]]; then dirs+=("$d"); fi
    fi

    # 2. Todos los Pythons de asdf: el script pudo quedar en otro.
    #
    # Ni `python*` ni `python3*` valen como filtro: en el mismo directorio
    # están `python-config` y `python3-config`, que no son intérpretes y no
    # responden a `-c`. Bajo `set -e` eso abortaba el enlace en silencio.
    # Se valida el NOMBRE: un intérprete es `python3` o `python3.N`.
    for py in "$HOME"/.asdf/installs/python/*/bin/python3*; do
        base="$(basename "$py")"
        if ! [[ "$base" =~ ^python3(\.[0-9]+)?$ ]]; then continue; fi
        if [[ ! -x "$py" ]]; then continue; fi
        d=$("$py" -c 'import sysconfig;print(sysconfig.get_path("scripts"))' 2>/dev/null || true)
        if [[ -n "$d" && -d "$d" ]]; then dirs+=("$d"); fi
    done

    # 3. Deduplicar: el Python activo y el de asdf suelen ser el mismo.
    local -a uniq=()
    for d in "${dirs[@]}"; do
        local seen=0 x
        for x in "${uniq[@]}"; do
            if [[ "$x" == "$d" ]]; then seen=1; break; fi
        done
        if (( seen == 0 )); then uniq+=("$d"); fi
    done

    printf '%s\n' "${uniq[@]}"
}

# -----------------------------------------------------------------------------
# _ropero_link_python <nombre> <console script> [<console script> ...]
# Enlaza console scripts de Python por nombre exacto. Al revés que
# _ropero_link_dir: aquí NO se enlaza "lo que haya", se enlaza lo que se pide.
# Un paquete de Python trae dependencias que se instalan como ejecutables
# (ninja, hf, wheel…); si se linkeara el directorio entero, esos ganarian al
# resto del sistema. Buscar por nombre hace imposible ese fallo.
# -----------------------------------------------------------------------------
_ropero_link_python() {
    local name="$1"; shift
    local d exe target linked=0

    while read -r d; do
        if [[ -z "$d" ]]; then continue; fi
        for exe in "$@"; do
            if [[ ! -x "$d/$exe" ]]; then continue; fi
            target="$BIN_DIR/$exe"
            # Si ya está (o hay algo ahí), no se toca: puede ser un symlink
            # previo, y no es asunto de ropero decidir cuál gana.
            if [[ -e "$target" || -L "$target" ]]; then continue; fi
            if ln -sfn "$d/$exe" "$target" 2>/dev/null; then
                linked=$((linked + 1))
                ropero_ok "  → $exe → $d/$exe"
            fi
        done
    done < <(_ropero_python_script_dirs)

    if (( linked == 0 )); then
        ropero_info "  · $name: no instalados, o ya alcanzables en el PATH"
    fi
    return 0
}

# -----------------------------------------------------------------------------
# Linkeados por engine. Cada uno existe solo, y lo llama únicamente la fase de
# instalación de su engine.
# -----------------------------------------------------------------------------

# ropero_link_self — el entrypoint y su ropero.d. No es un engine: se hace
# siempre, al principio del install, para que ropero quede utilizable desde el
# principio aunque el usuario decline todos los engines.
ropero_link_self() {
    mkdir -p "$BIN_DIR" 2>/dev/null || true
    ln -sfn "$SCRIPT_DIR/ropero" "$BIN_DIR/ropero" 2>/dev/null || true
    ropero_ok "  → $BIN_DIR/ropero"
    if [[ -d "$SCRIPT_DIR/ropero.d" ]]; then
        ln -sfn "$SCRIPT_DIR/ropero.d" "$BIN_DIR/ropero.d" 2>/dev/null || true
        ropero_ok "  → $BIN_DIR/ropero.d"
    fi
    return 0
}

# ropero_link_llamacpp — todos los ejecutables de build/bin.
#
# Sin prefijo: build/bin es un directorio de herramientas compiladas, no un
# entorno de Python. Sus 23 binarios (llama-server, llama-cli, llama-bench…)
# son justo lo que tiene que quedar alcanzable.
ropero_link_llamacpp() {
    _ropero_link_dir "llama.cpp" "$LLAMA_DIR/build/bin" ""
}

# ropero_link_tensorrt — SOLO los trtllm-*.
#
# $HOME/.venv-tensorrt/bin es un VENV. Dentro hay 69 ejecutables, pero solo 7
# son de tensorrt; los otros 62 son activadores y scripts de Python que el venv
# trae de paso, incluidos `python`/`python3`/`pydoc.bat`. Linkear el venv
# entero en ~/.local/bin mete su python POR DELANTE del shim de asdf en el
# PATH de todo el sistema: a partir de ahí, cualquier `python3` ejecuta el
# venv de tensorrt. Se probó y se revirtió a mano (62 enlaces borrados); el
# prefijo es lo que impide que el install vuelva a hacerlo.
ropero_link_tensorrt() {
    _ropero_link_dir "tensorrt-llm" "$HOME/.venv-tensorrt/bin" "trtllm-"
}

# ropero_link_airllm — el server de airllm, que airllm NO trae.
#
# airllm 2.11.0 no registra ningún entry point (su dist-info no tiene
# entry_points.txt): no hay `airllm`, ni `airllm-server`, ni `airllm-generate`.
# El código anterior pedía esos tres nombres, no encontraba ninguno y no
# linkeaba nada — sin avisar, porque "0 enlazados" se imprimía como info y el
# install seguía como si nada. Además, `python -m airllm serve` tampoco existe:
# el paquete es una librería pura, sin `__main__.py`.
#
# El server lo aporta ropero.d/_airllm_server.py: un servidor OpenAI-compatible
# sobre AutoModel.from_pretrained, con la API key de ropero y el mismo
# contrato de /v1/models que llama-server. Se linkea aquí como cualquier otro
# ejecutable, y ropero_link_dir se encarga de refrescarlo si el fichero cambia.
ropero_link_airllm() {
    local src="$MODULES_DIR/_airllm_server.py"
    if [[ ! -f "$src" ]]; then
        ropero_err "  ✗ airllm: falta $src"
        return 1
    fi
    # +x: sin permiso de ejecución no es un symlink válido a un programa.
    [[ -x "$src" ]] || chmod +x "$src" 2>/dev/null || true
    mkdir -p "$BIN_DIR" 2>/dev/null || true
    if [[ -L "$BIN_DIR/airllm-server" ]]; then rm -f "$BIN_DIR/airllm-server"; fi
    if [[ -e "$BIN_DIR/airllm-server" && ! -L "$BIN_DIR/airllm-server" ]]; then
        ropero_warn "  ! airllm: $BIN_DIR/airllm-server ya es un fichero real, no lo toco"
        return 0
    fi
    if ln -sfn "$src" "$BIN_DIR/airllm-server" 2>/dev/null; then
        ropero_ok "  → airllm-server → $src"
    else
        ropero_err "  ✗ airllm: no se pudo enlazar airllm-server en $BIN_DIR"
    fi

    # Y el health check de la librería, que es lo que de verdad decide si airllm
    # sirve para algo. "Instalado" y "utilizable" no son lo mismo: se comprobó
    # que airllm 2.11.0 con transformers 5.x es inimportable.
    local py
    if py=$(ropero_python_bin) && "$py" -c 'import airllm' >/dev/null 2>&1; then
        ropero_ok "  airllm importable"
    else
        ropero_warn "  ! airllm no es importable con este Python."
        ropero_warn "    El server arranca igual (airllm-server), pero SIN offload"
        ropero_warn "    capa a capa: será lento y la GPU casi no se usará."
        ropero_warn "    Causa habitual: airllm 2.11.0 importa LlamaForCausalLM del"
        ropero_warn "    nivel superior de transformers, que ya no está en 5.x."
        ropero_warn "    Arreglo: pip install 'transformers<5'"
    fi
    return 0
}

# ropero_link_mlx — console scripts de mlx-lm por nombre exacto.
#
# La lista se ha ampliado con `mlx_lm.server`, que es el que ropero usa para
# arrancar y el que faltaba: el install|linkaba mlx_lm, mlx_lm.generate y
# mlx_lm.chat, pero NO el server. El resultado era que `ropero <modelo-mlx>`
# sólo encontraba mlx_lm.server a través del shim de asdf — justo el shim que se
# rompe al reinstalar el Python, y exactamente lo que este mismo entrypoint
# denuncia al principio de la sección de symlinks.
#
# El resto son herramientas de uso diario (convertir, fusionar cuantizaciones,
# LoRA, medir velocidad) que antes solo se alcanzaban por ruta larga.
ropero_link_mlx() {
    _ropero_link_python "mlx_lm" \
        mlx_lm.server \
        mlx_lm.generate \
        mlx_lm.chat \
        mlx_lm.convert \
        mlx_lm.fuse \
        mlx_lm.lora \
        mlx_lm.benchmark \
        mlx_vlm.server \
        mlx_vlm.generate
}

# ropero_link_fastflowlm — el binario `flm` de FastFlowLM.
#
# El cmake preset de FastFlowLM instala en /opt/fastflowlm (linux-default), fuera
# del PATH de un usuario normal. Se enlaza para que `flm pull`, `flm list` y
# `flm validate` se puedan escribir sin la ruta larga — que es como se documentan.
ropero_link_fastflowlm() {
    _ropero_link_dir "fastflowlm" "/opt/fastflowlm/bin" "flm"
}

# -----------------------------------------------------------------------------
# cmd_check — verifica que ropero está correctamente instalado.
# NO modifica nada. Exit 0 si todo OK, 1 si algo falla.
# -----------------------------------------------------------------------------
cmd_check() {
    # Igual que cmd_list/cmd_templates: lo que llega detrás y no se reconoce
    # es un error, no algo que se tira. `ropero --check models` parece una
    # orden razonable —"mira qué modelos hay"— y hasta hace un rato ejecutaba
    # el check entero fingiendo que eso era lo que le habías pedido. Fallar
    # aquí, arriba del todo, es lo que le da sentido al mensaje.
    if [[ $# -gt 0 ]]; then
        _ropero_usage_error check "check no acepta argumentos (recibido: '$1')"
    fi

    local rc=0
    ropero_counters_reset

    printf "\n== ropero --check ==\n"

    ropero_step "1/5" "Symlinks"

    # Entry point
    if [[ -e "$BIN_DIR/ropero" ]]; then
        ropero_ok "ropero → $BIN_DIR/ropero"
    else
        ropero_err "ropero NO instalado en $BIN_DIR"
        rc=1
    fi

    # ropero.d
    if [[ -e "$BIN_DIR/ropero.d" ]]; then
        local n
        n=$(ls -1 "$BIN_DIR/ropero.d"/*.sh 2>/dev/null | wc -l | tr -d ' ')
        ropero_ok "ropero.d → $BIN_DIR/ropero.d ($n scripts)"
    else
        ropero_err "ropero.d NO linkeado en $BIN_DIR"
        rc=1
    fi

    ropero_step "2/5" "Engines"

    # Engines: sus ejecutables tienen que estar en $BIN_DIR, no sólo en su ruta
    # larga. Si esto falla, la solución es `ropero --install`, no buscar el
    # binario a mano. Cada engine se comprueba por separado, con SU regla de
    # qué debe estar enlazado (llama.cpp: todo; tensorrt: solo trtllm-*).
    local bdir b found
    bdir="$LLAMA_DIR/build/bin"
    if [[ ! -d "$bdir" ]]; then
        ropero_info "llama.cpp: no compilado ($bdir no existe)"
    else
        found=0
        # OJO: el nombre del engine y el del ejecutable son variables
        # DISTINTAS. Con una sola, el mensaje sale con el nombre del último
        # ejecutable recorrido en vez de con el del engine.
        for b in "$bdir"/*; do
            [[ -x "$b" && ! -d "$b" ]] || continue
            local link="$BIN_DIR/$(basename "$b")"
            [[ -L "$link" && -x "$link" ]] && found=$((found + 1))
        done
        if (( found > 0 )); then
            ropero_ok "llama.cpp: $found ejecutables en $BIN_DIR"
        else
            ropero_err "llama.cpp: $bdir tiene ejecutables pero ninguno linkeado en $BIN_DIR"
            ropero_info "  solución: ropero --install"
            rc=1
        fi
    fi

    # tensorrt-llm: solo los trtllm-*, igual que hace ropero_link_tensorrt.
    bdir="$HOME/.venv-tensorrt/bin"
    if [[ ! -d "$bdir" ]]; then
        ropero_info "tensorrt-llm: no instalado ($bdir no existe)"
    else
        found=0
        for b in "$bdir"/trtllm-*; do
            [[ -x "$b" && ! -d "$b" ]] || continue
            local link="$BIN_DIR/$(basename "$b")"
            [[ -L "$link" && -x "$link" ]] && found=$((found + 1))
        done
        if (( found > 0 )); then
            ropero_ok "tensorrt-llm: $found ejecutables en $BIN_DIR"
        elif [[ -x "$bdir/trtllm-serve" ]]; then
            ropero_warn "tensorrt-llm: instalado pero sin enlaces en $BIN_DIR"
            ropero_info "  no es bloqueante: ropero lo invoca por su ruta larga"
        else
            ropero_info "tensorrt-llm: venv presente, sin trtllm-serve"
        fi
    fi

    # Engines con servidor propio: uno por engine, con su probe real. El bloque
    # anterior era un `for w in airllm mlx_lm` que miraba `command -v` — es
    # decir, preguntaba por un ejecutable que airllm no tiene, y no preguntaba
    # por tensorrt-llm ni por FastFlowLM en absoluto. Peor: "command -v" dice si
    # el fichero está, no si el paquete importa. airllm daba "no disponible"
    # (correcto por casualidad, mal por el motivo) y mlx_lm daba "disponible"
    # porque su shim de asdf responde, sin comprobar que mlx_lm.server exista.
    local e verdict probe_err probe_err_f
    printf "\n-- engines con servidor propio --\n"
    probe_err_f="$(mktemp "${TMPDIR:-/tmp}/ropero_probe.XXXXXX")"
    for e in $(ropero_engine_list); do
        local bin auth_mode
        if bin=$(ropero_engine_resolve "$e" 2>/dev/null); then
            if ropero_engine_auth_native "$e"; then
                auth_mode="api-key propia"
            else
                auth_mode="proxy de auth"
            fi
        else
            auth_mode="proxy de auth"
        fi
        # El probe escribe el VEREDICTO en stdout y el DIAGNÓSTICO en stderr.
        # Se necesitan los dos, y el diagnóstico es a menudo lo más importante:
        # airllm responde "ok" (el server arranca) mientras avisa de que la
        # LIBRERÍA no importa. Con `2>/dev/null` —como estaba— ese aviso se
        # perdía y el --check saying "ok" era media verdad.
        : >"$probe_err_f"
        verdict=$(ropero_engine_probe "$e" 2>"$probe_err_f" || true)
        case "$verdict" in
            ok)      ropero_ok  "$e: $bin [$auth_mode]" ;;
            missing) ropero_info "$e: no instalado (engine opcional)" ;;
            *)       ropero_warn "$e: instalado pero NO utilizable" ;;
        esac
        probe_err=$(cat "$probe_err_f")
        if [[ -n "$probe_err" ]]; then
            printf '%s\n' "$probe_err" >&2
        fi
    done
    rm -f "$probe_err_f"

    ropero_step "3/5" "Modelos"

    # Modelos
    if [[ -d "$GGUF_DIR" ]]; then
        local n
        n=$(ls -1 "$GGUF_DIR"/*.gguf 2>/dev/null | wc -l | tr -d ' ')
        if (( n > 0 )); then
            ropero_ok "modelos GGUF: $n en $GGUF_DIR"
        else
            ropero_warn "sin modelos en $GGUF_DIR (ropero --install los descarga)"
        fi
    else
        ropero_warn "GGUF_DIR no existe: $GGUF_DIR"
    fi

    # llama-server
    if command -v llama-server >/dev/null 2>&1; then
        # Con la versión, porque ropero linkea el suyo en $BIN_DIR y eso
        # TAPA cualquier llama-server que hubiera estado en el PATH. Sin la
        # versión no hay forma de notar un downgrade.
        local ls_ver
        ls_ver=$(llama-server --version 2>&1 | grep -m1 '^version:' | sed 's/^version: //')
        ropero_ok "llama-server: $(command -v llama-server) ${ls_ver:+(v$ls_ver)}"
    else
        ropero_warn "llama-server NO en PATH (ropero --install lo compila)"
    fi

    ropero_step "4/5" "PATH"

    # PATH: ¿BIN_DIR está en PATH?
    if [[ ":$PATH:" == *":$BIN_DIR:"* ]]; then
        ropero_ok "$BIN_DIR está en PATH"
    else
        ropero_warn "$BIN_DIR NO está en PATH"
        ropero_info "  Añade a tu .zshrc: export PATH=\"\$HOME/.local/bin:\$PATH\""
    fi

    ropero_phase "Resumen"
    ropero_counters
    printf "\n"
    if (( rc == 0 )); then
        _ropero_log "  [✓] ropero --check OK"
    else
        _ropero_log "  [✗] ropero --check FALLÓ → ejecuta: ropero --install"
    fi
    printf "\n"
    return $rc
}

# -----------------------------------------------------------------------------
# Instalación por engine. Cada función hace TRES cosas, en este orden:
#   1. preguntar si se quiere (o rehacerlo si ya estaba),
#   2. instalar / compilar,
#   3. y enlazar SUS ejecutables en $BIN_DIR.
#
# El punto 3 va dentro de la función a propósito. Antes los enlaces eran un
# paso aparte al final del install que recorría todos los backends: instalar
# solo llama.cpp acababa tocando también los ejecutables de tensorrt, y
# saltarse un engine no evitaba sus enlaces. Con un engine roto, no había
# forma de relanzar solo su fase — de ahí el `--link` que se ha quitado: no
# arreglaba el diseño, lo tapaba.
#
# Todas devuelven 0 aunque fallen: que un engine opcional no se caiga no
# impide instalar los demás.
# -----------------------------------------------------------------------------

# ── llama.cpp (todos los OS salvo termux) ────────────────────────────────────
ropero_install_llama() {
    local os="$1"

    if [[ -x "$LLAMA_DIR/build/bin/llama-server" ]]; then
        ropero_ok "llama.cpp ya compilado en $LLAMA_DIR"
        if ! ropero_ask "¿Recompilarlo desde cero (borra $LLAMA_DIR, ~40 min)?"; then
            ropero_link_llamacpp
            return 0
        fi
    elif ! ropero_ask "Descargar y compilar llama.cpp (imprescindible para ropero)?"; then
        ropero_warn "llama.cpp omitido — ropero solo funcionará con binarios ya presentes"
        return 0
    fi

    if [[ -d "$LLAMA_DIR/.git" ]]; then
        ropero_info "borrando $LLAMA_DIR para recompilar limpio"
        rm -rf "$LLAMA_DIR"
    elif [[ -d "$LLAMA_DIR" ]]; then
        ropero_warn "$LLAMA_DIR existe pero no es un clon de git; lo sustituyo"
        rm -rf "$LLAMA_DIR"
    fi

    if ! git clone -q https://github.com/ggml-org/llama.cpp "$LLAMA_DIR"; then
        ropero_err "clone de llama.cpp falló"
        return 0
    fi
    if [[ ! -d "$LLAMA_DIR/.git" ]]; then
        ropero_err "llama.cpp no parece un repo git tras el clone"
        return 0
    fi

    if ! ropero_compile_llama "$os"; then
        ropero_err "compilación de llama.cpp falló; no hay symlinks que crear"
        return 0
    fi

    # Solo ahora que los binarios existen de verdad.
    ropero_link_llamacpp
    return 0
}

# ── AirLLM (todos los OS salvo termux) ───────────────────────────────────────
ropero_install_airllm() {
    local py
    py=$(ropero_python_bin 2>/dev/null || true)

    # El criterio de "ya instalado" NO es `command -v airllm`. airllm no registra
    # ningún ejecutable, así que ese test siempre daba falso y además medía una
    # cosa que no importa. Lo que importa es si el PAQUETE importa, porque de eso
    # depende que el server pueda hacer offload capa a capa.
    if [[ -n "$py" ]] && "$py" -c 'import airllm' >/dev/null 2>&1; then
        ropero_ok "airllm ya instalado y utilizable"
        if ! ropero_ask "¿Reinstalarlo?"; then
            ropero_link_airllm
            return 0
        fi
    elif ! ropero_ask "¿Instalar AirLLM (modelos safetensors que no caben en VRAM)?"; then
        ropero_info "airllm omitido; el resto de engines funciona igual"
        return 0
    fi

    local rc=1
    # uv primero: es lo que hay en cachy y evita ensuciar el Python de asdf.
    if command -v uv &>/dev/null; then
        ropero_info "instalando airllm via uv (puede tardar)..."
        uv pip install --system --quiet airllm 2>/dev/null && rc=0
    fi
    if (( rc != 0 )) && { command -v pip &>/dev/null || command -v pip3 &>/dev/null; }; then
        ropero_info "fallback: instalando airllm via pip..."
        { pip install --quiet airllm 2>/dev/null || pip3 install --quiet airllm 2>/dev/null; } && rc=0
    fi

    # airllm 2.11.0 hace `from transformers import LlamaForCausalLM`, que en
    # transformers 5.x ya no existe. No lo arregla el install (dependencias de
    # airllm, no nuestras), pero sí avisar: sin esto el usuario ve "airllm
    # instalado" y luego un ImportError cuando arranca el modelo.
    if (( rc == 0 )); then
        ropero_ok "airllm instalado"
        if ! "$py" -c 'import airllm' >/dev/null 2>&1; then
            ropero_warn "  ! airllm instalado pero NO importa con este Python"
            ropero_warn "    airllm 2.11.0 usa LlamaForCausalLM del nivel superior de"
            ropero_warn "    transformers, que ya no existe en 5.x. Solución:"
            ropero_warn "      pip install 'transformers<5'"
        fi
        ropero_link_airllm
    else
        ropero_warn "airllm no instalado (ni uv ni pip han funcionado)"
        ropero_info "  manual: uv pip install airllm"
    fi
    return 0
}

# ── TensorRT-LLM (solo cachy/arch) ───────────────────────────────────────────
ropero_install_tensorrt() {
    local venv="$HOME/.venv-tensorrt"

    if [[ -x "$venv/bin/trtllm-serve" ]]; then
        ropero_ok "tensorrt-llm ya instalado en $venv"
        if ! ropero_ask "¿Reinstalarlo (borra el venv, ~30 min)?"; then
            ropero_link_tensorrt
            return 0
        fi
    elif ! ropero_ask "¿Instalar TensorRT-LLM (pesado, ~30 min)?"; then
        return 0
    fi

    if ! command -v uv &>/dev/null; then
        ropero_warn "tensorrt-llm necesita uv; se omite"
        ropero_info "  manual: pacman -S uv"
        return 0
    fi

    # Recrear SIEMPRE: si quedó un venv roto/incompleto de un install anterior,
    # `uv venv` falla con "A virtual environment already exists".
    ropero_info "creando venv tensorrt-llm..."
    rm -rf "$venv"
    if ! uv venv "$venv" --python 3.12 2>/dev/null; then
        ropero_warn "uv venv falló (¿borrado manual de $venv?)"
        return 0
    fi

    ropero_info "instalando tensorrt-llm (20-40 min)..."
    if uv pip install --python "$venv/bin/python" --quiet tensorrt-llm 2>/dev/null; then
        ropero_ok "tensorrt-llm instalado en $venv"
        # Solo los trtllm-*: el resto del venv no debe tocar el PATH global.
        ropero_link_tensorrt
    else
        ropero_warn "tensorrt-llm falló (puede necesitar CUDA wheels manuales)"
        ropero_info "  ver https://nvidia.github.io/TensorRT-LLM/"
    fi
    return 0
}

# ── mlx_lm (solo macOS / Apple Silicon) ──────────────────────────────────────
ropero_install_mlx() {
    if command -v mlx_lm >/dev/null 2>&1; then
        ropero_ok "mlx-lm ya instalado"
        if ! ropero_ask "¿Reinstalarlo?"; then
            ropero_link_mlx
            return 0
        fi
    elif ! ropero_ask "¿Instalar mlx-lm (modelos MLX en Apple Silicon)?"; then
        return 0
    fi

    local rc=1
    if command -v uv &>/dev/null; then
        ropero_info "instalando mlx-lm via uv..."
        uv pip install --system --quiet mlx-lm 2>/dev/null && rc=0
    fi
    if (( rc != 0 )) && { command -v pip &>/dev/null || command -v pip3 &>/dev/null; }; then
        ropero_info "fallback: instalando mlx-lm via pip..."
        { pip install --quiet mlx-lm 2>/dev/null || pip3 install --quiet mlx-lm 2>/dev/null; } && rc=0
    fi

    if (( rc == 0 )); then
        ropero_ok "mlx-lm instalado"
        ropero_link_mlx
    else
        ropero_warn "mlx-lm no instalado (ni uv ni pip han funcionado)"
        ropero_info "  manual: uv pip install mlx-lm"
    fi
    return 0
}

# ── FastFlowLM (solo cachy/arch CON NPU AMD) ─────────────────────────────────
# El único engine de ropero que no acelera una GPU: descarga el trabajo a la
# NPU (XDNA) de los Ryzen AI. Es OPUESTO a la RTX, no sustituto — tiene sentido
# precisamente porque convive con ella: la NPU come el modelo pequeño mientras la
# GPU come el grande.
#
# Por qué el gate es tan específico (cachy/arch + AMD + NPU):
#   · macOS no tiene NPU AMD. Ni el stack ni el driver.
#   · En Linux, el stack de la NPU es amdxdna (kernel) + XRT (userspace) + firmware.
#     `flm validate` puede pasar (usa el DRM device) mientras `flm run` falla con
#     "No such device with index '0'" (usa XRT). Por eso se comprueban AMBAS capas.
#   · En una CPU Intel/AMD sin NPU no hay nada que instalar: flm existiría y no
#     arrancaría ningún modelo.
ropero_install_fastflowlm() {
    local os="${1:-}"
    if [[ "$os" != "cachy" && "$os" != "arch" ]]; then
        ropero_info "FastFlowLM: solo en cachy/arch con NPU AMD; omitido en $os"
        return 0
    fi
    if ! ropero_has_amd_npu; then
        ropero_info "FastFlowLM: no veo NPU AMD (XDNA) en esta máquina; omitido"
        ropero_info "  se necesita /dev/accel/accel0 (driver amdxdna) o 'xrt-smi examine'"
        ropero_info "  con NPU listada. Si la tienes y no la detecto, dímelo: el"
        ropero_info "  gate está en ropero_has_amd_npu (ropero.d/_engines.sh)"
        return 0
    fi

    if [[ -x /opt/fastflowlm/bin/flm ]]; then
        ropero_ok "FastFlowLM ya instalado en /opt/fastflowlm"
        if ! ropero_ask "¿Reinstalarlo?"; then
            ropero_link_fastflowlm
            return 0
        fi
    elif ! ropero_ask "¿Instalar FastFlowLM (usa la NPU AMD; sólo cachy/arch con NPU)?"; then
        return 0
    fi

    # ── 1. Stack del sistema ───────────────────────────────────────────────
    # xrt-plugin-amdxdna es el que hace que `flm run` (XRT) vea el device. Sin él,
    # `flm validate` puede pasar y el modelo no arranca: es el fallo más confuso
    # de toda esta cadena, así que se instala siempre que falte.
    local p
    for p in xrt xrt-plugin-amdxdna linux-firmware-other; do
        if pacman -Qi "$p" &>/dev/null; then
            continue
        fi
        ropero_info "instalando $p..."
        sudo pacman -S --needed --noconfirm "$p" \
            || ropero_warn "  no se pudo instalar $p"
    done

    # amdxdna-dkms está en el AUR, no en los repos. Sin él, un kernel 6.19+ usa
    # el driver in-tree, que con firmware 1.1 puede hacer desaparecer la NPU
    # (el driver espera el protocolo viejo). El orden importa: headers → DKMS →
    # depmod → REBOOT. El reboot no se puede hacer desde aquí; se avisa.
    if ! modinfo amdxdna >/dev/null 2>&1 || \
       { modinfo -F filename amdxdna 2>/dev/null | grep -q '/dkms/'; }; then
        ropero_info "instalando amdxdna-dkms (AUR)..."
        local _installed_dkms=0
        if command -v paru &>/dev/null; then
            paru -S --needed --noconfirm amdxdna-dkms && _installed_dkms=1
        elif command -v yay &>/dev/null; then
            yay -S --needed --noconfirm amdxdna-dkms && _installed_dkms=1
        else
            ropero_warn "  no hay paru/yay: instala amdxdna-dkms a mano"
        fi
        if (( _installed_dkms == 1 )); then
            ropero_info "reconstruyendo el módulo para el kernel en uso..."
            sudo dkms autoinstall -k "$(uname -r)" || ropero_warn "  dkms falló"
            sudo depmod -a || true
            ropero_warn "  REBOOT NECESARIO para que cargue el módulo DKMS."
            ropero_warn "  Sin reboot, `flm validate` puede fallar o ver la NPU apagada."
        fi
    fi

    # El límite de memoria bloqueada: la NPU reserva memoria no swapeable. Sin
    # memlock ilimitado, los modelos grandes fallan al Allocate.
    local memlock
    memlock=$(ulimit -l 2>/dev/null || echo unknown)
    if [[ "$memlock" != "unlimited" ]]; then
        ropero_warn "  memlock = $memlock (hace falta 'unlimited' para la NPU)"
        ropero_warn "  Añade a /etc/security/limits.conf:"
        ropero_warn "      *    soft    memlock    unlimited"
        ropero_warn "      *    hard    memlock    unlimited"
        ropero_warn "  y vuelve a entrar en la sesión (o reinicia)."
    fi

    # ── 2. El runtime ──────────────────────────────────────────────────────
    # En Arch no hay .deb de FastFlowLM, así que se compila. El preset
    # linux-default instala en /opt/fastflowlm; de ahí el symlink.
    local src="$HOME/FastFlowLM"
    if [[ ! -d "$src/.git" ]]; then
        ropero_info "clonando FastFlowLM (con submodulos)..."
        rm -rf "$src"
        git clone -q --recursive https://github.com/ROCm/FastFlowLM.git "$src" \
            || { ropero_err "clone de FastFlowLM falló"; return 0; }
    fi

    # Dependencias de compilación. Sin libxrt-dev no compila; sin los de ffmpeg
    # fallan las capacidades de audio (Whisper / transcripción).
    for p in ninja; do
        pacman -Qi "$p" &>/dev/null || sudo pacman -S --needed --noconfirm "$p" \
            || ropero_warn "  no se pudo instalar $p"
    done

    ropero_info "compilando FastFlowLM (10-20 min, -j)..."
    if ! ( cd "$src/src" && cmake --preset linux-default && \
           cmake --build build -j"$(nproc)" && sudo cmake --install build ); then
        ropero_warn "FastFlowLM no compiló"
        ropero_info "  deps de build: ninja libavformat-dev libavutil-dev libavcodec-dev"
        ropero_info "                     libswresample-dev libswscale-dev libxrt-dev uuid-dev libdrm-dev"
        ropero_info "  guía: https://github.com/ROCm/FastFlowLM/blob/main/docs/linux-getting-started.md"
        return 0
    fi

    ropero_link_fastflowlm

    # ── 3. Verificación de la NPU ──────────────────────────────────────────
    # No es un adorno: el 90% de los fallos de FLM aquí son de firmware/driver,
    # no de compilación, y sin esto el install "termina bien" con una NPU muerta.
    local flm
    if flm=$(ropero_engine_resolve fastflowlm) && "$flm" validate 2>&1 | sed 's/^/  /'; then
        ropero_ok "FastFlowLM listo (NPU verificada)"
        ropero_info "  modelos: flm pull <tag>   ·   listados: flm list"
    else
        ropero_warn "FastFlowLM instalado pero 'flm validate' no pasa."
        ropero_info "  Causas, en orden de probabilidad:"
        ropero_info "    1. firmware NPU < 1.1.0.0 (necesario 1.1.2.64 en kernels 6.19)"
        ropero_info "    2. amdxdna-dkms sin reconstruir tras el último kernel"
        ropero_info "    3. XRT no ve la NPU:  xrt-smi examine   (flm run usa XRT,"
        ropero_info "       no el DRM device: validate puede pasar y run fallar)"
        ropero_info "    4. memlock no ilimitado"
    fi
    return 0
}

# -----------------------------------------------------------------------------
# _ropero_do_models — la fase de modelos, en un solo sitio.
#
# Existe por un motivo concreto: la reachable desde `ropero --install models`,
# `ropero --install all` y `ropero models` (top-level), y son tres llamadas al
# mismo trabajo. Duplicar el cuerpo en las tres es exactamente cómo un día
# `ropero models` se queda sin el GGUF de MLX porque el otro camino sí lo tenía.
# Es el mismo bug que estamos arreglando en el parseo, aplicado a la lógica: una
# sola definición, tres entradas.
#
# NO llama a ropero_env_setup: quien llama a esta función ya lo ha hecho (mkdir
# -p es idempotente, pero llamar al setup dos veces por comando es pedir que
# mañana alguien lo lea mal y no sepa cuál de los dos manda).
# -----------------------------------------------------------------------------
_ropero_do_models() {
    ropero_download_default_models "${1:-}"
}

# -----------------------------------------------------------------------------
# cmd_models — descarga solo los modelos por defecto. Sin engines, sin paquetes,
# sin sudo. Es lo que se pide cuando ya se tiene el stack y solo falta disco.
# -----------------------------------------------------------------------------
cmd_models() {
    if [[ $# -gt 0 ]]; then
        _ropero_usage_error models "models no acepta argumentos (recibido: '$1')"
    fi
    local os
    os=$(ropero_detect_os 2>/dev/null || echo unknown)
    ropero_info "ropero models ($os)"
    ropero_env_setup
    _ropero_do_models
    ropero_ok "ropero models OK"
}

# -----------------------------------------------------------------------------
# _ropero_install_engines <os> — paquetes del sistema + engines. La fase que
# necesita sudo, descarga código y deja binarios.
#
# Separada de cmd_install por el target, no por gusto de factoring: con
# `--install engines` y `--install all` es exactamente el mismo bloque, y
# mantenerlo inline obligaba a anidar media función dentro de un if para que la
# mitad de las rutas lo ejecutara. A nivel de archivo, además, porque la fase de
# modelos tiene la misma forma y conviene leerlas como dos piezas hermanas.
# -----------------------------------------------------------------------------
_ropero_install_engines() {
    local os="$1"

    # 1. paquetes del sistema
    if [[ "$os" == "cachy" || "$os" == "arch" ]]; then
        local pkgs=(base-devel git cmake ninja curl ccache gcc14 uv)
        local p
        for p in "${pkgs[@]}"; do
            pacman -Qi "$p" &>/dev/null || sudo pacman -S --needed --noconfirm "$p" || ropero_warn "no se pudo instalar $p"
        done
        if ! command -v llama-swap &>/dev/null; then
            command -v paru &>/dev/null && paru -S --needed --noconfirm llama-swap-bin || ropero_warn "omito llama-swap-bin"
        else
            ropero_ok "llama-swap ya instalado"
        fi
    elif [[ "$os" == "macos" ]]; then
        for p in cmake ninja; do
            command -v "$p" &>/dev/null || brew install "$p" || ropero_warn "no se pudo instalar $p"
        done
    fi

    # 2. engines. Cada uno instala lo suyo y linkea lo suyo.
    ropero_install_llama "$os"
    ropero_install_airllm

    if [[ "$os" == "cachy" || "$os" == "arch" ]]; then
        ropero_install_tensorrt
    fi
    if [[ "$os" == "macos" ]]; then
        ropero_install_mlx
    fi
    # La NPU es un recurso APARTE de la GPU: se instala solo si hay una, y sin
    # preguntar por el resto de engines (que ya han pasado). El gate está dentro
    # de la función (cachy/arch + AMD + XDNA), no aquí, para que la razón de que
    # se salte se pueda explicar engine por engine.
    ropero_install_fastflowlm "$os"
}

# -----------------------------------------------------------------------------
# _ropero_relink_all <os> — rehace los symlinks de TODO lo que ya está
# instalado. No instala nada, no pide sudo, no pregunta.
#
# El hueco que cubre: los enlaces solo se creaban de rebote, al final de
# ropero_install_* — y solo si esa fase llegaba a ejecutarse. Borraste
# ~/.local/bin/llama-server y para recuperarlo tenías dos opciones, las dos
# malas: `ropero --install engines` (que te pregunta cinco veces y puede quedarse
# enganchado en un sudo pacman) o acordarte de la ruta larga de build/bin.
#
# Es la fase de engines con todo el "instalar" sustituido por "¿ya está?", que
# es un test sin efectos. Y por eso un engine que no está no es un fallo: si no
# hay build, no hay nada que enlazar, y decirlo es más útil que callarse.
# -----------------------------------------------------------------------------
_ropero_relink_all() {
    local os="$1"

    ropero_info "relinkeando ejecutables en $BIN_DIR (no instala nada, no pide sudo)"

    if [[ -x "$LLAMA_DIR/build/bin/llama-server" ]]; then
        ropero_link_llamacpp
    else
        ropero_info "  · llama.cpp no compilado ($LLAMA_DIR/build/bin); nada que enlazar"
    fi

    # airllm es distinto de los demás: lo que se enlaza es _airllm_server.py,
    # que es de ropero y siempre está. Que el PAQUETE airllm importe o no es
    # otra pregunta, y la responde ropero_link_airllm con su propio aviso. Por
    # eso aquí no hay "¿está instalado?": el enlace se rehace siempre.
    ropero_link_airllm

    if [[ -x "$HOME/.venv-tensorrt/bin/trtllm-serve" ]]; then
        ropero_link_tensorrt
    else
        ropero_info "  · tensorrt-llm no instalado; nada que enlazar"
    fi

    if [[ "$os" == "macos" ]]; then
        ropero_link_mlx
    else
        ropero_info "  · mlx-lm es Apple Silicon; no aplica en $os"
    fi

    if [[ -x /opt/fastflowlm/bin/flm ]]; then
        ropero_link_fastflowlm
    else
        ropero_info "  · FastFlowLM no instalado; nada que enlazar"
    fi

    return 0
}

# -----------------------------------------------------------------------------
# _ropero_install_one_engine <engine> <os>
#
# La versión SIN preguntas de `_ropero_install_engines`, para un engine
# concreto. No es un refactor de gusto: `ropero --install engines` pregunta, y
# una pregunta en un contexto no interactivo (repos.yaml, un script de
# arranque, un pipeline) se queda esperando una respuesta que no va a llegar.
#
# Lo que NO hace aquí y sí hace la versión interactiva: preguntar por qué se
# borra ~/llama.cpp antes de borrarlo. Por eso los engines destructivos
# (llama) se limpian con `ropero_ask_keep`, que sigue negándose aunque
# AUTO_YES=1: instalar un engine que el usuario pidió no le da permiso para
# tirarle 40 minutos de compilación a otro.
# -----------------------------------------------------------------------------
_ropero_install_one_engine() {
    local only="$1" os="$2"

    case "$only" in
        llama)
            if [[ -d "$LLAMA_DIR/.git" ]]; then
                ropero_info "llama.cpp ya está clonada; la recompilo desde cero"
                rm -rf "$LLAMA_DIR" || { ropero_err "no se pudo borrar $LLAMA_DIR"; return 1; }
            fi
            ropero_install_llama "$os"
            ropero_link_llamacpp
            ;;
        airllm)
            ropero_install_airllm
            ropero_link_airllm
            ;;
        mlx)
            if [[ "$os" != "macos" ]]; then
                ropero_err "mlx-lm es Apple Silicon; no aplica en $os"
                return 1
            fi
            ropero_install_mlx
            ropero_link_mlx
            ;;
        tensorrt)
            if [[ "$os" != "cachy" && "$os" != "arch" ]]; then
                ropero_err "tensorrt-llm solo se instala en cachy/arch (nvidia); detected $os"
                return 1
            fi
            ropero_install_tensorrt
            ropero_link_tensorrt
            ;;
        flm)
            ropero_install_fastflowlm "$os"
            if [[ -x /opt/fastflowlm/bin/flm ]]; then
                ropero_link_fastflowlm
            else
                ropero_info "FastFlowLM no quedó instalado; nada que enlazar"
            fi
            ;;
        *)
            ropero_err "engine desconocido: '$only'"
            ropero_info "  los que ropero conoce: llama · mlx · airllm · tensorrt · flm"
            return 1
            ;;
    esac
    return 0
}

# -----------------------------------------------------------------------------
# ropero_install_finisher <etiqueta> — el ÚNICO sitio por el que --install
# termina.
#
# Estaba copiado en cinco salidas distintas (termux, link, models, models con
# nombre, engines con nombre, all). Con cinco copias, cualquier cambio —un
# contador más, un wording— tenía quearse en las cinco, y el forgot de una
# daba un --install que se callaba justo en el camino que falló.
# -----------------------------------------------------------------------------
ropero_install_finisher() {
    local label="${1:-}"
    ropero_phase "Resumen"
    ropero_counters
    printf '\n'
    if (( ROPERO_FAIL > 0 )); then
        _ropero_log "  [✗] ropero --install ${label} incompleto → revisa: ropero --check"
        return 1
    fi
    _ropero_log "  [✓] ropero --install ${label} OK"
    printf '\n'
    return 0
}

# -----------------------------------------------------------------------------
# cmd_install — orquesta. Cada engine va por su cuenta; el siguiente no depende
# del anterior.
#
# Target (primer argumento, opcional):
#   all      (defecto) engines + modelos — el comportamiento de siempre
#   engines  solo paquetes del sistema y engines; no descarga ni un byte de pesos
#   models   solo los modelos por defecto; no toca engines ni pide sudo
#   link     solo rehacer los symlinks de lo ya instalado, y verificar. No
#            instala NADA: es la respuesta a "¿por qué no encuentro
#            llama-server?" cuando los binarios están compilados pero ~/.local/bin
#            se ha quedado vacío.
#
# --force: no preguntar. Es lo que ya se conseguía con AUTO_YES=1 /
# SETUP_MODE=full, expuesto como flag porque en un install interactivo ir
# escribiendo una variable de entorno es una forma rara de decir "ya he dicho
# que sí".
#
# El target se parsea PRIMERO, antes de instalar nada. Si no fuera así,
# `ropero --install mdoels` empezaría a instalar paquetes antes de que nadie le
# hubiera dicho que el argumento no existe — y la auditoría de por qué se paró
# a medias sería "se quedó sin espacio" en vez de "escribiste mdoels".
# -----------------------------------------------------------------------------
cmd_install() {
    local target="all"
    local force=0
    local only=""          # engine o modelo concreto, si se indicó
    while [[ $# -gt 0 ]]; do
        case "$1" in
            all|models|engines|link)
                target="$1"
                shift
                ;;
            # Un argumento tras el target es el "qué": un engine concreto o un
            # modelo concreto. Antes `ropero --install engines llama` era un
            # error de uso; ahora es la forma de instalar UNO sin preguntas.
            llama|llamacpp|llama_cpp|llama-cpp) only="llama";   shift ;;
            mlx|mlx_lm|mlx-lm)                  only="mlx";     shift ;;
            airllm)                             only="airllm";  shift ;;
            tensorrt|trtllm|tensorrt-llm|tensorrt_llm) only="tensorrt"; shift ;;
            flm|fastflowlm|fastflow_lm)        only="flm";     shift ;;
            --force|-f)
                force=1
                shift
                ;;
            -h|--help)
                cmd_help
                return 0
                ;;
            *)
                if [[ -z "$only" ]]; then
                    only="$1"; shift
                else
                    _ropero_usage_error install "argumento desconocido: '$1' (solo se admite uno)"
                fi
                ;;
        esac
    done

    # `ropero --install engines llama`: engine explícito, sin preguntar. Es la
    # forma que usan los manifests (repos.yaml) y los scripts de arranque, donde
    # no hay nadie para contestar a una pregunta.
    if [[ -n "$only" && "$target" != "engines" && "$target" != "models" && "$target" != "all" ]]; then
        _ropero_usage_error install "'$only' solo vale con: engines o models"
    fi

    # --force NO redefine ropero_ask/ropero_ask_keep: las dos leen AUTO_YES y
    # SETUP_MODE en TIEMPO DE LLAMADA (00-utils.sh), así que exportarlos basta.
    # Y de paso sale gratis la protección de las preguntas destructivas:
    # ropero_ask_keep sigue devolviendo "no", de modo que --force nunca borra
    # ~/llama.cpp ni hace un rm -rf por su cuenta. Rewriar las funciones aquí,
    # además, las metería en un punto donde el entrypoint ya no las defiende.
    if (( force == 1 )); then
        export AUTO_YES=1
        export SETUP_MODE=full
        # ROPERO_FORCE es lo que hace que los descargadores BORREN lo que hay.
        # AUTO_YES solo callaba la pregunta: con el "ya descargado" de delante,
        # `ropero --install models --force` no volvía a bajar nada y no decía
        # por qué. Son dos cosas distintas y solo faltaba la segunda.
        export ROPERO_FORCE=1
    fi

    local os
    os=$(ropero_detect_os 2>/dev/null || echo unknown)
    ropero_counters_reset
    # Cuántas fases tiene ESTE camino: 4 para `all` (que encadena engines y
    # modelos), 3 para el resto, que solo hace una cosa además del binario.
    if [[ "$target" == "all" ]]; then ropero_phases_begin 4; else ropero_phases_begin 3; fi
    printf '\n══ ropero --install %s%s ══\n\n' "$target" "${only:+ $only}"
    ropero_info "ropero --install $target ($os)"
    ropero_env_setup

    ropero_phase "Binario"

    # El entrypoint primero, y pase lo que pase: a partir de aquí ropero ya es
    # utilizable aunque el usuario decline todos los engines. Por eso está
    # fuera de los if de target — incluso `ropero --install models` debe dejar
    # el binario enlazado, no solo cuando se instalan engines.
    ropero_link_self

    if [[ "$os" == "termux" ]]; then
        ropero_info "termux: sin paquetes nativos, solo dirs"
        ropero_install_finisher "$target"; return $?
    fi

    if [[ "$target" == "link" ]]; then
        ropero_phase "Enlaces"
        _ropero_relink_all "$os"
        # El check va dentro y no como paso aparte de la CLI: "he relinkeado"
        # no es lo mismo que "está bien". Un symlink que apunta a un binario
        # recompilado a medias es justo el fallo que no se ve hasta que algo
        # deja de arrancar, y un relink sin check no lo pilla. El rc que sale
        # es el del check.
        cmd_check
        return $?
    fi

    if [[ "$target" == "models" ]]; then
        # Ni sudo, ni pacman, ni engines. Solo los pesos.
        if [[ -n "$only" ]]; then
            # Un modelo concreto: NO se pregunta (ya lo pidió por nombre) y no
            # se baja el catálogo entero.
            ropero_phase "Modelos"
            ropero_download_default_models "$only" || return $?
            ropero_install_finisher "models $only"; return $?
        fi
        ropero_phase "Modelos"
        _ropero_do_models
        ropero_install_finisher "models"; return $?
    fi

    if [[ -n "$only" ]]; then
        # `ropero --install engines <engine>`: uno solo, sin preguntar.
        ropero_phase "Engines"
        _ropero_install_one_engine "$only" "$os" || return $?
        ropero_install_finisher "engines $only"; return $?
    fi

    ropero_phase "Engines"
    _ropero_install_engines "$os"

    # 3. modelos por defecto (lógica en 21-download-models.sh). Con target
    #    `engines` no se llega aquí: ya hemos salido por el return de arriba.
    if [[ "$target" == "all" ]]; then
        ropero_phase "Modelos"
        _ropero_do_models
    fi

    ropero_install_finisher "$target"; return $?
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------
main() {
    local cmd="${1:-}"
    if [[ -z "$cmd" || "$cmd" == "help" || "$cmd" == "-h" || "$cmd" == "--help" ]]; then
        cmd_help
        exit 0
    fi

    case "$cmd" in
        --install)
            shift
            cmd_install "$@"
            exit $?
            ;;
        --check)
            shift
            cmd_check "$@"
            exit $?
            ;;
        list)
            shift
            cmd_list "$@"
            exit 0
            ;;
        templates)
            shift
            cmd_templates "$@"
            exit 0
            ;;
        # Top-level y no solo `--install models`: es lo que se escribe cuando
        # ya se tiene el stack y solo falta disco, y obligar a recordar el
        # doble flag para eso es pedir que nadie lo use. Mismo cuerpo, misma
        # fase (_ropero_do_models): no hay dos caminos que puedan divergir.
        models)
            shift
            cmd_models "$@"
            exit $?
            ;;
        status)
            shift
            cmd_status "$@"
            exit $?
            ;;
        stop)
            shift
            cmd_stop "$@"
            exit $?
            ;;
    *)
        # Un token que empieza por "-" no es un modelo, es una opción que no
        # existe. Decirlo así y no "Modelo desconocido: --foc" (seguido de un
        # volcado de la lista de modelos a stderr): lo segundo convierte un typo
        # de teclado en veinte líneas de ruido y esconde el problema real.
        if [[ "$cmd" == -* ]]; then
            _ropero_usage_error '' "opción desconocida: '$cmd'"
        fi

        local model="$cmd"
        shift
        local background=0
        local cpu_only=0
        local force=0
        local port_override=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --background) background=1 ;;
                --cpu) cpu_only=1 ;;
                --force) force=1 ;;
                --port)
                    # Mismo contrato que --watch: el valor es obligatorio y
                    # numérico. Si el siguiente token es otro flag o no
                    # existe, es un error de uso, no un default: arrancar en
                    # un puerto que el usuario NO ha pedido sería peor que
                    # no arrancar.
                    #
                    # OJO con el `continue`: el `shift` de este caso se come el
                    # VALOR, y el `shift` del final del bucle se come el flag.
                    # Sin el continue, cuando --port va el último
                    # (`ropero embed --port 9995`) el shift final no tiene
                    # argumentos: `shift` sale con 1 y, con `set -e`, aborta el
                    # script entero EN SILENCIO. Por eso `ropero embed --port
                    # 9995` no arrancaba nada y no decía nada. Con dos flags
                    # detrás funcionaba, que es lo que hacía el fallo tan
                    # esquivo.
                    shift
                    if [[ $# -gt 0 && "$1" =~ ^[0-9]+$ ]]; then
                        # --port repetido: gana el último, pero se dice. Sin el
                        # aviso, `ropero embed --port 9995 --port 9996` arrancaba
                        # en 9996 sin dar ninguna pista de que el 9995 se había
                        # perdido por el camino — y cuando el puerto no era el
                        # que esperabas, el culpable no parecía ropero sino un
                        # segundo flag que nadie había visto.
                        if [[ -n "$port_override" ]]; then
                            echo "AVISO: --port repetido; gana el último (:$1)" >&2
                        fi
                        port_override="$1"
                        shift
                    elif [[ $# -eq 0 ]]; then
                        echo "ERROR: --port requiere un número de puerto" >&2
                        exit 1
                    else
                        echo "ERROR: --port requiere un número de puerto, recibido: $1" >&2
                        exit 1
                    fi
                    continue
                    ;;
                --port=*)
                    port_override="${1#--port=}"
                    if [[ ! "$port_override" =~ ^[0-9]+$ ]]; then
                        echo "ERROR: --port=$port_override no es un puerto válido" >&2
                        exit 1
                    fi
                    ;;
                -h|--help)
                    # Antes caía en el `*)` de abajo y salía "opción
                    # desconocida: --help". No era mentira —este branch no
                    # documentaba ningún flag de ayuda— pero `ropero embed
                    # --help` es lo primero que escribe cualquiera que haya
                    # leído cualquier otro CLI en su vida, y contestarle que su
                    # --help no existe es una forma cara de no contestar.
                    _ropero_usage ''
                    exit 0
                    ;;
                *) _ropero_usage_error '' "opción desconocida: '$1'" ;;
            esac
            shift
        done
        start_model "$model" "$background" "$cpu_only" "$force" "$port_override"
        exit $?
        ;;
    esac
}

main "$@"
