# -----------------------------------------------------------------------------
# Lanzamiento de modelo
# -----------------------------------------------------------------------------
start_model() {
    local model="$1"
    local background="$2"
    local cpu_only="${3:-0}"
    local force="${4:-0}"

    # Normalizar nombre del modelo (guiones a guiones underscores) para buscar en arrays
    local model_key="${model//-/_}"

    if [[ ! " ${MODEL_NAMES[*]} " =~ " $model_key " ]]; then
        echo "Modelo desconocido: $model" >&2
        cmd_list >&2
        return 1
    fi

    # Resolución de alias público: si el usuario invocó el alias (e.g. `coder`)
    # y el loader registró una redirección a un script físico (e.g. devstral),
    # trabajar contra el físico. Mantener el nombre "humano" para mensajes.
    local public_alias_used=""
    if [[ -n "${MODEL_ALIAS_TARGET[$model_key]:-}" ]]; then
        public_alias_used="$model"
        model_key="${MODEL_ALIAS_TARGET[$model_key]}"
        model="$model_key"
    fi

    local engine="${MODEL_ENGINE[$model_key]:-llama-server}"
    local port="$PORT"

    # Override --cpu: puerto 9998 desde el principio (afecta al check de
    # "puerto ocupado" MÁS ABAJO y al cmd). Debe ir AQUÍ, antes del check,
    # no en el case engine. Bug previo (commit 2b00b5c lo dejó tarde y
    # el check usaba 9999).
    if (( cpu_only == 1 )) && [[ "$engine" == "llama-server" ]]; then
        port=9998
    fi

    # Preflight ANTES de tocar el puerto: validar que el arranque puede
    # tener éxito (GGUF + args del módulo). No matar lo que corre por un
    # lanzamiento condenado (p.ej. mmproj ausente → antes dejaba :9999
    # vacío y a ttstt sin servidor).
    local -a pre_model_args=()
    local pre_gguf_path=""
    case "$engine" in
        "llama-server")
            pre_gguf_path="$GGUF_DIR/${MODEL_GGUF[$model_key]}"
            if [[ ! -f "$pre_gguf_path" ]]; then
                echo "Archivo GGUF no encontrado: $pre_gguf_path" >&2
                return 1
            fi
            local pre_out pre_status=0
            pre_out=$(get_model_args_"${model_key}" 2>&1) || pre_status=$?
            if (( pre_status != 0 )); then
                echo "ERROR: get_model_args_${model_key} falló:" >&2
                echo "$pre_out" >&2
                return 1
            fi
            if [[ -n "$pre_out" ]]; then
                mapfile -t pre_model_args <<<"$pre_out"
            fi
            ;;
        "airllm"|"tensorrt-llm"|"mlx_lm")
            if [[ ! -d "${MODEL_PATH[$model_key]}" ]]; then
                echo "Directorio de modelo no encontrado: ${MODEL_PATH[$model_key]}" >&2
                return 1
            fi
            ;;
    esac

    if port_listening "$port"; then
        local current
        current=$(get_model_on_port "$port" 2>/dev/null || echo "")
        if [[ "$current" == "$model" ]]; then
            echo "Modelo '$model' ya está corriendo en :$port"
            return 0
        fi
        # Puerto destino ocupado por OTRO modelo. Default: NO matar
        # automáticamente. El usuario decide con `ropero stop <modelo>` o
        # con `--force` (uso interactivo; pensado para que un humano en
        # terminal pueda rotar modelos sin encadenar 2 comandos). Solo
        # afecta al slot destino: el otro slot (si hay modelo) sigue
        # intacto. Si ya hay un --cpu cargado y quieres rearmar la GPU,
        # --force SOLO mata la GPU.
        if (( force == 1 )); then
            local pid
            pid=$(get_pid_for_port "$port")
            if [[ -n "$pid" ]]; then
                echo "⚠  --force: matando '$current' en :$port (pid $pid)"
                kill -9 "$pid" 2>/dev/null || true
                # Pequeña espera para que el puerto se libere (lsof ve TIME_WAIT)
                local _wait=0
                while (( _wait < 5 )) && port_listening "$port"; do
                    sleep 1
                    (( _wait++ ))
                done
                if port_listening "$port"; then
                    echo "✗ No se pudo liberar :$port tras matar '$current'" >&2
                    return 1
                fi
            fi
        else
            echo "✗ Puerto :$port ocupado por '$current'" >&2
            echo "  ropero NO mata automáticamente. Para liberar el puerto:" >&2
            echo "    ropero stop $current" >&2
            echo "  O usa --force para rotar interactivamente (mata solo este slot)." >&2
            return 1
        fi
    fi

    local ctx_size="${MODEL_CTX[$model_key]}"
    local ctx_env="ROPERO_$(echo "$model_key" | tr '[:lower:]' '[:upper:]')_CTX"
    ctx_size="${!ctx_env:-$ctx_size}"

    case "$engine" in
        "llama-server")
            local gguf_path="$pre_gguf_path"

            export ROPERO_CTX="$ctx_size"

            local -a model_args=("${pre_model_args[@]}")

            # ----------------------------------------------------------------
            # Selección de device: macOS = Metal; Cachy = CUDA0 (RTX) o CPU.
            # Si --cpu: el override de args (--n-gpu-layers 0 --threads N) se
            # aplica al FINAL del cmd array (ver más abajo) para GANAR sobre
            # los args del modelo (e.g. --threads 12 de qwenvision.sh). Si se
            # añadiera a model_args aquí, quedaría ANTES de los args del modelo
            # y llama-server usaría el último occurrence del modelo.
            # Si no --cpu en Cachy: CUDA0 (la RTX 5080) por defecto; no hace
            # falta flag extra (llama-server auto-detecta CUDA).
            #
            # NOTA: port=9998 se asignó ANTES del check de "puerto ocupado"
            # (justo después de detectar engine), no aquí. Bug previo.
            # ----------------------------------------------------------------
            if (( cpu_only != 1 )); then
                local _os
                _os=$(ropero_detect_os 2>/dev/null || echo unknown)
                case "$_os" in
                    macos)
                        # Metal: los flags óptimos los añade el módulo del
                        # modelo y/o la compilación (ver ropero.d/20-compile-llama.sh).
                        :
                        ;;
                    cachy|arch)
                        # CUDA0: device 0 (la RTX 5080) por defecto.
                        if [[ "${MODEL_GPU[$model_key]:-CUDA0}" == "CUDA0" ]]; then
                            :
                        fi
                        ;;
                esac
            fi

            local -a cmd=(
                "$LLAMA_BIN"
                --model "$gguf_path"
                --host "$HOST"
                --port "$port"
                --api-key "$LLAMA_API_KEY"
                --alias "$model"
                --ctx-size "$ctx_size"
                -fa on
                --log-verbosity 3
                "${model_args[@]}"
            )

            # Override --cpu al FINAL del cmd para ganar sobre args del modelo.
            if (( cpu_only == 1 )); then
                local _nproc
                _nproc=$(command -v nproc >/dev/null && nproc || echo 8)
                cmd+=("--n-gpu-layers" 0)
                cmd+=("--threads" "$_nproc")
            fi

            alaja separator "Arrancando $model en :$port (bin: $LLAMA_BIN, ctx: $ctx_size)" --color
            if (( background == 0 )); then
                "${cmd[@]}" 2>&1 | colorize "$model"
                return $?
            else
                local logfile="$LOG_DIR/ropero-${model}-${port}.log"
                nohup "${cmd[@]}" >>"$logfile" 2>&1 &
                local pid=$!
                disown "$pid" 2>/dev/null || true
                echo "Modelo $model lanzado en background (pid $pid). Log: $logfile"
                # Un VL de ~11 GB en frío tarda >60s en cargar; el chequeo
                # antiguo (6s) lo daba por muerto y rompía a ttstt.
                local wait_secs="${ROPERO_START_TIMEOUT:-180}" elapsed=0
                while (( elapsed < wait_secs )); do
                    if port_listening "$port"; then
                        local got
                        got=$(get_model_on_port "$port" 2>/dev/null || true)
                        if [[ -n "$got" ]]; then
                            echo "✓ $model responde en :$port (alias: $got)"
                            return 0
                        fi
                    fi
                    sleep 2
                    (( elapsed += 2 ))
                done
                echo "⚠  '$model' no responde tras ${wait_secs}s; revisa el log." >&2
                return 1
            fi
            ;;

        "airllm"|"tensorrt-llm"|"mlx_lm")
            local model_path="${MODEL_PATH[$model_key]}"
            if [[ ! -d "$model_path" ]]; then
                echo "Directorio de modelo no encontrado: $model_path" >&2
                return 1
            fi

            local bin_name=""
            case "$engine" in
                "airllm") bin_name="python -m airllm serve" ;;
                "tensorrt-llm")
                    if [[ -x "$BIN_DIR/trtllm-serve" ]]; then
                        bin_name="$BIN_DIR/trtllm-serve"
                    elif [[ -x "$HOME/.venv-tensorrt/bin/trtllm-serve" ]]; then
                        bin_name="$HOME/.venv-tensorrt/bin/trtllm-serve"
                    else
                        echo "ERROR: trtllm-serve no encontrado" >&2
                        return 1
                    fi
                    ;;
                "mlx_lm") bin_name="mlx_lm.server" ;;
            esac

            local -a cmd=()
            if [[ "$engine" == "airllm" ]]; then
                cmd=(python -m airllm serve --model "$model_path" --host "$HOST" --port "$port")
            elif [[ "$engine" == "tensorrt-llm" ]]; then
                cmd=("$bin_name" --model "$model_path" --host "$HOST" --port "$port")
                if [[ -n "${LLAMA_API_KEY:-}" ]]; then
                    cmd+=(--api-key "$LLAMA_API_KEY")
                fi
            elif [[ "$engine" == "mlx_lm" ]]; then
                cmd=("$bin_name" --model "$model_path" --host "$HOST" --port "$port")
            fi

            echo "Arrancando $model en :$port (engine: $engine)"
            if (( background == 0 )); then
                "${cmd[@]}" 2>&1 | colorize "$model"
                return $?
            else
                local logfile="$LOG_DIR/ropero-${model}-${port}.log"
                nohup "${cmd[@]}" >>"$logfile" 2>&1 &
                local pid=$!
                disown "$pid" 2>/dev/null || true
                echo "Modelo $model lanzado en background (pid $pid). Log: $logfile"
                local wait_secs="${ROPERO_START_TIMEOUT:-180}" elapsed=0
                while (( elapsed < wait_secs )); do
                    if port_listening "$port"; then
                        local got
                        got=$(get_model_on_port "$port" 2>/dev/null || true)
                        if [[ -n "$got" ]]; then
                            echo "✓ $model responde en :$port (alias: $got)"
                            return 0
                        fi
                    fi
                    sleep 2
                    (( elapsed += 2 ))
                done
                echo "⚠  '$model' no responde tras ${wait_secs}s; revisa el log." >&2
                return 1
            fi
            ;;
    esac
}

# -----------------------------------------------------------------------------
# --install autónomo e idempotente (spec migración + Cambios por proyecto)
# 1. paquetes (cachy/paru, macos/brew; termux: nada)
# 2. llama.cpp: pregunta (necesario para ropero); si ~/llama.cpp existe pregunta
#    borrar+reclonar+compilar. Flags CMAKE EXACTOS del spec (NO modificar).
# 3. AirLLM + TensorRT-LLM (este último solo cachy), best-effort con prompt.
# 4. modelos via download con check individual (omitir si existen).
# 5. symlinks en ~/bin.
# -----------------------------------------------------------------------------
_ropero_nproc() { nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4; }

cmd_install() {
    local os
    os=$(ropero_detect_os 2>/dev/null || echo unknown)
    ropero_info "ropero --install ($os)"
    ropero_env_setup

    if [[ "$os" == "termux" ]]; then
        ropero_info "termux: sin paquetes nativos, solo dirs"
        ropero_ok "ropero --install OK"
        return 0
    fi

    # 1. paquetes
    if [[ "$os" == "cachy" || "$os" == "arch" ]]; then
        local pkgs=(base-devel git cmake ninja curl ccache gcc14 uv)
        local p
        for p in "${pkgs[@]}"; do
            pacman -Qi "$p" &>/dev/null || sudo pacman -S --needed --noconfirm "$p" || ropero_warn "no se pudo instalar $p"
        done
        if ! command -v llama-swap &>/dev/null; then
            command -v paru &>/dev/null && paru -S --needed --noconfirm llama-swap-bin || ropero_warn "omito llama-swap-bin"
        else
            ropero_ok "llama-swap ya instalado"
        fi
    elif [[ "$os" == "macos" ]]; then
        for p in cmake ninja; do
            command -v "$p" &>/dev/null || brew install "$p" || ropero_warn "no se pudo instalar $p"
        done
    fi

    # 2. llama.cpp (preguntar: necesario para ropero)
    if ! ropero_ask "Descargar llama.cpp (necesario para ropero)?"; then
        ropero_info "llama.cpp omitido — ropero funcionará solo con binarios existentes"
    else
        if [[ -d "$LLAMA_DIR/.git" ]]; then
            if ropero_ask_keep "Borrar $LLAMA_DIR y volver a clonar+compilar?"; then
                rm -rf "$LLAMA_DIR"
                git clone -q https://github.com/ggml-org/llama.cpp "$LLAMA_DIR" || { ropero_err "clone falló"; return 1; }
            else
                ropero_info "se conserva $LLAMA_DIR existente"
            fi
        elif [[ -d "$LLAMA_DIR" ]]; then
            if ropero_ask_keep "Borrar $LLAMA_DIR (sin .git) y volver a clonar+compilar?"; then
                rm -rf "$LLAMA_DIR"
                git clone -q https://github.com/ggml-org/llama.cpp "$LLAMA_DIR" || { ropero_err "clone falló"; return 1; }
            fi
        else
            git clone -q https://github.com/ggml-org/llama.cpp "$LLAMA_DIR" || { ropero_err "clone falló"; return 1; }
        fi
        if [[ -d "$LLAMA_DIR/.git" && ! -x "$LLAMA_DIR/build/bin/llama-server" ]]; then
            ropero_compile_llama "$os" || { ropero_err "compilación falló"; return 1; }
        else
            ropero_ok "llama-server ya compilado (skip)"
        fi
        # symlinks compilados
        if [[ -d "$LLAMA_DIR/build/bin" ]]; then
            local b
            for b in "$LLAMA_DIR"/build/bin/*; do
                [[ -x "$b" ]] || continue
                ln -sf "$b" "$BIN_DIR/$(basename "$b")" 2>/dev/null || true
            done
        fi
    fi

    # 3. AirLLM (best-effort con prompt) — cross-platform: macOS, Linux (cachy/arch), Windows 11 native
    if ropero_ask "Instalar AirLLM (para modelos safetensors 120B)?"; then
        # Intenta uv primero (disponible en macOS, Linux, y Windows con uv instalado)
        if command -v uv &>/dev/null; then
            ropero_info "  · Instalando airllm via uv (puede tardar)..."
            if uv pip install --system --quiet airllm 2>/dev/null; then
                ropero_ok "  · airllm instalado"
            else
                # Fallback a pip si uv install falló
                if command -v pip &>/dev/null || command -v pip3 &>/dev/null; then
                    ropero_info "  · Fallback: instalando airllm via pip..."
                    if pip install --quiet airllm 2>/dev/null || pip3 install --quiet airllm 2>/dev/null; then
                        ropero_ok "  · airllm instalado (via pip)"
                    else
                        ropero_warn "  · AirLLM omitido (falló install pip; instálalo manual: pip install airllm)"
                    fi
                else
                    ropero_warn "  · AirLLM omitido (falló install uv; instálalo manual: uv pip install airllm)"
                fi
            fi
        elif command -v pip &>/dev/null || command -v pip3 &>/dev/null; then
            # No uv, pero pip disponible (ej. Windows native, algunos Linux)
            ropero_info "  · Instalando airllm via pip..."
            if pip install --quiet airllm 2>/dev/null || pip3 install --quiet airllm 2>/dev/null; then
                ropero_ok "  · airllm instalado (via pip)"
            else
                ropero_warn "  · AirLLM omitido (falló install pip; instálalo manual: pip install airllm)"
            fi
        else
            ropero_warn "  · AirLLM omitido (ni uv ni pip disponibles; instálalo manual: uv pip install airllm o pip install airllm)"
        fi
    fi
    # 3b. mlx_lm (solo macOS, Apple Silicon + Metal)
    if [[ "$os" == "macos" ]]; then
        if ropero_ask "Instalar mlx-lm (modelos MLX en Apple Silicon)?"; then
            ropero_info "  · Instalando mlx-lm..."
            if command -v uv &>/dev/null; then
                if uv pip install --system --quiet mlx-lm 2>/dev/null; then
                    ropero_ok "  · mlx-lm instalado"
                else
                    ropero_warn "  · mlx-lm omitido (falló install)"
                fi
            elif command -v pip &>/dev/null || command -v pip3 &>/dev/null; then
                if pip install --quiet mlx-lm 2>/dev/null || pip3 install --quiet mlx-lm 2>/dev/null; then
                    ropero_ok "  · mlx-lm instalado (via pip)"
                else
                    ropero_warn "  · mlx-lm omitido (falló install)"
                fi
            else
                ropero_warn "  · mlx-lm omitido (ni uv ni pip disponibles)"
            fi
        fi
    fi
    if [[ "$os" == "cachy" || "$os" == "arch" ]]; then
        if ropero_ask "Instalar TensorRT-LLM (solo Cachy, pesado, ~30 min)?"; then
            ropero_info "  · Creando venv tensorrt-llm..."
            local TRT_VENV="$HOME/.venv-tensorrt"
            # Recrear SIEMPRE: si quedó un venv roto/incompleto de un install
            # anterior, uv venv falla con "A virtual environment already exists".
            # rm -rf + venv nuevo es la forma más segura.
            rm -rf "$TRT_VENV"
            if uv venv "$TRT_VENV" --python 3.12 2>/dev/null; then
                ropero_info "  · Instalando tensorrt-llm (puede tardar 20-40 min)..."
                if uv pip install --python "$TRT_VENV/bin/python" --quiet tensorrt-llm 2>/dev/null; then
                    ropero_ok "  · tensorrt-llm instalado en $TRT_VENV"
                else
                    ropero_warn "  · tensorrt-llm falló (puede requerir CUDA wheels manuales; ver https://nvidia.github.io/TensorRT-LLM/)"
                fi
            else
                ropero_warn "  · uv venv falló (¿ya existe $TRT_VENV corrupto? borrado manual necesario)"
            fi
        fi
    fi

    # 4. modelos LLM por defecto (lógica extraída a 21-download-models.sh)
    ropero_download_default_models

    # 5. symlink entry en ~/bin si no existe
    if [[ ! -e "$BIN_DIR/ropero" ]]; then
        ln -sf "$SCRIPT_DIR/ropero" "$BIN_DIR/ropero" 2>/dev/null || true
    fi
    ropero_ok "ropero --install OK"
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------
main() {
    local cmd="${1:-}"
    if [[ -z "$cmd" || "$cmd" == "help" || "$cmd" == "-h" || "$cmd" == "--help" ]]; then
        cmd_help
        exit 0
    fi

    case "$cmd" in
        --install)
            shift || true
            cmd_install "$@"
            exit $?
            ;;
        list)
            cmd_list
            exit 0
            ;;
        status)
            shift
            cmd_status "$@"
            exit $?
            ;;
        stop)
            shift
            cmd_stop "${1:-all}"
            exit $?
            ;;
    *)
        local model="$cmd"
        shift
        local background=0
        local cpu_only=0
        local force=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --background) background=1 ;;
                --cpu) cpu_only=1 ;;
                --force) force=1 ;;
                *) echo "Opción desconocida: $1" >&2; cmd_help; exit 1 ;;
            esac
            shift
        done
        start_model "$model" "$background" "$cpu_only" "$force"
        exit $?
        ;;
    esac
}

main "$@"
